---
// /ppaisaje/ — visual experiment on the landscape-data prototype (ALL DATA FAKE).
// Part 1: issues and their causes (dark). Transition. Part 2: opportunities (light).
// No interventions anywhere. See PPAISAJE_NOTES.md.
import "../styles/app.css";
import "../styles/ppaisaje.css";
import Layout from "@motiu/design/components/Layout.astro";
import SeverityChip from "../components/ppaisaje/SeverityChip.astro";
import EvidenceTag from "../components/ppaisaje/EvidenceTag.astro";
import IssueViz from "../components/ppaisaje/IssueViz.astro";
import CauseChain from "../components/ppaisaje/CauseChain.astro";
import CausesMatrix from "../components/ppaisaje/CausesMatrix.astro";
import TransitionBand from "../components/ppaisaje/TransitionBand.astro";
import OpportunityMap from "../components/ppaisaje/OpportunityMap.astro";
import {
    data, chartById, indicatorsOf, driversOf, themeById, sourceNumber,
    availability, SEVERITY, CONFIDENCE_LABEL, HORIZON_LABEL, fmtNum, fmtVal, SOURCE_TYPE_LABEL,
} from "../lib/ppaisaje/data";

export interface Props {
    lang?: "es" | "en";
}
const { lang = "es" } = Astro.props;

const total = data.indicators.length;
const AVAIL_LABEL = { disponible: "Disponible", pendiente: "Pendiente de solicitar", no_disponible: "No disponible" } as const;
const gaps = [...availability.pendiente, ...availability.no_disponible];
const yv = (v: any, unit: string) => (v ? `${fmtVal(v, unit)} (${v.year})` : "—");
const usedSources = data.sources;
---

<Layout
    title="Landscape data · ppaisaje (maqueta)"
    description="Experimento visual con datos ficticios: problemas del paisaje del Altiplano, sus causas y las oportunidades."
    current="ppaisaje"
    lang={lang}
    noindex
>
    <div class="pp" id="pp-root">
        <p class="pp-bar">Maqueta — datos y informes ficticios · Solo para socios y financiadores</p>

        <!-- ================= PART 1 · PROBLEMAS Y CAUSAS ================= -->
        <section class="pp-dark pp-hero" aria-labelledby="pp-h1">
            <div class="container">
                <p class="pp-kicker">Landscape data · Parte 1</p>
                <h1 class="pp-h1" id="pp-h1">¿Cómo está el paisaje del Altiplano?</h1>
                <p class="pp-lede">Cinco problemas, de qué dependen y dónde hay margen. Datos ficticios para probar el diseño.</p>

                <ol class="ppov" aria-label="Resumen de los cinco problemas">
                    {data.themes.map((t) => (
                        <li class="ppov__row">
                            <div class="ppov__sev"><SeverityChip status={t.status} /></div>
                            <div class="ppov__what">
                                <h2 class="ppov__name"><a href={`#problema-${t.id}`}>{t.label}</a></h2>
                                <p class="ppov__sentence">{t.statement}</p>
                            </div>
                            <div class="ppov__viz"><IssueViz chart={chartById(t.heroChartId)} size="mini" /></div>
                            <div class="ppov__causes">
                                <p class="ppov__h">Principales causas</p>
                                <ul>{driversOf(t.id).slice(0, 3).map((c) => <li>{c.label}</li>)}</ul>
                            </div>
                        </li>
                    ))}
                </ol>
            </div>
        </section>

        <section class="pp-dark pp-causes" aria-labelledby="pp-causes-h">
            <div class="container">
                <h2 class="pp-h2" id="pp-causes-h">Pocas causas de fondo explican varios problemas</h2>
                <p class="pp-sub">Qué causas de fondo pueden contribuir a cada problema. Un punto no demuestra causalidad: indica un factor que contribuye, con su nivel de evidencia.</p>
                <CausesMatrix />
            </div>
        </section>

        {data.themes.map((t, i) => (
            <section class="pp-dark pp-issue" id={`problema-${t.id}`} aria-labelledby={`pp-i-${t.id}`}>
                <div class="container">
                    <header class="pp-issue__head">
                        <span class="pp-issue__n">{String(i + 1).padStart(2, "0")}</span>
                        <h2 class="pp-h2" id={`pp-i-${t.id}`}>{t.label}</h2>
                        <SeverityChip status={t.status} size="lg" />
                    </header>
                    <p class="pp-issue__verdict">{t.verdict}</p>
                    <div class="pp-issue__grid">
                        <div class="pp-issue__viz"><IssueViz chart={chartById(t.heroChartId)} size="full" /></div>
                        <CauseChain issue={t} />
                    </div>
                    <p class="pp-unknown"><strong>Lo que aún no sabemos.</strong> {t.limitations}</p>

                    <details class="pp-details">
                        <summary>Indicadores y fuentes</summary>
                        <div class="pp-tablewrap">
                            <table>
                                <caption class="pp-sr">Indicadores de {t.label}</caption>
                                <thead><tr><th scope="col">Indicador</th><th scope="col">Referencia</th><th scope="col">Último dato</th><th scope="col">Meta</th><th scope="col">Disponibilidad</th></tr></thead>
                                <tbody>
                                    {indicatorsOf(t.id).map((ind) => (
                                        <tr>
                                            <th scope="row">{ind.label}<small>{ind.scope}</small></th>
                                            <td>{yv(ind.baseline, ind.unit)}</td>
                                            <td>{yv(ind.latest, ind.unit)}</td>
                                            <td>{yv(ind.target, ind.unit)}</td>
                                            <td>{AVAIL_LABEL[ind.availability]}</td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        </div>
                        <ul class="pp-findings">
                            {t.findings.map((f) => <li>{f.text} <a href={`#ev-${f.sourceId}`}>[{sourceNumber(f.sourceId)}]</a></li>)}
                        </ul>
                    </details>
                </div>
            </section>
        ))}

        <!-- ================= TRANSITION ================= -->
        <TransitionBand />

        <!-- ================= PART 2 · OPORTUNIDADES ================= -->
        <section class="pp-light pp-opps" id="oportunidades" aria-labelledby="pp-opps-h">
            <div class="container">
                <p class="pp-kicker">Landscape data · Parte 2</p>
                <h2 class="pp-h1 pp-h1--sm" id="pp-opps-h">Oportunidades</h2>
                <p class="pp-lede">Siete líneas de mejora posibles, cada una ligada a los problemas de arriba. <strong>Cifras ilustrativas</strong>: órdenes de magnitud para comparar, no previsiones.</p>

                <div class="pp-opps__top">
                    <OpportunityMap />
                    <ol class="ppolist" aria-label="Oportunidades numeradas">
                        {data.opportunities.map((o, i) => (
                            <li><span class="ppolist__n">{i + 1}</span>{o.label}</li>
                        ))}
                    </ol>
                </div>

                <ul class="ppcards">
                    {data.opportunities.map((o, i) => (
                        <li class="ppcard">
                            <div class="ppcard__top">
                                <span class="ppcard__n">{i + 1}</span>
                                <h3 class="ppcard__name">{o.label}</h3>
                            </div>
                            <p class="ppcard__sum">{o.summary}</p>
                            <p class="ppcard__size"><strong>{fmtNum(o.size.low)}–{fmtNum(o.size.high)}</strong> <span>{o.size.unit}</span></p>
                            <p class="ppcard__note">{o.size.note}</p>
                            <ul class="ppcard__addr" aria-label="Problemas que ayuda a abordar">
                                {o.addresses.map((a) => <li><a href={`#problema-${a}`}>{themeById(a).label}</a></li>)}
                            </ul>
                            <dl class="ppcard__facts">
                                <div><dt>Plazo</dt><dd>{HORIZON_LABEL[o.horizon]}</dd></div>
                                <div><dt>Barrera</dt><dd>{o.barrier}</dd></div>
                                <div><dt>Punto de partida</dt><dd>{o.readiness}</dd></div>
                            </dl>
                            <p class="ppcard__foot"><EvidenceTag confidence={o.confidence} /> <span class="ppviz__fake">Ilustrativo</span></p>
                        </li>
                    ))}
                </ul>
            </div>
        </section>

        <!-- ================= CLOSING ================= -->
        <section class="pp-light pp-know" aria-labelledby="pp-know-h">
            <div class="container">
                <h2 class="pp-h2" id="pp-know-h">Qué sabemos y qué falta</h2>
                <div class="ppknow">
                    <div class="ppknow__nums">
                        <div class="ppknow__n ppknow__n--ok"><strong>{availability.disponible.length}</strong><span>indicadores con datos</span></div>
                        <div class="ppknow__n ppknow__n--pend"><strong>{availability.pendiente.length}</strong><span>pendientes de solicitar</span></div>
                        <div class="ppknow__n ppknow__n--no"><strong>{availability.no_disponible.length}</strong><span>sin datos disponibles</span></div>
                    </div>
                    <div class="ppknow__bar" role="img" aria-label={`De ${total} indicadores: ${availability.disponible.length} con datos, ${availability.pendiente.length} pendientes, ${availability.no_disponible.length} sin datos`}>
                        <span style={`flex:${availability.disponible.length}`} class="ppknow__seg ppknow__seg--ok"></span>
                        <span style={`flex:${availability.pendiente.length}`} class="ppknow__seg ppknow__seg--pend"></span>
                        <span style={`flex:${availability.no_disponible.length}`} class="ppknow__seg ppknow__seg--no"></span>
                    </div>
                    <div>
                        <h3 class="ppknow__h">Principales vacíos</h3>
                        <ul class="ppknow__gaps">
                            {gaps.map((g) => <li><span>{g.label}</span> <em>{AVAIL_LABEL[g.availability]}</em></li>)}
                        </ul>
                    </div>
                </div>
                <p class="pp-unknown pp-unknown--light">Todo lo que aparece en esta página es <strong>ficticio</strong>. Las oportunidades son órdenes de magnitud inventados y las causas son hipótesis de trabajo; se sustituirán por fuentes verificadas.</p>

                <details class="pp-details pp-details--light" id="fuentes">
                    <summary>Método y fuentes ({usedSources.length})</summary>
                    <p class="pp-method">Criterios previstos (texto provisional): preferir datos oficiales y revisados por pares; indicar siempre ámbito, año y licencia; registrar quién verificó cada fuente y cuándo; marcar con confianza baja lo autoinformado. «No listado» no es «privado»: esta página no está en el menú, pero cualquiera con el enlace puede abrirla.</p>
                    <ol class="ppsrc">
                        {usedSources.map((s) => (
                            <li id={`ev-${s.id}`}>
                                <span class="ppsrc__n">[{sourceNumber(s.id)}]</span>
                                <a href={s.url}>{s.title}</a>
                                <span class="ppsrc__meta">{s.publisher} · {s.year} · {SOURCE_TYPE_LABEL[s.type]} · {CONFIDENCE_LABEL[s.confidence]} · {s.licence} · consultado {s.retrieved}</span>
                            </li>
                        ))}
                    </ol>
                </details>
            </div>
        </section>
    </div>
</Layout>

<script>
    // Greening of the transition: purely cosmetic, the static gradient already carries the message.
    const band = document.getElementById("transicion");
    const root = document.getElementById("pp-root");
    if (band && root && "IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        band.classList.add("is-armed");
        const io = new IntersectionObserver(
            (entries) => {
                for (const e of entries) {
                    band.classList.toggle("is-green", e.isIntersecting || e.boundingClientRect.top < 0);
                }
            },
            { threshold: 0.35 },
        );
        io.observe(band);
    }

    // Citations point into the collapsed "Método y fuentes" list: open it first.
    const openSources = () => {
        if (location.hash.startsWith("#ev-")) {
            const d = document.getElementById("fuentes") as HTMLDetailsElement | null;
            if (d) d.open = true;
            document.getElementById(location.hash.slice(1))?.scrollIntoView();
        }
    };
    document.addEventListener("click", (e) => {
        const a = (e.target as HTMLElement).closest('a[href^="#ev-"]') as HTMLAnchorElement | null;
        if (a) {
            const d = document.getElementById("fuentes") as HTMLDetailsElement | null;
            if (d) d.open = true;
        }
    });
    window.addEventListener("hashchange", openSources);
    openSources();
</script>
