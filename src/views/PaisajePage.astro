---
// "Paisaje en datos" — PROTOTYPE. All data are fake (src/data/paisaje.mock.json).
// Two layouts over the same markup: story (default) and ?layout=dashboard.
import Layout from "../components/Layout.astro";
import MockBanner from "../components/paisaje/MockBanner.astro";
import StatusChip from "../components/paisaje/StatusChip.astro";
import Sparkline from "../components/paisaje/Sparkline.astro";
import TerritoryNote from "../components/paisaje/TerritoryNote.astro";
import ContextMap from "../components/paisaje/ContextMap.astro";
import ThemeSection from "../components/paisaje/ThemeSection.astro";
import EvidenceList from "../components/paisaje/EvidenceList.astro";
import { paisaje, indicatorById, fmtVal, loadResponses } from "../lib/paisaje/data";

const responses = await loadResponses();
const empty = { interventions: [], orgs: [], placeholders: [] };
---

<Layout
    title="Altiplano Estepario — Landscape data (maqueta)"
    description="Maqueta con datos ficticios: estado del paisaje del Altiplano junto a las organizaciones e intervenciones del sitio."
    current="paisaje"
    lang="es"
>
    <div class="paisaje" id="paisaje-root" data-layout="story">
        <script is:inline>
            (function () {
                try {
                    var l = new URLSearchParams(location.search).get("layout");
                    if (l === "dashboard") document.getElementById("paisaje-root").setAttribute("data-layout", "dashboard");
                } catch (e) {}
            })();
        </script>

        <MockBanner variant="bar" />

        <!-- ============ HERO ============ -->
        <section class="phero">
            <div class="container">
                <p class="overline">Prototipo · Landscape data</p>
                <h1 class="display phero__title">¿Cómo está el paisaje del Altiplano?</h1>
                <p class="lede phero__lede">
                    Seis temas, cada uno con lo que dicen los datos, de dónde salen, qué se está haciendo y qué vamos a medir.
                    Todo lo que ves aquí es <strong>ficticio</strong>: sirve para probar el diseño y el relato, no para publicar cifras.
                </p>

                <ul class="ptiles">
                    {paisaje.themes.map((t) => {
                        const ind = indicatorById(t.headlineIndicatorId);
                        const stub = t.status === "proximamente";
                        return (
                            <li>
                                <a class={`ptile ${stub ? "ptile--stub" : ""}`} href={`#tema-${t.id}`} data-tab-link={t.id}>
                                    <span class="ptile__top">
                                        <span class="ptile__label">{t.label}</span>
                                        <StatusChip status={t.status} size="sm" />
                                    </span>
                                    <span class="ptile__value">{ind?.latest ? fmtVal(ind.latest, ind.unit) : "—"}</span>
                                    <span class="ptile__what">{ind ? ind.label : t.summary}</span>
                                    <span class="ptile__bottom">
                                        {ind && <Sparkline values={ind.series.map((s) => s.value)} label={ind.label} />}
                                        <span class="ptile__year">{ind?.latest ? ind.latest.year : "Próximamente"}</span>
                                    </span>
                                </a>
                            </li>
                        );
                    })}
                </ul>

                <div class="phero__tools">
                    <div class="playout" role="group" aria-label="Disposición de la página">
                        <span class="playout__label">Disposición</span>
                        <button type="button" class="chip is-active" data-set-layout="story" aria-pressed="true">Relato</button>
                        <button type="button" class="chip" data-set-layout="dashboard" aria-pressed="false">Panel</button>
                    </div>
                </div>
            </div>
        </section>

        <div class="container pstack">
            <TerritoryNote />
            <ContextMap orgs={responses.orgs} />
        </div>

        <!-- ============ THEMES ============ -->
        <div class="container pmain">
            <nav class="pnav" aria-label="Temas del paisaje">
                <p class="pnav__label">Temas</p>
                <ul>
                    {paisaje.themes.map((t, i) => (
                        <li>
                            <a href={`#tema-${t.id}`} data-tab-link={t.id} class="pnav__link">
                                <span class="pnav__n">{String(i + 1).padStart(2, "0")}</span>
                                {t.label}
                                {t.status === "proximamente" && <span class="pnav__soon">pronto</span>}
                            </a>
                        </li>
                    ))}
                    <li><a href="#metodologia" class="pnav__link pnav__link--meta" data-meta-link>Método y fuentes</a></li>
                </ul>
            </nav>

            <div class="pthemes">
                {paisaje.themes.map((t, i) => (
                    <ThemeSection theme={t} response={responses.byTheme[t.id] ?? empty} orgNames={responses.interventionOrgNames} index={i} />
                ))}
            </div>
        </div>

        <!-- ============ METHODS ============ -->
        <section class="pmethods" id="metodologia">
            <div class="container">
                <h2 class="pmethods__title">Método, límites y fuentes</h2>
                <div class="pmethods__grid">
                    <div>
                        <h3>Cómo se eligen y verifican los datos</h3>
                        <p>Texto provisional. Criterios previstos: preferir datos oficiales y revisados por pares; indicar siempre ámbito, año y licencia; registrar quién verificó cada fuente y cuándo; marcar con confianza baja lo autoinformado.</p>
                        <h3>Qué muestra esta página y qué no</h3>
                        <p>La condición del paisaje (datos externos) y la acción de las intervenciones (lo que hacen los socios) se presentan por separado. Las intervenciones <em>buscan contribuir</em> a mejorar la situación; esta página no demuestra causalidad.</p>
                    </div>
                    <div>
                        <h3>Todas las fuentes ({paisaje.sources.length})</h3>
                        <EvidenceList sources={paisaje.sources} idPrefix="src-" />
                    </div>
                </div>
            </div>
        </section>

        <p class="pfloat" aria-hidden="true">Maqueta — datos y informes ficticios</p>
    </div>
</Layout>

<script>
    const root = document.getElementById("paisaje-root")!;
    const themes = Array.from(document.querySelectorAll<HTMLElement>(".ptheme"));
    const navLinks = Array.from(document.querySelectorAll<HTMLElement>(".pnav [data-tab-link]"));
    const isDash = () => root.dataset.layout === "dashboard";

    function activate(id: string, scroll = false) {
      themes.forEach((t) => t.classList.toggle("is-active", t.dataset.themeId === id));
      navLinks.forEach((a) => a.classList.toggle("is-current", a.dataset.tabLink === id));
      const stub = document.querySelector<HTMLDetailsElement>(`#tema-${id} details`);
      if (stub && isDash()) stub.open = true;
      if (scroll && isDash()) document.querySelector(".pmain")?.scrollIntoView({ block: "start" });
    }

    function setLayout(l: "story" | "dashboard", push = true) {
      root.dataset.layout = l;
      document.querySelectorAll<HTMLElement>("[data-set-layout]").forEach((b) => {
        const on = b.dataset.setLayout === l;
        b.classList.toggle("is-active", on);
        b.setAttribute("aria-pressed", String(on));
      });
      if (push) {
        const u = new URL(location.href);
        if (l === "dashboard") u.searchParams.set("layout", "dashboard");
        else u.searchParams.delete("layout");
        history.replaceState(null, "", u);
      }
      if (l === "dashboard") {
        const hashId = location.hash.startsWith("#tema-") ? location.hash.slice(6) : "";
        const first = themes.find((t) => t.dataset.themeId === hashId) ?? themes.find((t) => !t.classList.contains("ptheme--stub")) ?? themes[0];
        activate(first.dataset.themeId!);
      } else {
        themes.forEach((t) => t.classList.remove("is-active"));
        observe();
      }
    }

    // story: highlight the section in view
    let io: IntersectionObserver | null = null;
    function observe() {
      io?.disconnect();
      io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) if (e.isIntersecting && !isDash()) {
            const id = (e.target as HTMLElement).dataset.themeId!;
            navLinks.forEach((a) => a.classList.toggle("is-current", a.dataset.tabLink === id));
          }
        },
        { rootMargin: "-20% 0px -70% 0px" },
      );
      themes.forEach((t) => io!.observe(t));
    }

    document.querySelectorAll<HTMLElement>("[data-tab-link]").forEach((a) =>
      a.addEventListener("click", (ev) => {
        if (!isDash()) return; // story: normal anchor scroll
        ev.preventDefault();
        const id = a.dataset.tabLink!;
        history.replaceState(null, "", `#tema-${id}`);
        activate(id, true);
      }),
    );
    document.querySelectorAll<HTMLElement>("[data-set-layout]").forEach((b) => b.addEventListener("click", () => setLayout(b.dataset.setLayout as any)));
    // In dashboard mode, citations to evidence stay inside the active theme (already visible).
    setLayout(root.dataset.layout === "dashboard" ? "dashboard" : "story", false);
</script>

<style is:global>
    .paisaje { padding-bottom: 3rem; }
    .phero { padding: var(--space-12) 0 var(--space-8); border-bottom: 1px solid var(--border-subtle); }
    .phero__title { font-size: clamp(2.4rem, 6vw, 4.2rem); margin: var(--space-3) 0 var(--space-4); max-width: 18ch; }
    .phero__lede { max-width: 62ch; margin-bottom: var(--space-8); }
    .ptiles { list-style: none; margin: 0 0 var(--space-6); padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
    .ptile { display: flex; flex-direction: column; gap: var(--space-2); height: 100%; border: 1px solid var(--border-subtle); background: var(--bg); padding: var(--space-4) var(--space-5); text-decoration: none; color: var(--fg); transition: border-color var(--t-fast), transform var(--t-fast); }
    .ptile:hover { border-color: var(--fg); text-decoration: none; transform: translateY(-2px); }
    .ptile--stub { border-style: dashed; }
    .ptile__top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); flex-wrap: wrap; }
    .ptile__label { font-family: var(--mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.07em; }
    .ptile__value { font-family: var(--serif); font-size: var(--text-2xl); line-height: 1; margin-top: var(--space-2); }
    .ptile__what { font-size: var(--text-xs); color: var(--muted); min-height: 2.4em; }
    .ptile__bottom { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); margin-top: auto; }
    .ptile__year { font-family: var(--mono); font-size: var(--text-2xs); color: var(--muted); text-transform: uppercase; }
    .phero__tools { display: flex; justify-content: flex-end; }
    .playout { display: inline-flex; align-items: center; gap: var(--space-2); }
    .playout__label { font-family: var(--mono); font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-right: var(--space-1); }
    .pstack { display: grid; gap: var(--space-6); padding-top: var(--space-8); }

    /* ---------- story layout ---------- */
    .pmain { display: grid; grid-template-columns: 13rem minmax(0, 1fr); gap: var(--space-10); padding-top: var(--space-8); }
    .pnav { position: sticky; top: 5.5rem; align-self: start; }
    .pnav__label { font-family: var(--mono); font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); margin-bottom: var(--space-3); }
    .pnav ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
    .pnav__link { display: flex; align-items: baseline; gap: var(--space-2); padding: 0.45rem 0.6rem; border-left: 3px solid transparent; font-size: var(--text-sm); color: var(--fg); text-decoration: none; }
    .pnav__link:hover { background: var(--surface-1); text-decoration: none; }
    .pnav__link.is-current { border-left-color: var(--pillar-flow-3); background: var(--surface-1); font-weight: 600; }
    .pnav__n { font-family: var(--mono); font-size: var(--text-2xs); color: var(--pillar-flow-3); }
    .pnav__soon { margin-left: auto; font-family: var(--mono); font-size: 0.55rem; text-transform: uppercase; color: var(--muted); }
    .pnav__link--meta { margin-top: var(--space-3); border-top: 1px solid var(--border-subtle); }
    .pnav a:focus-visible, .ptile:focus-visible, .paisaje summary:focus-visible, .paisaje button:focus-visible, .pg-pt:focus-visible { outline: 3px solid var(--pillar-flow-3); outline-offset: 2px; }
    .pthemes .ptheme:first-child { border-top: 0; padding-top: 0; }

    /* ---------- dashboard layout ---------- */
    [data-layout="dashboard"] .pmain { grid-template-columns: 1fr; gap: var(--space-5); }
    [data-layout="dashboard"] .pnav { position: static; }
    [data-layout="dashboard"] .pnav__label { display: none; }
    [data-layout="dashboard"] .pnav ul { display: flex; flex-wrap: wrap; gap: var(--space-2); border-bottom: 1px solid var(--border); }
    [data-layout="dashboard"] .pnav__link { border: 1px solid var(--border-subtle); border-bottom: 0; background: var(--bg); padding: 0.6rem 1rem; }
    [data-layout="dashboard"] .pnav__link.is-current { background: var(--fg); color: var(--bg); border-color: var(--fg); }
    [data-layout="dashboard"] .pnav__link.is-current .pnav__n { color: var(--pillar-flow-1); }
    [data-layout="dashboard"] .pnav__link--meta { display: none; }
    [data-layout="dashboard"] .ptheme { display: none; border-top: 0; padding: var(--space-4) 0 var(--space-8); }
    [data-layout="dashboard"] .ptheme.is-active { display: block; }
    [data-layout="dashboard"] .ptheme__body { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); align-items: start; }
    [data-layout="dashboard"] .pblock--resp, [data-layout="dashboard"] .pblock--ind, [data-layout="dashboard"] .pblock--ev { grid-column: 1 / -1; }
    [data-layout="dashboard"] .ptheme__verdict { font-size: var(--text-base); }
    [data-layout="dashboard"] .pblock__stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    [data-layout="dashboard"] .pev { grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); }
    [data-layout="dashboard"] .pthemes .ptheme:first-child { padding-top: var(--space-4); }

    /* ---------- methods ---------- */
    .pmethods { margin-top: var(--space-16); padding: var(--space-12) 0; background: var(--surface-1); border-top: 1px solid var(--border-subtle); scroll-margin-top: 5rem; }
    .pmethods__title { font-family: var(--serif); font-weight: 400; font-size: var(--text-xl); margin-bottom: var(--space-6); }
    .pmethods__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-10); }
    .pmethods h3 { font-family: var(--mono); font-weight: 400; font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em; margin: var(--space-4) 0 var(--space-2); }
    .pmethods h3:first-child { margin-top: 0; }
    .pmethods p { font-size: var(--text-sm); max-width: 60ch; }

    .pfloat { position: fixed; left: var(--space-4); bottom: var(--space-3); z-index: 40; margin: 0; font-family: var(--mono); font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.08em; background: #fff1d6; color: #6b3a00; border: 1px dashed #b86a00; padding: 0.3rem 0.6rem; pointer-events: none; }

    /* ---------- responsive ---------- */
    @media (max-width: 960px) {
        .ptiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .pmain { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
        .pnav { min-width: 0; max-width: 100%; }
        .pnav { position: static; overflow-x: auto; }
        .pnav__label { display: none; }
        .pnav ul { display: flex; gap: var(--space-2); padding-bottom: var(--space-2); }
        .pnav__link { white-space: nowrap; border: 1px solid var(--border-subtle); border-left-width: 1px; }
        .pnav__link.is-current { border-color: var(--pillar-flow-3); }
        .pnav__link--meta { margin-top: 0; border-top: 1px solid var(--border-subtle); }
        [data-layout="dashboard"] .ptheme__body { grid-template-columns: 1fr; }
        .pmethods__grid { grid-template-columns: 1fr; }
        .phero__tools { justify-content: flex-start; }
    }
    @media (max-width: 560px) { .ptiles { grid-template-columns: 1fr; } }
    @media (max-width: 480px) { .pfloat { font-size: 0.55rem; } .ptile__value { font-size: var(--text-xl); } }

    /* ---------- print ---------- */
    @media print {
        .site-nav, .site-footer, .pnav, .playout, .phero__tools, .pfloat, .pmap__panel, .maplibregl-ctrl, .pmap__canvas { display: none !important; }
        .pmap__lede::after { content: " (mapa omitido en la versión impresa)"; }
        [data-layout="dashboard"] .ptheme { display: block !important; }
        .pmain { display: block; }
        .ptheme { break-inside: avoid-page; page-break-inside: avoid; padding: var(--space-6) 0; }
        .pfig, .pev__item, .pstat, .pfind__item { break-inside: avoid; }
        .pmock--bar { position: static; }
        details > *:not(summary) { display: block; }
        a { color: inherit; text-decoration: none; }
        .reveal { opacity: 1 !important; transform: none !important; }
    }
</style>
