---
import "../styles/app.css";
// One work area: what drives it, its sub-areas in order, and the interventions of each sub-area.
// The words come from src/data/areas.yaml; the interventions and their figures come from Notion.
import Layout from "@motiu/design/components/Layout.astro";
import Badge from "@motiu/design/components/Badge.astro";
import InterventionCard from "../components/InterventionCard.astro";
import { loadSiteData } from "../lib/data";
import { buildAreaViews, pick, toneVars, compactEuro, portfolioHref } from "../lib/portfolio";
import { interventionOrgNames } from "../lib/records";
import { t, numberLocale } from "../lib/i18n";
import type { Lang } from "../lib/i18n";

export interface Props {
    lang?: Lang;
    slug: string;
}
const { lang = "es", slug } = Astro.props;

const { orgMap, interventions, dataError } = await loadSiteData();
const views = buildAreaViews(interventions);
const idx = views.findIndex((v) => v.slug === slug);
const view = views[idx];
const def = view.def;
const prev = views[(idx + views.length - 1) % views.length];
const next = views[(idx + 1) % views.length];
const count = (n: number) => (n === 1 ? t(lang, "pf.itvCount1") : t(lang, "pf.itvCount", { n }));
// Capital mix of the area: its interventions' total financing split by kind of capital.
const cap = { concesional: 0, deuda: 0, equity: 0, otro: 0 };
for (const itv of view.items) {
    if (!itv.capitalMix || !itv.financiacion) continue;
    for (const [k, share] of Object.entries(itv.capitalMix)) cap[k as keyof typeof cap] += itv.financiacion * share;
}
const capTotal = cap.concesional + cap.deuda + cap.equity + cap.otro;
const pct = (n: number) => (n / capTotal).toLocaleString(numberLocale(lang), { style: "percent", maximumFractionDigits: 0 });
const hasFlows = view.flows.length > 0;
const groups = hasFlows ? view.flows : [{ title: null, blurb: null, subareas: view.subareas }];
const anchor = (id: string) => "sub-" + id.replace(".", "-");
const tone = toneVars(view.tone);
const name = view.name;
---

<Layout title={name} description={pick(def.kicker, lang) || name} current="portafolio" lang={lang}>
    <article class="area" style={tone}>
        <!-- ============ HERO ============ -->
        <header class="ahero">
            <div class="container">
                <a class="ahero__back" href={portfolioHref(lang)}>← {t(lang, "pf.back")}</a>
                <div><Badge tone={view.tone as any}>{t(lang, "pf.areaN", { n: view.num })}</Badge></div>
                <h1 class="display ahero__title">{name}</h1>
                {def.lead.es && <p class="ahero__lead">{pick(def.lead, lang)}</p>}
                <div class="ahero__rule" aria-hidden="true"></div>
            </div>
        </header>

        {dataError && (
            <div class="container">
                <div class="data-banner" role="alert"><strong>{t(lang, "banner.error")}</strong> {dataError}</div>
            </div>
        )}

        <!-- ============ DYNAMICS ============ -->
        {def.dynamics.length > 0 && (
        <section class="asec">
            <div class="container">
                <p class="asec__eyebrow">{t(lang, "pf.dynamics")}</p>
                <h2 class="asec__title">{t(lang, "pf.dynamicsH")}</h2>
                <ol class="adyn">
                    {def.dynamics.map((d, i) => (
                        <li class="adyn__item">
                            <span class="adyn__n">{String(i + 1).padStart(2, "0")}</span>
                            <h3 class="adyn__title">{pick(d.title, lang)}</h3>
                            <p class="adyn__text">{pick(d.text, lang)}</p>
                        </li>
                    ))}
                </ol>

            </div>
        </section>
        )}

        <!-- ============ SUB-AREAS ============ -->
        <section class="asec asec--soft">
            <div class="container">
                <p class="asec__eyebrow">{t(lang, "pf.subareas")}</p>
                <h2 class="asec__title">{t(lang, "pf.subareasH")}</h2>
                {!hasFlows && def.flow && <p class="asec__lead">{pick(def.flow, lang)}</p>}

                {groups.map((g, gi) => (
                    <div class:list={["aflowgroup", { "aflowgroup--titled": hasFlows }]}>
                        {hasFlows && (
                            <header class="aflowgroup__head">
                                <p class="aflowgroup__eyebrow">{t(lang, "pf.flowN", { n: gi + 1 })}</p>
                                <h3 class="aflowgroup__title">{pick(g.title, lang)}</h3>
                                <p class="aflowgroup__blurb">{pick(g.blurb, lang)}</p>
                            </header>
                        )}
                        <nav class="aflow" aria-label={t(lang, "pf.subareas")}>
                            <ol>
                                {g.subareas.map((s) => (
                                    <li class:list={{ "is-empty": s.items.length === 0 }}>
                                        <a href={"#" + anchor(s.id)}>
                                            <span class="aflow__id">{s.id}</span>
                                            <span class="aflow__name">{s.name}</span>
                                            <span class="aflow__meta">
                                                {count(s.items.length)}{s.total > 0 && ` · ${compactEuro(s.total, lang)} ${t(lang, "pf.at5")}`}
                                            </span>
                                        </a>
                                    </li>
                                ))}
                            </ol>
                        </nav>

                        {g.subareas.map((s) => (
                            <section class="asub" id={anchor(s.id)}>
                                <header class="asub__head">
                                    <span class="asub__id">{s.id}</span>
                                    <div class="asub__titles">
                                        <h3 class="asub__name">{s.name}</h3>
                                        {s.line && <p class="asub__line">{pick(s.line, lang)}</p>}
                                    </div>
                                    <p class="asub__meta">
                                        <span>{count(s.items.length)}</span>
                                        {s.total > 0 && <span>{compactEuro(s.total, lang)} {t(lang, "pf.at5")}</span>}
                                    </p>
                                </header>
                                {s.items.length > 0 ? (
                                    <div class="aitvs">
                                        {s.items.map((itv) => (
                                            <InterventionCard intervention={itv} orgNames={interventionOrgNames(itv, orgMap)} filterable={false} lang={lang} />
                                        ))}
                                    </div>
                                ) : (
                                    <p class="asub__empty">{t(lang, "pf.noItvs")}</p>
                                )}
                            </section>
                        ))}
                    </div>
                ))}

                {view.loose.length > 0 && (
                    <section class="asub">
                        <header class="asub__head">
                            <span class="asub__id">·</span>
                            <div class="asub__titles"><h3 class="asub__name">{t(lang, "pf.loose")}</h3></div>
                            <p class="asub__meta"><span>{count(view.loose.length)}</span></p>
                        </header>
                        <div class="aitvs">
                            {view.loose.map((itv) => (
                                <InterventionCard intervention={itv} orgNames={interventionOrgNames(itv, orgMap)} filterable={false} lang={lang} />
                            ))}
                        </div>
                    </section>
                )}
            </div>
        </section>

        <!-- ============ WHO + MONEY ============ -->
        {(def.actors.length > 0 || capTotal > 0) && (
        <section class="asec">
            <div class="container awho">
                {def.actors.length > 0 && (
                    <div>
                        <p class="asec__eyebrow">{t(lang, "pf.actors")}</p>
                        <ul class="achips">
                            {def.actors.map((a) => <li>{pick(a, lang)}</li>)}
                        </ul>
                    </div>
                )}
                {capTotal > 0 && (
                    <div class="acap">
                        <p class="asec__eyebrow">{t(lang, "pf.financing")}</p>
                        <p class="acap__note">{t(lang, "pf.capNote")}</p>
                        <div class="acap__track">
                            <span class="acap__seg acap__seg--conc" style={`width:${(cap.concesional / capTotal) * 100}%`}></span>
                            <span class="acap__seg acap__seg--debt" style={`width:${(cap.deuda / capTotal) * 100}%`}></span>
                            <span class="acap__seg acap__seg--eq" style={`width:${(cap.equity / capTotal) * 100}%`}></span>
                        </div>
                        <ul class="acap__legend">
                            <li><i class="acap__key acap__key--conc"></i>{t(lang, "pf.capConc")} <strong>{pct(cap.concesional)}</strong> · {compactEuro(cap.concesional, lang)}</li>
                            <li><i class="acap__key acap__key--debt"></i>{t(lang, "pf.capDebt")} <strong>{pct(cap.deuda)}</strong> · {compactEuro(cap.deuda, lang)}</li>
                            <li><i class="acap__key acap__key--eq"></i>{t(lang, "pf.capEq")} <strong>{pct(cap.equity)}</strong> · {compactEuro(cap.equity, lang)}</li>
                        </ul>
                    </div>
                )}
            </div>
        </section>
        )}

        <!-- ============ NEXT / PREVIOUS ============ -->
        <nav class="aadj" aria-label={t(lang, "pf.areaN", { n: "" })}>
            <div class="container aadj__row">
                <a class="aadj__link aadj__link--prev" style={toneVars(prev.tone)} href={portfolioHref(lang, prev.slug)}>
                    <span>← {t(lang, "pf.prev")}</span>
                    <strong>{prev.name}</strong>
                </a>
                <a class="aadj__link aadj__link--next" style={toneVars(next.tone)} href={portfolioHref(lang, next.slug)}>
                    <span>{t(lang, "pf.next")} →</span>
                    <strong>{next.name}</strong>
                </a>
            </div>
        </nav>
    </article>
</Layout>

<style>
    .area {
        --gutter: var(--space-6);
    }

    /* ---------- hero ---------- */
    .ahero {
        padding: var(--space-12) 0 var(--space-8);
    }
    .ahero__back {
        font-family: var(--mono);
        font-size: var(--text-xs);
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }
    .ahero__back {
        display: block;
        width: fit-content;
        color: var(--text-muted);
        text-decoration: none;
        margin-bottom: var(--space-6);
    }
    .ahero__back:hover {
        text-decoration: underline;
    }
    .ahero__title {
        margin: var(--space-4) 0 0;
        max-width: 16ch;
        font-size: clamp(2.4rem, 6vw, 4.4rem);
        line-height: 1.02;
    }
    /* The same fading hairline the portfolio page's heading ends with. */
    .ahero__rule {
        margin-top: var(--space-8);
        height: 1px;
        background: linear-gradient(to right, var(--border-default) 0%, var(--border-default) 48%, transparent 100%);
    }
    .ahero__lead {
        margin: var(--space-4) 0 0;
        max-width: 52ch;
        font-size: var(--text-lg);
        line-height: 1.45;
        color: var(--text-muted);
    }

    /* ---------- sections ---------- */
    .asec {
        padding: var(--space-16) 0;
    }
    .asec--soft {
        background: var(--eggshell, var(--paper));
        border-block: 1px solid var(--border-subtle);
    }
    .asec__eyebrow {
        margin: 0 0 var(--space-2);
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.09em;
        color: var(--text-muted);
    }
    .asec__title {
        margin: 0 0 var(--space-6);
        font-family: var(--sans);
        font-size: clamp(1.7rem, 3.4vw, 2.4rem);
        line-height: 1.1;
        font-weight: 400;
    }
    .asec__lead {
        margin: calc(var(--space-3) * -1) 0 var(--space-6);
        max-width: 56ch;
        font-size: var(--text-md);
        color: var(--text-muted);
    }

    /* ---------- dynamics ---------- */
    .adyn {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
        gap: var(--space-5);
    }
    .adyn__item {
        position: relative;
        padding: var(--space-5) var(--space-5) var(--space-6);
        border: 1px solid var(--border-subtle);
        border-radius: var(--radius-card, 0.75rem);
        background: var(--paper);
    }
    .adyn__n {
        display: block;
        margin-bottom: var(--space-3);
        font-family: var(--mono);
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
        color: var(--text-muted);
    }
    .adyn__title {
        margin: 0 0 var(--space-2);
        font-family: var(--sans);
        font-size: var(--text-xl);
        line-height: 1.15;
        font-weight: 400;
    }
    .adyn__text {
        margin: 0;
        font-size: var(--text-sm);
        line-height: 1.55;
        color: var(--text-muted);
    }


    /* ---------- flow strip ---------- */
    .aflow ol {
        list-style: none;
        margin: 0 0 var(--space-12);
        padding: 0;
        display: flex;
        gap: var(--space-3);
        counter-reset: none;
    }
    .aflow li {
        position: relative;
        flex: 1 1 0;
        min-width: 0;
    }
    .aflow li:not(:last-child)::after {
        content: "→";
        position: absolute;
        z-index: 1;
        right: calc(var(--space-3) * -1 - 0.55em);
        top: 50%;
        translate: 0 -50%;
        width: 1.1em;
        text-align: center;
        font-size: var(--text-md);
        color: var(--text-muted);
    }
    .aflow a {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        height: 100%;
        padding: var(--space-4);
        text-decoration: none;
        color: var(--text-primary);
        border: 1px solid var(--border-subtle);
        border-top: 3px solid var(--tone-l);
        border-radius: var(--radius-card, 0.75rem);
        background: var(--paper);
        transition: transform var(--t-fast), box-shadow var(--t-fast);
    }
    .aflow a:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }
    .aflow li.is-empty a {
        background: transparent;
        border-style: dashed;
    }
    .aflow__id {
        font-family: var(--mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
    }
    .aflow__name {
        font-size: var(--text-sm);
        font-weight: 500;
        line-height: 1.25;
    }
    .aflow__meta {
        margin-top: auto;
        padding-top: var(--space-2);
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
    }

    /* ---------- one sub-area ---------- */
    .asub {
        scroll-margin-top: 6rem;
        margin-top: var(--space-12);
    }
    .asub:first-of-type {
        margin-top: 0;
    }

    /* An area with several flows: each flow is its own block with a header, a strip and its sub-areas. */
    .aflowgroup--titled {
        margin-top: var(--space-16);
        padding-top: var(--space-8);
        border-top: 1px solid var(--border-default);
    }
    .aflowgroup--titled:first-of-type {
        margin-top: var(--space-8);
    }
    .aflowgroup__head {
        margin-bottom: var(--space-6);
    }
    .aflowgroup__eyebrow {
        margin: 0 0 var(--space-1);
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.09em;
        color: var(--text-muted);
    }
    .aflowgroup__title {
        margin: 0;
        font-family: var(--sans);
        font-size: clamp(1.4rem, 2.8vw, 1.9rem);
        font-weight: 500;
        line-height: 1.15;
    }
    .aflowgroup__blurb {
        margin: var(--space-2) 0 0;
        max-width: 56ch;
        font-size: var(--text-md);
        color: var(--text-muted);
    }
    .asub__head {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: start;
        gap: var(--space-5);
        padding-bottom: var(--space-4);
        margin-bottom: var(--space-5);
        border-bottom: 1px solid var(--border-default);
    }
    .asub__id {
        font-family: var(--mono);
        font-size: clamp(2rem, 4vw, 3rem);
        line-height: 0.95;
        color: var(--text-muted);
    }
    .asub__name {
        margin: 0;
        font-family: var(--sans);
        font-size: clamp(1.3rem, 2.4vw, 1.75rem);
        line-height: 1.15;
        font-weight: 400;
    }
    .asub__line {
        margin: var(--space-1) 0 0;
        font-size: var(--text-sm);
        color: var(--text-muted);
        max-width: 54ch;
    }
    .asub__meta {
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 2px;
        font-family: var(--mono);
        font-size: var(--text-xs);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
        white-space: nowrap;
    }
    .asub__empty {
        margin: 0;
        padding: var(--space-5);
        border: 1px dashed var(--border-default);
        border-radius: var(--radius-card, 0.75rem);
        font-family: var(--mono);
        font-size: var(--text-xs);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
    }

    /* Same grid as the interventions gallery; the cards are the shared InterventionCard. */
    .aitvs {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: var(--space-5);
    }

    /* ---------- who + money ---------- */
    .awho {
        display: grid;
        grid-template-columns: 1fr 1.4fr;
        gap: var(--space-10);
    }
    /* Capital mix: two bars on one scale. Colours are the area's own tone in three steps. */
    .acap__note {
        margin: 0 0 var(--space-5);
        max-width: 52ch;
        font-size: var(--text-sm);
        color: var(--text-muted);
    }
    .acap__track {
        display: flex;
        height: 18px;
        border-radius: 999px;
        overflow: hidden;
        background: var(--bone, var(--border-subtle));
        border: 1px solid var(--border-default);
        box-sizing: border-box;
    }
    .acap__seg {
        display: block;
        height: 100%;
    }
    .acap__seg--conc,
    .acap__key--conc {
        background: var(--tone-m);
    }
    .acap__seg--debt,
    .acap__key--debt {
        background: var(--tone-d);
    }
    .acap__seg--eq,
    .acap__key--eq {
        background: var(--tone-l);
        box-shadow: inset 0 0 0 1px var(--tone-m);
    }
    .acap__legend {
        list-style: none;
        margin: var(--space-4) 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        font-size: var(--text-sm);
    }
    .acap__legend strong {
        font-family: var(--mono);
        font-size: var(--text-xs);
        font-weight: 500;
    }
    .acap__key {
        display: inline-block;
        width: 0.7em;
        height: 0.7em;
        margin-right: 0.5em;
        border-radius: 50%;
    }

    .achips {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-2);
    }
    .achips li {
        padding: 0.35em 0.9em;
        font-size: var(--text-sm);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-pill);
        background: var(--paper);
    }

    /* ---------- previous / next ---------- */
    .aadj {
        padding: 0 0 var(--space-16);
    }
    .aadj__row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-4);
    }
    .aadj__link {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        padding: var(--space-5);
        text-decoration: none;
        color: var(--text-primary);
        border: 1px solid var(--border-subtle);
        border-top: 3px solid var(--tone-l);
        border-radius: var(--radius-card, 0.75rem);
        background: var(--paper);
        transition: transform var(--t-fast);
    }
    .aadj__link:hover {
        transform: translateY(-2px);
    }
    .aadj__link--next {
        text-align: right;
    }
    .aadj__link span {
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
    }
    .aadj__link strong {
        font-family: var(--sans);
        font-size: var(--text-xl);
        font-weight: 400;
    }

    .data-banner {
        margin: var(--space-6) 0 0;
        padding: var(--space-4) var(--space-5);
        border: 1px solid color-mix(in srgb, var(--status-danger-mid) 45%, transparent);
        background: color-mix(in srgb, var(--status-danger-mid) 7%, var(--bg));
        font-size: var(--text-sm);
    }

    @media (max-width: 860px) {
        .aflow ol {
            flex-direction: column;
        }
        .aflow li:not(:last-child)::after {
            content: "↓";
            right: auto;
            left: var(--space-5);
            top: auto;
            bottom: calc(var(--space-3) * -1 - 0.6em);
            translate: 0 0;
        }
        .awho {
            grid-template-columns: 1fr;
            gap: var(--space-8);
        }
        .asub__head {
            grid-template-columns: auto 1fr;
        }
        .asub__meta {
            grid-column: 2;
            align-items: flex-start;
            flex-direction: row;
            gap: var(--space-4);
        }
        .aadj__row {
            grid-template-columns: 1fr;
        }
        .asec {
            padding: var(--space-12) 0;
        }
    }
</style>
