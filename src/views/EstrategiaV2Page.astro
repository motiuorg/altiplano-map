---
import "../styles/app.css";
// Estrategia financiera v2: one flow diagram (sources → mechanisms → sub-areas of each work area, on Tejido territorial), as wide
// as the screen like the nav. Each element opens its detail in a panel. Content: src/data/estrategia-v2.yaml.
import Layout from "@motiu/design/components/Layout.astro";
import SectionHeading from "@motiu/design/components/SectionHeading.astro";
import FinanceFlow from "../components/estrategia/FinanceFlowV2.astro";
import { loadStrategyV2 } from "../lib/estrategia-v2";
import { pick, norm, buildAreaViews } from "../lib/portfolio";
import { loadSiteData } from "../lib/data";
import { t } from "../lib/i18n";
import type { Lang } from "../lib/i18n";

export interface Props {
    lang?: Lang;
}
const { lang = "es" } = Astro.props;
const data = loadStrategyV2();

// Estimated total over 5 years of each sub-area: the sum of its interventions' "Valor ajustado a 5 años" (the same
// figure as the portfolio pages), joined to the cards by sub-area name. A sub-area with no interventions has none.
const totals: Record<string, number> = {};
try {
    const { interventions } = await loadSiteData();
    const byName = new Map<string, number>();
    for (const area of buildAreaViews(interventions)) {
        for (const s of area.subareas) byName.set(norm(s.name), (byName.get(norm(s.name)) ?? 0) + s.total);
    }
    for (const s of [...data.areas.flatMap((a) => a.subareas), ...data.base.subareas]) {
        const n = byName.get(norm(s.label.es));
        if (n) totals[s.id] = n;
    }
} catch {
    // Without the interventions (no Notion data) the cards simply show no figure.
}
---

<Layout title={t(lang, "estr2.title")} description={t(lang, "estr2.description")} current="estrategia" lang={lang}>
    <section class="section">
        <div class="container">
            <SectionHeading eyebrow={t(lang, "estr2.overline")} title={t(lang, "estr2.heading")} intro={pick(data.intro, lang)} />
        </div>

        <figure class="estr-figure">
            <FinanceFlow
                data={data}
                totals={totals}
                lang={lang}
                label={t(lang, "estr2.diagram")}
            />
            <figcaption class="estr-legend">
                <span class="estr-legend__item"><i class="estr-legend__line" />{t(lang, "estr2.legendStructure")}</span>
                <span class="estr-legend__item"><i class="estr-legend__line estr-legend__line--dash" />{t(lang, "estr2.legendDirect")}</span>
                <span class="estr-legend__note">{t(lang, "estr2.legendNote")}</span>
            </figcaption>
        </figure>
    </section>
</Layout>

<style>
    .section {
        padding: var(--space-16) 0 var(--space-20);
    }
    /* As wide as the screen, with the nav's side padding instead of the content container. */
    .estr-figure {
        margin: 0;
        padding: 0 var(--gutter);
    }
    .estr-legend {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2) var(--space-6);
        margin-top: var(--space-6);
        font-size: var(--copy-sm);
        color: var(--text-muted);
    }
    .estr-legend__item {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        color: var(--text-primary);
    }
    .estr-legend__line {
        display: inline-block;
        width: 2rem;
        height: 4px;
        border-radius: 2px;
        background: linear-gradient(90deg, #6f6a64, #a67c52);
        opacity: 0.7;
    }
    .estr-legend__line--dash {
        height: 0;
        border-radius: 0;
        background: none;
        border-top: 3px dashed #6f6a64;
    }
    @media (max-width: 560px) {
        .estr-figure {
            padding: 0 var(--space-4);
        }
    }
</style>
