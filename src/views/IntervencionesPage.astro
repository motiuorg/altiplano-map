---
import "../styles/app.css";
// Intervenciones — filterable portfolio with a cards/table switcher.
import Layout from "@motiu/design/components/Layout.astro";
import SectionHeading from "@motiu/design/components/SectionHeading.astro";
import InterventionCard from "../components/InterventionCard.astro";
import { loadSiteData } from "../lib/data";
import { formatValor, formatEuro, interventionOrgNames } from "../lib/records";
import { t, tv, numberLocale } from "../lib/i18n";
import type { Lang } from "../lib/i18n";

export interface Props {
    lang?: Lang;
}
const { lang = "es" } = Astro.props;
const loc = numberLocale(lang);

const { orgMap, interventions, dataError, dataSource } = await loadSiteData();

const collator = new Intl.Collator(lang);
const areas = [...new Set(interventions.flatMap((i) => i.areaTrabajo))].sort(
    collator.compare,
);
const orgOptions = [...new Set(interventions.flatMap((i) => i.orgIds))]
    .map((id) => ({ id, name: orgMap.get(id)?.name }))
    .filter((o): o is { id: string; name: string } => !!o.name)
    .sort((a, b) => collator.compare(a.name, b.name));

// Financing slider: min..max of the figures present, on a "nice" step.
const fins = interventions
    .map((i) => i.financiacion)
    .filter((n): n is number => n !== null);
const hasFin = fins.length > 0;
const finMin = hasFin ? Math.min(...fins) : 0;
const finMax = hasFin ? Math.max(...fins) : 0;
const span = Math.max(finMax - finMin, 1);
const step = Math.max(1, Math.pow(10, Math.floor(Math.log10(span)) - 2));
const sliderMin = Math.floor(finMin / step) * step;
const sliderMax = Math.ceil(finMax / step) * step;

const viableText = (v: boolean | null) =>
    v === null ? "—" : v ? t(lang, "yes") : t(lang, "no");
---

<Layout
    title={t(lang, "itvs.title")}
    description={t(lang, "itvs.description")}
    current="intervenciones"
    lang={lang}
>
    <section class="section">
        <div class="container">
            <SectionHeading
                eyebrow={t(lang, "itvs.overline")}
                title={t(lang, "itvs.heading")}
                intro={t(lang, "itvs.intro")}
            />

            {dataError && (
                <div class="data-banner" role="alert">
                    <strong>{t(lang, "banner.error")}</strong> {dataError}
                </div>
            )}
            {!dataError && dataSource === "fixture" && (
                <div class="data-banner data-banner--fixture">
                    <strong>{t(lang, "banner.fixture")}</strong>
                    {t(lang, "banner.fixtureText")}
                </div>
            )}

            <div class="filter-bar" data-filter-bar>
                <label class="filter-select">
                    <span class="filter-bar__label">{t(lang, "itvs.area")}</span>
                    <select data-key="area" aria-label={t(lang, "itvs.areaBy")}>
                        <option value="">{t(lang, "itvs.allF")}</option>
                        {areas.map((a) => (
                            <option value={a.toLowerCase()}>{tv(lang, a)}</option>
                        ))}
                    </select>
                </label>
                <label class="filter-select">
                    <span class="filter-bar__label">{t(lang, "itvs.viability")}</span>
                    <select data-key="viable" aria-label={t(lang, "itvs.viabilityBy")}>
                        <option value="">{t(lang, "itvs.allF")}</option>
                        <option value="si">{t(lang, "itvs.viable")}</option>
                        <option value="no">{t(lang, "itvs.notViable")}</option>
                    </select>
                </label>
                <label class="filter-select">
                    <span class="filter-bar__label">{t(lang, "itvs.org")}</span>
                    <select data-key="org" aria-label={t(lang, "itvs.orgBy")}>
                        <option value="">{t(lang, "itvs.allF")}</option>
                        {orgOptions.map((o) => (
                            <option value={o.id}>{o.name}</option>
                        ))}
                    </select>
                </label>

                {hasFin && sliderMax > sliderMin && (
                    <div class="range" data-range="fin">
                        <span class="filter-bar__label">{t(lang, "itvs.financing")}</span>
                        <div class="range__row">
                        <div class="range__control">
                            <div class="range__track"></div>
                            <div class="range__fill" data-range-fill></div>
                            <input
                                type="range"
                                data-range-lo
                                min={sliderMin}
                                max={sliderMax}
                                step={step}
                                value={sliderMin}
                                aria-label={t(lang, "itvs.finMin")}
                            />
                            <input
                                type="range"
                                data-range-hi
                                min={sliderMin}
                                max={sliderMax}
                                step={step}
                                value={sliderMax}
                                aria-label={t(lang, "itvs.finMax")}
                            />
                        </div>
                        <span class="range__out" data-range-out></span>
                        </div>
                    </div>
                )}
            </div>

            <div class="view-bar">
                <span class="filter-bar__count" data-visible-count>
                    {t(lang, "filter.shown", { n: interventions.length })}
                </span>
                <div class="view-switch" role="group" aria-label={t(lang, "itvs.view")}>
                    <button class="chip is-active" data-view="cards">
                        {t(lang, "itvs.cards")}
                    </button>
                    <button class="chip" data-view="table">{t(lang, "itvs.table")}</button>
                </div>
            </div>

            {interventions.length > 0 ? (
                <>
                    <div class="itv-grid" data-view-panel="cards">
                        {interventions.map((itv) => (
                            <InterventionCard
                                intervention={itv}
                                orgNames={interventionOrgNames(itv, orgMap)}
                                lang={lang}
                            />
                        ))}
                    </div>

                    <div class="itv-table-wrap" data-view-panel="table" hidden>
                        <table class="itv-table">
                            <thead>
                                <tr>
                                    <th>{t(lang, "th.itv")}
                                    <th>{t(lang, "th.orgs")}
                                    <th>{t(lang, "th.area")}
                                    <th class="num">{t(lang, "th.value5")}
                                    <th class="num">{t(lang, "th.financing")}
                                    <th class="num">{t(lang, "th.years")}
                                    <th>{t(lang, "th.recurrent")}
                                    <th>{t(lang, "th.capital1")}
                                    <th>{t(lang, "th.capital2")}
                                    <th>{t(lang, "th.viable")}
                                </tr>
                            </thead>
                            <tbody>
                                {interventions.map((itv) => (
                                    <tr
                                        data-filterable
                                        data-item-id={itv.id}
                                        data-area={itv.areaTrabajo
                                            .map((a) => a.toLowerCase())
                                            .join("|")}
                                        data-viable={
                                            itv.viable === null
                                                ? "unknown"
                                                : itv.viable
                                                  ? "si"
                                                  : "no"
                                        }
                                        data-org={itv.orgIds.join("|")}
                                        data-fin={itv.financiacion ?? ""}
                                    >
                                        <th scope="row">{itv.name}</th>
                                        <td>
                                            {interventionOrgNames(itv, orgMap).join(", ") || "—"}
                                        </td>
                                        <td>{itv.areaTrabajo.map((a) => tv(lang, a)).join(", ") || "—"}</td>
                                        <td class="num">
                                            {formatValor(itv.valor5Anos, itv.valor5AnosRaw, loc)}
                                        </td>
                                        <td class="num">{formatEuro(itv.financiacion, loc)}</td>
                                        <td class="num">{itv.anos ?? "—"}</td>
                                        <td>{viableText(itv.recurrente)}</td>
                                        <td>{itv.capital1 ? tv(lang, itv.capital1) : "—"}</td>
                                        <td>{itv.capital2 ? tv(lang, itv.capital2) : "—"}</td>
                                        <td>{viableText(itv.viable)}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </>
            ) : (
                <p class="empty-note">{t(lang, "itvs.none")}</p>
            )}
            <p class="empty-note" data-empty hidden>
                {t(lang, "itvs.noMatch")}
            </p>
        </div>
    </section>
</Layout>

<script>
    import { initGalleryFilters } from "../scripts/gallery-filter";
    initGalleryFilters();

    // Cards / table switcher
    const buttons = document.querySelectorAll<HTMLElement>("[data-view]");
    buttons.forEach((btn) =>
        btn.addEventListener("click", () => {
            const view = btn.dataset.view;
            buttons.forEach((b) => b.classList.toggle("is-active", b === btn));
            document
                .querySelectorAll<HTMLElement>("[data-view-panel]")
                .forEach((p) => (p.hidden = p.dataset.viewPanel !== view));
        }),
    );
</script>

<style>
    .section {
        padding: var(--space-16) 0 var(--space-20);
    }

    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: var(--space-4) var(--space-6);
        margin-bottom: var(--space-4);
    }

    .filter-select {
        display: inline-flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .filter-select select {
        font-family: var(--mono);
        font-size: var(--text-xs);
        padding: 0.45rem 0.6rem;
        height: var(--control-h);
        box-sizing: border-box;
        background: var(--bg);
        color: var(--text-primary);
        border: 1px solid var(--border-default);
        border-radius: var(--radius);
        min-width: 11rem;
        max-width: 18rem;
    }

    .filter-bar__label {
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
    }

    .filter-bar__count {
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
        white-space: nowrap;
    }

    /* dual-handle slider */
    .range {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        min-width: 16rem;
    }

    .range__row {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        height: 2rem; /* same height as the select boxes beside it */
    }

    .range__control {
        position: relative;
        height: 1.6rem;
        width: 11rem;
    }

    .range__track,
    .range__fill {
        position: absolute;
        top: 50%;
        height: 4px;
        transform: translateY(-50%);
    }

    .range__track {
        left: 0;
        right: 0;
        background: var(--border-subtle);
    }

    .range__fill {
        background: var(--pillar-flow-3);
    }

    .range__control input[type="range"] {
        position: absolute;
        inset: 0;
        width: 100%;
        margin: 0;
        background: none;
        pointer-events: none;
        -webkit-appearance: none;
        appearance: none;
    }

    .range__control input[type="range"]::-webkit-slider-runnable-track {
        background: none;
    }

    .range__control input[type="range"]::-moz-range-track {
        background: none;
    }

    .range__control input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        pointer-events: auto;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--text-primary);
        border: 2px solid var(--paper);
        cursor: grab;
    }

    .range__control input[type="range"]::-moz-range-thumb {
        pointer-events: auto;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--text-primary);
        border: 2px solid var(--paper);
        cursor: grab;
    }

    .range__out {
        font-family: var(--mono);
        font-size: var(--text-xs);
        color: var(--text-primary);
    }

    .view-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        margin-bottom: var(--space-5);
        padding-top: var(--space-3);
        border-top: 1px solid var(--border-subtle);
    }

    .view-switch {
        display: inline-flex;
        gap: var(--space-2);
    }

    .itv-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: var(--space-5);
    }

    .itv-grid[hidden],
    .itv-table-wrap[hidden] {
        display: none;
    }

    .itv-table-wrap {
        overflow-x: auto;
        border: 1px solid var(--border-subtle);
    }

    .itv-table {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--text-sm);
    }

    .itv-table th,
    .itv-table td {
        padding: 0.65rem 0.8rem;
        text-align: left;
        vertical-align: top;
        border-bottom: 1px solid var(--border-subtle);
    }

    .itv-table thead th {
        position: sticky;
        top: 0;
        background: var(--surface-1);
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: var(--text-muted);
        white-space: nowrap;
    }

    .itv-table tbody th {
        font-family: var(--serif);
        font-weight: 400;
        min-width: 14rem;
    }

    .itv-table .num {
        text-align: right;
        font-family: var(--mono);
        white-space: nowrap;
    }

    .itv-table tbody tr:hover {
        background: var(--surface-1);
    }

    .empty-note {
        font-family: var(--mono);
        font-size: var(--text-sm);
        color: var(--text-muted);
        border: 1px dashed var(--border-subtle);
        padding: var(--space-6);
        text-align: center;
    }

    .data-banner {
        margin-bottom: var(--space-6);
        padding: var(--space-4) var(--space-5);
        border: 1px solid color-mix(in srgb, var(--status-danger-mid) 45%, transparent);
        background: color-mix(in srgb, var(--status-danger-mid) 7%, var(--bg));
        font-size: var(--text-sm);
    }

    .data-banner--fixture {
        border-color: var(--border-default);
        background: color-mix(in srgb, var(--pillar-flow-2) 14%, var(--bg));
    }
</style>
