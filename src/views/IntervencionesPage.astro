---
import "../styles/app.css";
// Intervenciones — filterable portfolio with a cards/table switcher.
import Layout from "@motiu/design/components/Layout.astro";
import SectionHeading from "@motiu/design/components/SectionHeading.astro";
import Badge from "@motiu/design/components/Badge.astro";
import Check from "@motiu/design/components/Check.astro";
import InterventionCard from "../components/InterventionCard.astro";
import { areaTone } from "../lib/areas";
import { loadSiteData } from "../lib/data";
import { formatValor, formatEuro, interventionOrgNames } from "../lib/records";
import { t, tv, numberLocale } from "../lib/i18n";
import type { Lang } from "../lib/i18n";

export interface Props {
    lang?: Lang;
}
const { lang = "es" } = Astro.props;
const loc = numberLocale(lang);

const { orgMap, interventions, dataError, dataSource } = await loadSiteData();

const collator = new Intl.Collator(lang);
const areas = [...new Set(interventions.flatMap((i) => i.areaTrabajo))].sort(
    collator.compare,
);
const orgOptions = [...new Set(interventions.flatMap((i) => i.orgIds))]
    .map((id) => ({ id, name: orgMap.get(id)?.name }))
    .filter((o): o is { id: string; name: string } => !!o.name)
    .sort((a, b) => collator.compare(a.name, b.name));

// Financing slider: min..max of the figures present, on a "nice" step.
const fins = interventions
    .map((i) => i.financiacion)
    .filter((n): n is number => n !== null);
const hasFin = fins.length > 0;
const finMin = hasFin ? Math.min(...fins) : 0;
const finMax = hasFin ? Math.max(...fins) : 0;
const span = Math.max(finMax - finMin, 1);
const step = Math.max(1, Math.pow(10, Math.floor(Math.log10(span)) - 2));
// The thumbs start at the real min and max, with track left beyond them (about 10% of the span each side),
// so it reads as a slider and not as a filled bar.
const startLo = Math.floor(finMin / step) * step;
const startHi = Math.ceil(finMax / step) * step;
const pad = Math.max(span * 0.1, step);
const sliderMin = Math.max(0, Math.floor((finMin - pad) / step) * step);
const sliderMax = Math.ceil((finMax + pad) / step) * step;

---

<Layout
    title={t(lang, "itvs.title")}
    description={t(lang, "itvs.description")}
    current="intervenciones"
    lang={lang}
>
    <section class="section">
        <div class="container">
            <SectionHeading
                eyebrow={t(lang, "itvs.overline")}
                title={t(lang, "itvs.heading")}
                intro={t(lang, "itvs.intro")}
            />

            {dataError && (
                <div class="data-banner" role="alert">
                    <strong>{t(lang, "banner.error")}</strong> {dataError}
                </div>
            )}
            {!dataError && dataSource === "fixture" && (
                <div class="data-banner data-banner--fixture">
                    <strong>{t(lang, "banner.fixture")}</strong>
                    {t(lang, "banner.fixtureText")}
                </div>
            )}

            <div class="filter-bar" data-filter-bar>
                <label class="filter-select">
                    <span class="filter-bar__label">{t(lang, "itvs.area")}</span>
                    <select class="select" data-key="area" aria-label={t(lang, "itvs.areaBy")}>
                        <option value="">{t(lang, "itvs.allF")}</option>
                        {areas.map((a) => (
                            <option value={a.toLowerCase()}>{tv(lang, a)}</option>
                        ))}
                    </select>
                </label>
                <label class="filter-select">
                    <span class="filter-bar__label">{t(lang, "itvs.viability")}</span>
                    <select class="select" data-key="viable" aria-label={t(lang, "itvs.viabilityBy")}>
                        <option value="">{t(lang, "itvs.allF")}</option>
                        <option value="si">{t(lang, "itvs.viable")}</option>
                        <option value="no">{t(lang, "itvs.notViable")}</option>
                    </select>
                </label>
                <label class="filter-select">
                    <span class="filter-bar__label">{t(lang, "itvs.org")}</span>
                    <select class="select" data-key="org" aria-label={t(lang, "itvs.orgBy")}>
                        <option value="">{t(lang, "itvs.allF")}</option>
                        {orgOptions.map((o) => (
                            <option value={o.id}>{o.name}</option>
                        ))}
                    </select>
                </label>

                {hasFin && sliderMax > sliderMin && (
                    <div class="range" data-range="fin">
                        <span class="filter-bar__label">{t(lang, "itvs.financing")}</span>
                        <div class="range__row">
                        <div class="range__control">
                            <div class="range__track"></div>
                            <div class="range__fill" data-range-fill></div>
                            <input
                                type="range"
                                data-range-lo
                                min={sliderMin}
                                max={sliderMax}
                                step={step}
                                value={startLo}
                                data-default={startLo}
                                aria-label={t(lang, "itvs.finMin")}
                            />
                            <input
                                type="range"
                                data-range-hi
                                min={sliderMin}
                                max={sliderMax}
                                step={step}
                                value={startHi}
                                data-default={startHi}
                                aria-label={t(lang, "itvs.finMax")}
                            />
                        </div>
                        <span class="range__out" data-range-out></span>
                        </div>
                    </div>
                )}
            </div>

            <div class="view-bar">
                <span class="filter-bar__count" data-visible-count>
                    {t(lang, "filter.shown", { n: interventions.length })}
                </span>
                <div class="chip-group" role="group" aria-label={t(lang, "itvs.view")}>
                    <button class="chip is-active" data-view="cards">
                        {t(lang, "itvs.cards")}
                    </button>
                    <button class="chip" data-view="table">{t(lang, "itvs.table")}</button>
                    <button class="chip" data-view="areas">{t(lang, "itvs.areas")}</button>
                </div>
            </div>

            {interventions.length > 0 ? (
                <>
                    <div class="itv-grid" data-view-panel="cards" data-shuffle>
                        {interventions.map((itv) => (
                            <InterventionCard
                                intervention={itv}
                                orgNames={interventionOrgNames(itv, orgMap)}
                                lang={lang}
                            />
                        ))}
                    </div>

                    <div class="itv-table-wrap" data-view-panel="table" hidden>
                        <table class="itv-table">
                            <thead>
                                <tr>
                                    <th>{t(lang, "th.itv")}</th>
                                    <th>{t(lang, "card.orgs")}</th>
                                    <th>{t(lang, "card.area")}</th>
                                    <th class="num">{t(lang, "card.financing")}</th>
                                    <th class="num">{t(lang, "card.years")}</th>
                                    <th>{t(lang, "card.recurrence")}</th>
                                    <th class="num">{t(lang, "card.value5")}</th>
                                    <th>{t(lang, "card.capital")}</th>
                                    <th>{t(lang, "card.viability")}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {interventions.map((itv) => (
                                    <tr
                                        data-filterable
                                        data-item-id={itv.id}
                                        data-area={itv.areaTrabajo
                                            .map((a) => a.toLowerCase())
                                            .join("|")}
                                        data-viable={
                                            itv.viable === null
                                                ? "unknown"
                                                : itv.viable
                                                  ? "si"
                                                  : "no"
                                        }
                                        data-org={itv.orgIds.join("|")}
                                        data-fin={itv.financiacion ?? ""}
                                        data-valor5={itv.valor5Anos ?? ""}
                                    >
                                        <th scope="row">{itv.name}</th>
                                        <td class="itv-table__orgs">
                                            {interventionOrgNames(itv, orgMap).join(" · ")}
                                        </td>
                                        <td>
                                            <span class="itv-table__tags">
                                                {itv.areaTrabajo.map((a) => (
                                                    <Badge tone={areaTone(a) as any} size="sm">{tv(lang, a)}</Badge>
                                                ))}
                                            </span>
                                        </td>
                                        <td class="num">{formatEuro(itv.financiacion, loc)}</td>
                                        <td class="num">{itv.anos ?? "—"}</td>
                                        <td>{itv.recurrente === true && <Check label={t(lang, "card.recYes")} />}</td>
                                        <td class="num">
                                            {formatValor(itv.valor5Anos, itv.valor5AnosRaw, loc)}
                                        </td>
                                        <td>
                                            <span class="itv-table__tags">
                                                {[itv.capital1, itv.capital2].filter(Boolean).map((c) => (
                                                    <Badge shape="square" size="sm">{tv(lang, c)}</Badge>
                                                ))}
                                            </span>
                                        </td>
                                        <td>{itv.viable === true && <Check label={t(lang, "card.viableYes")} />}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>

                    <div class="area-view" data-view-panel="areas" hidden>
                        <div class="area-view__bubbles" data-bubbles>
                            {areas.map((a) => (
                                <div class="area-bubble" data-bubble-area={a.toLowerCase()}>
                                    <span class={`area-bubble__disc badge badge--${areaTone(a)}`}></span>
                                    <span class="area-bubble__caption">
                                        <span class="area-bubble__name">{tv(lang, a)}</span>
                                        <span class="area-bubble__value" data-bubble-value></span>
                                        <span class="area-bubble__count" data-bubble-count></span>
                                    </span>
                                </div>
                            ))}
                        </div>
                        <p class="area-view__note">{t(lang, "itvs.areasNote")}</p>
                    </div>
                </>
            ) : (
                <p class="empty-note">{t(lang, "itvs.none")}</p>
            )}
            <p class="empty-note" data-empty hidden>
                {t(lang, "itvs.noMatch")}
            </p>
        </div>
    </section>
</Layout>

<script>
    import { initGalleryFilters } from "../scripts/gallery-filter";
    initGalleryFilters();

    // Cards / table switcher
    const buttons = document.querySelectorAll<HTMLElement>("[data-view]");
    buttons.forEach((btn) =>
        btn.addEventListener("click", () => {
            const view = btn.dataset.view;
            buttons.forEach((b) => b.classList.toggle("is-active", b === btn));
            document
                .querySelectorAll<HTMLElement>("[data-view-panel]")
                .forEach((p) => (p.hidden = p.dataset.viewPanel !== view));
        }),
    );

    // Areas view: one circle per work area, sized (by area) by the summed 5-year value of the
    // interventions the filters leave visible.
    const bubbleBox = document.querySelector<HTMLElement>("[data-bubbles]");
    if (bubbleBox) {
        const lang = document.documentElement.lang === "en" ? "en" : "es";
        const locale = lang === "en" ? "en-GB" : "es-ES";
        const countText = (n: number) => (lang === "en" ? `${n} interventions` : `${n} intervenciones`);
        const money = (n: number) =>
            `${n.toLocaleString(locale, { notation: "compact", maximumFractionDigits: 1 })} €`;
        const bubbles = [...bubbleBox.querySelectorAll<HTMLElement>("[data-bubble-area]")];
        const rows = [...document.querySelectorAll<HTMLElement>("tr[data-filterable]")];
        const MIN_D = 14;

        const updateBubbles = () => {
            const sums = new Map<string, { value: number; count: number }>();
            for (const b of bubbles) sums.set(b.dataset.bubbleArea!, { value: 0, count: 0 });
            for (const r of rows) {
                if (r.hidden) continue;
                const v = Number(r.dataset.valor5);
                for (const a of (r.dataset.area ?? "").split("|").filter(Boolean)) {
                    const e = sums.get(a);
                    if (!e) continue;
                    e.count += 1;
                    if (r.dataset.valor5 !== "" && !Number.isNaN(v)) e.value += v;
                }
            }
            const max = Math.max(...[...sums.values()].map((e) => e.value), 0);
            const W = bubbleBox.clientWidth;
            const cluster = W >= 720;
            bubbleBox.classList.toggle("is-cluster", cluster);
            // The largest circle is always MAX_D wide; the others follow by area.
            const maxD = cluster ? Math.min(300, W * 0.34) : Math.min(200, (W - 24) / 2);
            const items = bubbles.map((b) => {
                const e = sums.get(b.dataset.bubbleArea!)!;
                const d = max > 0 && e.value > 0 ? Math.max(MIN_D, Math.sqrt(e.value / max) * maxD) : MIN_D;
                b.querySelector("[data-bubble-value]")!.textContent = e.count > 0 ? money(e.value) : "—";
                b.querySelector("[data-bubble-count]")!.textContent = countText(e.count);
                return { b, d, value: e.value };
            });
            if (!cluster) {
                for (const { b, d } of items) {
                    b.style.cssText = `--d:${d}px`;
                    b.dataset.pos = "";
                }
                bubbleBox.style.height = "";
                return;
            }

            // Cluster: one circle in the middle, the rest around it, each one a
            // gap's width from the centre circle and captions facing outwards.
            // Articulación e impulso is the hub the other areas hang from, so it always sits in
            // the middle; if it is missing, the biggest circle takes its place.
            items.sort((x, y) => y.value - x.value);
            const GAP = 16;
            const hub = items.find((it) => it.b.dataset.bubbleArea!.startsWith("articulaci"));
            // ...unless the filters have shrunk it to a dot: then the biggest circle leads.
            const centre = hub && hub.d >= maxD * 0.3 ? hub : items[0];
            const ring = items.filter((it) => it !== centre);
            const pos = new Map<HTMLElement, { x: number; y: number; dx: number; dy: number }>();
            pos.set(centre.b, { x: 0, y: 0, dx: 0, dy: 0 });
            ring.forEach((it, i) => {
                // start at the top, then clockwise; widen the angle to the horizontal axis a little
                const ang = -Math.PI / 2 + (2 * Math.PI * i) / Math.max(ring.length, 1) + Math.PI / ring.length;
                const dist = centre.d / 2 + it.d / 2 + GAP;
                pos.set(it.b, { x: Math.cos(ang) * dist, y: Math.sin(ang) * dist, dx: Math.cos(ang), dy: Math.sin(ang) });
            });
            // Push ring circles apart if they ended up overlapping.
            for (let pass = 0; pass < 40; pass++) {
                for (let i = 0; i < ring.length; i++) {
                    for (let j = i + 1; j < ring.length; j++) {
                        const a = pos.get(ring[i].b)!, c = pos.get(ring[j].b)!;
                        const dx = c.x - a.x, dy = c.y - a.y;
                        const dist = Math.hypot(dx, dy) || 1;
                        const need = ring[i].d / 2 + ring[j].d / 2 + GAP / 2;
                        if (dist < need) {
                            const k = (need - dist) / 2 / dist;
                            a.x -= dx * k; a.y -= dy * k; c.x += dx * k; c.y += dy * k;
                        }
                    }
                }
            }
            for (const { b, d } of items) {
                const p = pos.get(b)!;
                const dirX = b === centre.b ? 0 : p.x, dirY = b === centre.b ? 0 : p.y;
                const side = b === centre.b ? (d >= 170 ? "in" : "below") : Math.abs(dirX) > Math.abs(dirY) * 1.1 ? (dirX > 0 ? "right" : "left") : dirY > 0 ? "below" : "above";
                b.style.cssText = `--d:${d}px;left:${p.x}px;top:${p.y}px`;
                b.dataset.pos = side;
            }
            // Centre the whole cluster, captions included, in the box.
            const boxRect = bubbleBox.getBoundingClientRect();
            let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
            for (const { b } of items) {
                for (const el of [b.querySelector(".area-bubble__disc")!, b.querySelector(".area-bubble__caption")!]) {
                    const r = el.getBoundingClientRect();
                    minX = Math.min(minX, r.left - boxRect.left); maxX = Math.max(maxX, r.right - boxRect.left);
                    minY = Math.min(minY, r.top - boxRect.top); maxY = Math.max(maxY, r.bottom - boxRect.top);
                }
            }
            const PAD = 16;
            const shiftX = W / 2 - (minX + maxX) / 2;
            const shiftY = PAD - minY;
            bubbleBox.style.height = `${maxY - minY + PAD * 2}px`;
            for (const { b } of items) {
                b.style.left = `${parseFloat(b.style.left) + shiftX}px`;
                b.style.top = `${parseFloat(b.style.top) + shiftY}px`;
            }
        };
        document.addEventListener("gallery:applied", updateBubbles);
        buttons.forEach((b) => b.addEventListener("click", updateBubbles));
        window.addEventListener("resize", updateBubbles);
        updateBubbles();
    }
</script>

<style>
    .section {
        padding: var(--space-16) 0 var(--space-20);
    }

    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: var(--space-4) var(--space-6);
        margin-bottom: var(--space-4);
    }

    .filter-select {
        display: inline-flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .filter-select select {
        min-width: 11rem;
        max-width: 18rem;
    }

    .filter-bar__label {
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
    }

    .filter-bar__count {
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
        white-space: nowrap;
    }

    /* dual-handle slider */
    .range {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        min-width: 16rem;
    }

    .range__row {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        height: 2rem; /* same height as the select boxes beside it */
    }

    .range__control {
        position: relative;
        height: 1.6rem;
        width: 11rem;
    }

    /* Same look as the simulator's sliders: a rounded track with a light remainder and a thin outline,
       a dark fill, plain dark round thumbs. */
    .range__track,
    .range__fill {
        position: absolute;
        top: 50%;
        height: 8px;
        border-radius: 999px;
        transform: translateY(-50%);
    }

    .range__track {
        left: 0;
        right: 0;
        background: var(--bone);
        border: 1px solid var(--border-default);
        box-sizing: border-box;
    }

    .range__fill {
        background: var(--text-primary);
    }

    .range__control input[type="range"] {
        position: absolute;
        inset: 0;
        width: 100%;
        margin: 0;
        background: none;
        pointer-events: none;
        -webkit-appearance: none;
        appearance: none;
    }

    .range__control input[type="range"]::-webkit-slider-runnable-track {
        background: none;
    }

    .range__control input[type="range"]::-moz-range-track {
        background: none;
    }

    .range__control input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        pointer-events: auto;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--text-primary);
        border: 0;
        cursor: grab;
    }

    .range__control input[type="range"]::-moz-range-thumb {
        pointer-events: auto;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--text-primary);
        border: 0;
        cursor: grab;
    }

    .range__out {
        font-family: var(--mono);
        font-size: var(--text-xs);
        color: var(--text-primary);
    }

    .view-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        margin-bottom: var(--space-5);
        padding-top: var(--space-3);
        border-top: 1px solid var(--border-subtle);
    }

    /* One joined block: the buttons share a border, no gap between them. */
    .area-view {
        padding: var(--space-8) 0 var(--space-4);
    }

    .area-view[hidden] {
        display: none;
    }

    .area-view__bubbles {
        position: relative;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: flex-start;
        gap: var(--space-8) var(--space-6);
    }

    .area-bubble {
        --d: 120px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-3);
        text-align: center;
    }

    .area-bubble__disc.badge {
        display: block;
        box-sizing: border-box;
        width: var(--d);
        height: var(--d);
        padding: 0;
        border-radius: 50%;
        border-width: 1.5px;
        transition: width var(--t-med), height var(--t-med);
    }

    .area-bubble__caption {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-1);
    }

    /* Cluster: circles placed around a centre point; the box is sized and centred by the script. */
    .is-cluster .area-bubble {
        position: absolute;
        display: block;
        width: var(--d);
        height: var(--d);
        translate: -50% -50%;
    }
    .is-cluster .area-bubble__disc.badge {
        position: absolute;
        inset: 0;
    }
    .is-cluster .area-bubble__caption {
        position: absolute;
        width: max-content;
        max-width: 14rem;
    }
    .is-cluster [data-pos="in"] .area-bubble__caption {
        inset: 0;
        width: auto;
        max-width: none;
        justify-content: center;
    }
    .is-cluster [data-pos="above"] .area-bubble__caption {
        bottom: calc(100% + var(--space-3));
        left: 50%;
        translate: -50% 0;
        text-align: center;
    }
    .is-cluster [data-pos="below"] .area-bubble__caption {
        top: calc(100% + var(--space-3));
        left: 50%;
        translate: -50% 0;
        text-align: center;
    }
    .is-cluster [data-pos="right"] .area-bubble__caption {
        left: calc(100% + var(--space-4));
        top: 50%;
        translate: 0 -50%;
        align-items: flex-start;
        text-align: left;
    }
    .is-cluster [data-pos="left"] .area-bubble__caption {
        right: calc(100% + var(--space-4));
        top: 50%;
        translate: 0 -50%;
        align-items: flex-end;
        text-align: right;
    }

    .area-bubble__name {
        font-size: var(--text-md);
        font-weight: 500;
        color: var(--text-primary);
    }

    .area-bubble__value {
        font-family: var(--mono);
        font-size: var(--text-sm);
        color: var(--text-primary);
    }

    .area-bubble__count {
        font-family: var(--mono);
        font-size: var(--text-xs);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
    }

    .area-view__note {
        margin: var(--space-8) 0 0;
        text-align: center;
        font-family: var(--mono);
        font-size: var(--text-xs);
        color: var(--text-muted);
    }

    .itv-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: var(--space-5);
    }

    .itv-grid[hidden],
    .itv-table-wrap[hidden] {
        display: none;
    }

    .itv-table-wrap {
        overflow-x: auto;
        border: 1px solid var(--border-subtle);
        border-radius: calc(var(--radius-card, 0.75rem) - 0.25rem);
    }

