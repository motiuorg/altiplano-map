---
import "../styles/app.css";
// Simulador económico — coste de la transición regenerativa por finca tipo, con
// módulo de crédito y escalado al paisaje. Datos de Notion a build-time (ver
// src/lib/simulador/data.ts); el cálculo corre en el navegador.
import Layout from "@motiu/design/components/Layout.astro";
import SectionHeading from "@motiu/design/components/SectionHeading.astro";
import Tabs from "@motiu/design/components/tabs/Tabs.astro";
import Tab from "@motiu/design/components/tabs/Tab.astro";
import { loadSimuladorData } from "../lib/simulador/data";
import { precioActualAlmendra, historicoAlmendra } from "../lib/simulador/precio-actual";
import { t } from "../lib/i18n";
import type { Lang } from "../lib/i18n";

export interface Props {
    lang?: Lang;
}
const { lang = "es" } = Astro.props;
const T = ({
  "es": {
    "title_": "Altiplano Estepario — Simulador económico",
    "desc_": "Coste de la transición regenerativa por finca tipo en el Altiplano Estepario: flujo a 10 años, capacidad de repago y escala del paisaje.",
    "overline": "Análisis económico",
    "heading": "Simulador económico",
    "intro": "Cuánto cuesta pasar a manejo eco-regenerativo frente a seguir como hoy, cuánta financiación necesita cada finca tipo en su peor momento, si podría devolver un préstamo y cuánto suma en el paisaje.",
    "farm": "Finca tipo",
    "level": "Tipo de transición",
    "farmHa": "Tamaño de la finca (ha)",
    "transHa": "Ha en transición",
    "divTitle": "Diversificación",
    "divSub": "Otros ingresos en las hectáreas en transición: pagos por servicios ecosistémicos (€/ha/año) y otras producciones (cada deslizador indica en qué porcentaje de esas hectáreas se aplica). Valores orientativos, de confianza baja.",
    "units": "Ver en",
    "perFarmU": "€ por finca",
    "perHaU": "€ por ha",
    "divTable": "Módulos de diversificación",
    "divTableSub": "Valores por hectárea donde se aplica el módulo. El ahorro se calcula sobre el coste de cubierta y de enmiendas de la finca.",
    "assump": "Supuestos",
    "scenario": "Escenario",
    "pess": "Pesimista",
    "central": "Central",
    "opt": "Optimista",
    "pac": "Ayudas PAC",
    "uncertain": "Ingresos inciertos",
    "prima": "Prima regenerativa",
    "carbon": "Carbono",
    "tabCredit": "Crédito",
    "tabLandscape": "Paisaje",
    "tabSens": "Sensibilidad",
    "subPesa": "Qué pesa más",
    "subTodos": "Todos los supuestos",
    "subRef": "Datos de referencia",
    "scope": "Mostrar",
    "scopeFarm": "Esta finca tipo",
    "scopeAll": "Todos los cultivos",
    "allTitle": "Todos los supuestos",
    "allSub": "Valor en uso (con tus ajustes y el conjunto pesimista, central u optimista elegido), rango bajo–alto, fuente y confianza.",
    "flowTitle": "Flujo neto de la transición",
    "flowSub": "Frente a seguir como hoy · barras: año · línea: acumulado",
    "lgPos": "Neto anual (+)",
    "lgNeg": "Neto anual (−)",
    "lgCum": "Acumulado",
    "wfTitle": "De dónde sale el resultado a 10 años",
    "wfSub": "Suma 2027–2036 por partida",
    "detailTitle": "Detalle por año",
    "detailSub": "Diferencia frente a seguir como hoy",
    "credNote": "El préstamo cubre la necesidad máxima de financiación acumulada de la finca tipo. El DSCR compara la caja disponible (margen actual + efecto operativo de la transición) con la cuota.",
    "dscrTitle": "Cobertura del servicio de la deuda (DSCR)",
    "dscrSub": "Veces · línea discontinua: umbral exigible",
    "cfTitle": "Caja disponible frente a cuota",
    "cfSub": "€ por finca y año",
    "lgCash": "Caja disponible",
    "lgDebt": "Servicio de la deuda",
    "landNote": "Superficie de la zona combinada (Landscape Plan 2022) × cuota convencional/ecológica × captación. Las fincas entran de forma escalonada en 10 años. No depende de la finca tipo seleccionada.",
    "needTitle": "Necesidad de financiación por finca tipo",
    "needSub": "Millones de €, necesidad máxima acumulada",
    "landFlowTitle": "Flujo neto del paisaje",
    "landFlowSub": "Millones de € por año, todas las cohortes",
    "perFarm": "Por finca tipo",
    "tornTitle": "Qué supuestos mueven más el resultado",
    "tornSub": "Cambio en el VAN a 10 años (€/ha) al llevar cada supuesto a su valor bajo y alto, manteniendo el resto en el escenario elegido. Junto a cada supuesto se indica la confianza del dato; haz clic en una barra para ver su fuente.",
    "lgWorse": "Peor que el escenario",
    "lgBetter": "Mejor que el escenario",
    "crop": "Cultivo",
    "conf": "Confianza",
    "all": "Todas",
    "high": "Alta",
    "medium": "Media",
    "low": "Baja",
    "search": "Buscar",
    "params": "Parámetros",
    "paramsSub": "Valores bajo, central y alto de cada supuesto. El conjunto pesimista u optimista toma el extremo desfavorable o favorable para la finca.",
    "practices": "Prácticas regenerativas",
    "practicesSub": "Coste por hectárea de superficie de la finca (cobertura y frecuencia ya aplicadas en el modelo)",
    "traj": "Trayectorias",
    "trajSub": "Evolución año a año · nivel de transición seleccionado",
    "ph": "parámetro, fuente…",
    "pricesTitle": "Supuestos de ingresos",
    "pricesSub": "Precios del cultivo de la finca tipo seleccionada, sobreprecio regenerativo, pagos por servicios ecosistémicos y diversificación. Afectan a todas las pestañas; pon un valor a 0 para quitarlo.",
    "adjust": "Ajustar",
    "close": "Cerrar",
    "reset": "Restablecer",
    "lonjaTitle": "Precio de la almendra en la Lonja de Murcia",
    "lonjaSub": "Media de cada campaña (septiembre–agosto), €/kg grano, sobre almacén agricultor. El rango bajo–alto del simulador es la peor y la mejor campaña; el central, la media."
  },
  "en": {
    "title_": "Altiplano Estepario — Economic simulator",
    "desc_": "Cost of the regenerative transition per typical farm in the Altiplano Estepario: 10-year cash flow, repayment capacity and landscape scale.",
    "overline": "Economic analysis",
    "heading": "Economic simulator",
    "intro": "How much it costs to move to eco-regenerative management compared with carrying on as today, how much financing each typical farm needs at its worst moment, whether it could repay a loan, and what it adds up to across the landscape.",
    "farm": "Typical farm",
    "level": "Transition type",
    "farmHa": "Farm size (ha)",
    "transHa": "Ha in transition",
    "divTitle": "Diversification",
    "divSub": "Other income on the hectares in transition: payments for ecosystem services (€/ha/year) and other productions (each slider sets the share of those hectares where it applies). Indicative values, low confidence.",
    "units": "Show in",
    "perFarmU": "€ per farm",
    "perHaU": "€ per ha",
    "divTable": "Diversification modules",
    "divTableSub": "Values per hectare where the module applies. Savings are computed on the farm's cover-crop and amendment costs.",
    "assump": "Assumptions",
    "scenario": "Scenario",
    "pess": "Pessimistic",
    "central": "Central",
    "opt": "Optimistic",
    "pac": "CAP support",
    "uncertain": "Uncertain income",
    "prima": "Regenerative premium",
    "carbon": "Carbon",
    "tabCredit": "Credit",
    "tabLandscape": "Landscape",
    "tabSens": "Sensitivity",
    "subPesa": "What matters most",
    "subTodos": "All assumptions",
    "subRef": "Reference data",
    "scope": "Show",
    "scopeFarm": "This typical farm",
    "scopeAll": "All crops",
    "allTitle": "All assumptions",
    "allSub": "Value in use (with your adjustments and the chosen pessimistic, central or optimistic set), low–high range, source and confidence.",
    "flowTitle": "Net cash flow of the transition",
    "flowSub": "Versus carrying on as today · bars: year · line: cumulative",
    "lgPos": "Annual net (+)",
    "lgNeg": "Annual net (−)",
    "lgCum": "Cumulative",
    "wfTitle": "Where the 10-year result comes from",
    "wfSub": "Sum 2027–2036 by item",
    "detailTitle": "Detail by year",
    "detailSub": "Difference versus carrying on as today",
    "credNote": "The loan covers the typical farm's peak cumulative financing need. The DSCR compares available cash (current margin + operating effect of the transition) with the repayment.",
    "dscrTitle": "Debt service coverage (DSCR)",
    "dscrSub": "Times · dashed line: required threshold",
    "cfTitle": "Available cash versus repayment",
    "cfSub": "€ per farm and year",
    "lgCash": "Available cash",
    "lgDebt": "Debt service",
    "landNote": "Area of the combined zone (Landscape Plan 2022) × conventional/organic share × uptake. Farms join gradually over 10 years. It does not depend on the selected typical farm.",
    "needTitle": "Financing need by typical farm",
    "needSub": "Millions of €, peak cumulative need",
    "landFlowTitle": "Net cash flow of the landscape",
    "landFlowSub": "Millions of € per year, all cohorts",
    "perFarm": "By typical farm",
    "tornTitle": "Which assumptions move the result most",
    "tornSub": "Change in the 10-year NPV (€/ha) when each assumption is moved to its low and high value, keeping the rest in the chosen scenario. The confidence of the data is shown next to each assumption; click a bar to see its source.",
    "lgWorse": "Worse than the scenario",
    "lgBetter": "Better than the scenario",
    "crop": "Crop",
    "conf": "Confidence",
    "all": "All",
    "high": "High",
    "medium": "Medium",
    "low": "Low",
    "search": "Search",
    "params": "Parameters",
    "paramsSub": "Low, central and high values of each assumption. The pessimistic or optimistic set takes the unfavourable or favourable extreme for the farm.",
    "practices": "Regenerative practices",
    "practicesSub": "Cost per hectare of farm area (coverage and frequency already applied in the model)",
    "traj": "Trajectories",
    "trajSub": "Year-by-year evolution · selected transition level",
    "ph": "parameter, source…",
    "pricesTitle": "Income assumptions",
    "pricesSub": "Crop prices of the selected typical farm, regenerative premium, payments for ecosystem services and diversification. They apply to every tab; set a value to 0 to remove it.",
    "adjust": "Adjust",
    "close": "Close",
    "reset": "Reset",
    "lonjaTitle": "Almond price at the Lonja de Murcia",
    "lonjaSub": "Average of each season (September–August), €/kg kernel, farm-gate warehouse. The simulator's low–high range is the worst and best season; the central value is the average."
  }
} as Record<Lang, Record<string, string>>)[lang];

const [{ datos }, actual] = await Promise.all([loadSimuladorData(), precioActualAlmendra()]);
const precios = { actual, campanas: historicoAlmendra.campanas, fuentes: historicoAlmendra.fuentes };
// Safe to inline: escape "<" so no value can close the script element.
const json = JSON.stringify({ datos, precios }).replace(/</g, "\\u003c");
---

<Layout
    title={T.title_}
    description={T.desc_}
    lang={lang}
    current="simulador"
>
    <section class="section sim">
        <div class="container">
            <SectionHeading
                eyebrow={T.overline}
                title={T.heading}
                intro={T.intro}
            />

            <div class="filter-bar">
                <label class="filter-select">
                    <span class="filter-bar__label">{T.farm}</span>
                    <select id="f-arq" class="select"></select>
                </label>
                <label class="filter-select">
                    <span class="filter-bar__label">{T.level}</span>
                    <select id="f-esc" class="select"></select>
                </label>
                <label class="filter-select filter-num">
                    <span class="filter-bar__label">{T.farmHa}</span>
                    <input type="number" id="f-ha" min="0.5" max="1000" step="0.5" inputmode="decimal" />
                </label>
                <label class="filter-select filter-num">
                    <span class="filter-bar__label">{T.transHa}</span>
                    <input type="number" id="f-hat" min="0" max="1000" step="0.5" inputmode="decimal" />
                </label>
                <div class="filter-select">
                    <span class="filter-bar__label">{T.scenario}</span>
                    <div class="sim-seg" id="f-conj">
                        <button class="chip" data-v="pesimista">{T.pess}</button>
                        <button class="chip is-active" data-v="central" aria-pressed="true">{T.central}</button>
                        <button class="chip" data-v="optimista">{T.opt}</button>
                    </div>
                </div>
                <div class="filter-select">
                    <span class="filter-bar__label">{T.pac}</span>
                    <div class="sim-seg" id="f-pac">
                        <button class="chip is-active" data-v="1" aria-pressed="true">100%</button>
                        <button class="chip" data-v="0.5">50%</button>
                        <button class="chip" data-v="0">0%</button>
                    </div>
                </div>
            </div>

            <div class="sim-precios-field">
                <span class="filter-bar__label">{T.pricesTitle}</span>
            <div class="sim-precios">
                <button type="button" class="sim-precios__head" id="precios-toggle" aria-expanded="false" aria-controls="precios-body">
                    <span class="caret caret--right" aria-hidden="true"></span>
                    <span class="sim-precios__resumen" id="precios-resumen"></span>
                    <span class="text-button sim-precios__accion" id="precios-accion" data-open={T.adjust} data-close={T.close}>{T.adjust}</span>
                </button>
                <div class="sim-precios__body" id="precios-body" hidden>
                    <div class="sim-precios__bar">
                        <p class="sim-card__sub">{T.pricesSub}</p>
                        <button type="button" class="text-button" id="precio-reset" disabled>{T.reset}</button>
                    </div>
                    <div class="sim-row" id="precio-sliders"></div>
                    <p class="filter-bar__label sim-precios__grupo">{T.divTitle}</p>
                    <p class="sim-card__sub sim-precios__nota">{T.divSub}</p>
                    <div class="sim-row" id="div-sliders"></div>
                </div>
            </div>
            </div>
            <div class="view-bar">
                <Tabs id="tabs" label={t(lang, "nav.label")} rule={false}>
                    <Tab value="finca" selected>{T.farm}</Tab>
                    <Tab value="credito">{T.tabCredit}</Tab>
                    <Tab value="paisaje">{T.tabLandscape}</Tab>
                    <Tab value="supuestos">{T.assump}</Tab>
                </Tabs>
                <div class="sim-unidad" role="group" aria-label={T.units}>
                    <span class="filter-bar__label">{T.units}</span>
                    <button type="button" class="chip is-active" data-u="finca" aria-pressed="true">{T.perFarmU}</button>
                    <button type="button" class="chip" data-u="ha" aria-pressed="false">{T.perHaU}</button>
                </div>
            </div>

            <!-- FINCA -->
            <section data-panel="finca">
                <div class="sim-grid sim-kpis" id="finca-kpis"></div>
                <div class="sim-grid sim-cols">
                    <div class="sim-card chart">
                        <h3 class="sim-card__title">{T.flowTitle}</h3>
                        <p class="sim-card__sub">{T.flowSub}</p>
                        <div class="legend"><span><i style="background:var(--pos)"></i>{T.lgPos}</span><span><i style="background:var(--neg)"></i>{T.lgNeg}</span><span><i class="line" style="background:var(--ink-2)"></i>{T.lgCum}</span></div>
                        <div id="ch-flujo"></div>
                    </div>
                    <div class="sim-card chart">
                        <h3 class="sim-card__title">{T.wfTitle}</h3>
                        <p class="sim-card__sub">{T.wfSub}</p>
                        <div id="ch-cascada"></div>
                    </div>
                </div>
                <div class="sim-card sim-card--table">
                    <div class="sim-card__head">
                        <div>
                            <h3 class="sim-card__title">{T.detailTitle}</h3>
                            <p class="sim-card__sub">{T.detailSub}</p>
                        </div>
                        <div class="desglose-tools" id="tb-finca-tools"></div>
                    </div>
                    <div class="table-wrap" id="tb-finca"></div>
                    <div id="tb-finca-nota"></div>
                </div>
            </section>

            <!-- CRÉDITO -->
            <section data-panel="credito" hidden>
                <div class="sim-card sim-card--controls">
                    <div class="sim-row" id="cred-sliders"></div>
                    <p class="sim-card__sub">{T.credNote}</p>
                </div>
                <div class="sim-grid sim-kpis" id="cred-kpis"></div>
                <div class="sim-grid sim-cols">
                    <div class="sim-card chart">
                        <h3 class="sim-card__title">{T.dscrTitle}</h3>
                        <p class="sim-card__sub">{T.dscrSub}</p>
                        <div id="ch-dscr"></div>
                    </div>
                    <div class="sim-card chart">
                        <h3 class="sim-card__title">{T.cfTitle}</h3>
                        <p class="sim-card__sub">{T.cfSub}</p>
                        <div class="legend"><span><i style="background:var(--s1)"></i>{T.lgCash}</span><span><i style="background:var(--s2)"></i>{T.lgDebt}</span></div>
                        <div id="ch-cfads"></div>
                    </div>
                </div>
                <div id="cred-aviso"></div>
            </section>

            <!-- PAISAJE -->
            <section data-panel="paisaje" hidden>
                <div class="sim-card sim-card--controls">
                    <div class="sim-row" id="pai-sliders"></div>
                    <p class="sim-card__sub">{T.landNote}</p>
                </div>
                <div class="sim-grid sim-kpis" id="pai-kpis"></div>
                <div class="sim-grid sim-cols">
                    <div class="sim-card chart">
                        <h3 class="sim-card__title">{T.needTitle}</h3>
                        <p class="sim-card__sub">{T.needSub}</p>
                        <div id="ch-pai-arq"></div>
                    </div>
                    <div class="sim-card chart">
                        <h3 class="sim-card__title">{T.landFlowTitle}</h3>
                        <p class="sim-card__sub">{T.landFlowSub}</p>
                        <div id="ch-pai-flujo"></div>
                    </div>
                </div>
                <div class="sim-card sim-card--table">
                    <h3 class="sim-card__title">{T.perFarm}</h3>
                    <div class="table-wrap" id="tb-paisaje"></div>
                    <div id="tb-paisaje-nota"></div>
                </div>
            </section>

            <!-- SUPUESTOS: sensitivity, all assumptions, reference data -->
            <section data-panel="supuestos" hidden>
                <Tabs id="subtabs" variant="outline" label={T.assump}>
                    <Tab data-sub="pesa" selected>{T.subPesa}</Tab>
                    <Tab data-sub="todos">{T.subTodos}</Tab>
                    <Tab data-sub="ref">{T.subRef}</Tab>
                </Tabs>

                <div data-sub-panel="pesa">
                    <div class="sim-card chart">
                        <h3 class="sim-card__title">{T.tornTitle}</h3>
                        <p class="sim-card__sub">{T.tornSub}</p>
                        <div class="legend"><span><i style="background:var(--neg)"></i>{T.lgWorse}</span><span><i style="background:var(--pos)"></i>{T.lgBetter}</span></div>
                        <div id="ch-tornado"></div>
                    </div>
                </div>

                <div data-sub-panel="todos" hidden>
                    <div class="filter-bar">
                        <div class="filter-select">
                            <span class="filter-bar__label">{T.scope}</span>
                            <div class="sim-seg" id="s-alcance">
                                <button class="chip is-active" data-v="finca" aria-pressed="true">{T.scopeFarm}</button>
                                <button class="chip" data-v="todos" aria-pressed="false">{T.scopeAll}</button>
                            </div>
                        </div>
                        <label class="filter-select">
                            <span class="filter-bar__label">{T.conf}</span>
                            <select id="s-conf" class="select"><option value="">{T.all}</option><option>{T.high}</option><option>{T.medium}</option><option>{T.low}</option></select>
                        </label>
                        <label class="filter-select sim-search">
                            <span class="filter-bar__label">{T.search}</span>
                            <input id="s-q" type="search" placeholder={T.ph} />
                        </label>
                    </div>
                    <div class="sim-card sim-card--table">
                        <h3 class="sim-card__title">{T.allTitle}</h3>
                        <p class="sim-card__sub">{T.allSub}</p>
                        <div class="desglose-tools" id="tb-sup-tools"></div>
                        <div class="table-wrap" id="tb-sup"></div>
                    </div>
                </div>

                <div data-sub-panel="ref" hidden>
                    <div class="sim-card sim-card--table">
                        <h3 class="sim-card__title">{T.lonjaTitle}</h3>
                        <p class="sim-card__sub">{T.lonjaSub}</p>
                        <div class="table-wrap" id="tb-lonja"></div>
                        <div id="tb-lonja-nota"></div>
                    </div>
                    <div class="sim-card sim-card--table">
                        <h3 class="sim-card__title">{T.traj}</h3>
                        <p class="sim-card__sub">{T.trajSub}</p>
                        <div class="table-wrap" id="tb-tray"></div>
                    </div>
                </div>
            </section>
            <p class="sim-meta" id="meta"></p>
        </div>
        <div id="tip" hidden></div>
    </section>
</Layout>

<script type="application/json" id="sim-data" set:html={json} />

<script>
    import Modelo from "../lib/simulador/model.js";
    import { iniciarSimulador } from "../scripts/simulador.js";
    const { datos, precios } = JSON.parse(document.getElementById("sim-data")!.textContent!);
    iniciarSimulador(datos, Modelo, document.documentElement.lang, precios);
</script>

<style is:global>
    /* Chart roles — positive/negative pair derived from the neural (blue) and flow
       (orange) pillars; validated for colour-vision deficiency and >= 3:1 on paper. */
    .sim {
        --pos: #0077c8;
        --neg: #e8590c;
        --s1: #0077c8;
        --s2: #e8590c;
        --ink-2: color-mix(in srgb, var(--umber) 80%, var(--paper));
        --surface: var(--bg);
        --grid: color-mix(in srgb, var(--rule) 18%, transparent);
        --axis: color-mix(in srgb, var(--rule) 55%, transparent);
        padding: var(--space-16) 0 var(--space-20);
    }

    /* data provenance: discreet pre-footer line */
    .sim .sim-meta {
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
        margin: var(--space-12) 0 0;
        padding-top: var(--space-4);
        border-top: 1px solid var(--border-subtle);
    }

    /* filter bar — same pattern as Intervenciones */
    .sim .filter-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: var(--space-4) var(--space-6);
        margin-bottom: var(--space-4);
    }
    .sim .filter-select {
        display: inline-flex;
        flex-direction: column;
        gap: var(--space-1);
    }
    .sim .filter-select select { min-width: 11rem; max-width: 22rem; }
    .sim .filter-select input[type="search"],
    .sim .filter-select input[type="number"] {
        font-family: var(--mono);
        font-size: var(--text-xs);
        padding: 0.45rem 0.6rem;
        background: var(--bg);
        color: var(--text-muted);
        border: 1px solid var(--border-default);
        border-radius: var(--radius);
        min-width: 11rem;
        max-width: 22rem;
    }
    .sim .filter-select input[type="search"]:focus,
    .sim .filter-select input[type="number"]:focus { color: var(--text-primary); }
    .sim .sim-search input { width: 100%; max-width: none; }
    .sim .sim-search { flex: 1 1 14rem; }
    .sim .filter-bar__label {
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
    }
    .sim .sim-seg { display: inline-flex; }
