---
import "../styles/app.css";
import Badge from "@motiu/design/components/Badge.astro";
import CardTitle from "@motiu/design/components/card/CardTitle.astro";
import CardText from "@motiu/design/components/card/CardText.astro";
import CardBadges from "@motiu/design/components/card/CardBadges.astro";
import CardLink from "@motiu/design/components/card/CardLink.astro";
// Altiplano Estepario — landing = Organizaciones: intro on the left, map on the
// right (half screen each), then the filterable organizations gallery.
import Layout from "@motiu/design/components/Layout.astro";
import SectionHeading from "@motiu/design/components/SectionHeading.astro";
import OrgMap from "../components/OrgMap.astro";
import OrgCard from "../components/OrgCard.astro";
import InterventionCard from "../components/InterventionCard.astro";
import { loadSiteData } from "../lib/data";
import { interventionOrgNames } from "../lib/records";
import { t, tv } from "../lib/i18n";
import type { Lang } from "../lib/i18n";

export interface Props {
    lang?: Lang;
}
const { lang = "es" } = Astro.props;

const { orgs, orgMap, interventions, dataError, dataSource } =
    await loadSiteData();

// Side panel: grupo de trabajo orgs only, each with its associated interventions.
const panelOrgs = orgs
    .filter((o) => o.grupoTrabajo)
    .map((o) => ({
        org: o,
        itvs: interventions.filter((i) => i.orgIds.includes(o.id)),
    }));

const grupoCount = orgs.filter((o) => o.grupoTrabajo).length;
const restoCount = orgs.length - grupoCount;
const tipos = [...new Set(orgs.flatMap((o) => o.tipos))].sort((a, b) =>
    a.localeCompare(b, "es"),
);
---

<Layout
    title={t(lang, "orgs.title")}
    description={t(lang, "orgs.description")}
    current="organizaciones"
    lang={lang}
>
    <section class="landing">
        <div class="landing__intro">
            <h1 class="display landing__title">
                {t(lang, "orgs.h1a")}
                <br />
                {t(lang, "orgs.h1b")}
            </h1>
            <p class="lede landing__lede">{t(lang, "orgs.lede")}</p>
        </div>
        <div class="landing__map">
            <OrgMap orgs={orgs} lang={lang} />
        </div>
    </section>

    {dataError && (
        <div class="container">
            <div class="data-banner" role="alert">
                <strong>{t(lang, "banner.error")}</strong> {dataError}
            </div>
        </div>
    )}
    {!dataError && dataSource === "fixture" && (
        <div class="container">
            <div class="data-banner data-banner--fixture">
                <strong>{t(lang, "banner.fixture")}</strong>
                {t(lang, "banner.fixtureText")}
            </div>
        </div>
    )}

    <section class="section" id="organizaciones">
        <div class="container">
            <SectionHeading
                eyebrow={t(lang, "orgs.overline")}
                title={t(lang, "orgs.heading")}
                intro={t(lang, "orgs.intro", { n: orgs.length, g: grupoCount })}
            />

            <div class="filter-bar" data-filter-bar>
                <div class="chip-group">
                    <button class="chip is-active" data-key="grupo" data-value="">
                        {t(lang, "filter.all")}
                    </button>
                    <button class="chip" data-key="grupo" data-value="grupo">
                        {t(lang, "filter.group", { n: grupoCount })}
                    </button>
                    <button class="chip" data-key="grupo" data-value="resto">
                        {t(lang, "filter.rest", { n: restoCount })}
                    </button>
                </div>
                {tipos.length > 0 && (
                    <label class="filter-select">
                        <span class="filter-bar__label">{t(lang, "filter.type")}</span>
                        <select class="select" data-key="tipo" aria-label={t(lang, "filter.byType")}>
                            <option value="">{t(lang, "filter.allTypes")}</option>
                            {tipos.map((x) => (
                                <option value={x.toLowerCase()}>{tv(lang, x)}</option>
                            ))}
                        </select>
                    </label>
                )}
                <span class="filter-bar__count" data-visible-count>
                    {t(lang, "filter.shown", { n: orgs.length })}
                </span>
            </div>

            {orgs.length > 0 ? (
                <div class="org-grid">
                    {orgs.map((org) => (
                        <OrgCard org={org} lang={lang} />
                    ))}
                </div>
            ) : (
                <p class="empty-note">
                    {t(lang, "orgs.none")}
                </p>
            )}
            <p class="empty-note" data-empty hidden>
                {t(lang, "orgs.noMatch")}
            </p>
        </div>
    </section>

    <!-- ============ SIDE PANEL: grupo de trabajo organization detail ============ -->
    <div class="org-panel" id="org-panel" hidden>
        <div class="org-panel__overlay" data-close-panel></div>
        <aside
            class="org-panel__sheet"
            role="dialog"
            aria-modal="true"
            aria-label={t(lang, "panel.label")}
        >
            <button
                type="button"
                class="org-panel__close"
                data-close-panel
                aria-label={t(lang, "panel.close")}
            >
                ✕
            </button>
            {panelOrgs.map(({ org, itvs }) => (
                <section class="org-panel__body" data-panel-org={org.id} hidden>
                    <Badge tone="flow" size="sm">{t(lang, "org.group")}</Badge>
                    <CardTitle level={2} size="lg">{org.name}</CardTitle>
                    {org.tipos.length > 0 && (
                        <CardBadges>
                            {org.tipos.map((x) => <Badge shape="square" size="sm">{tv(lang, x)}</Badge>)}
                        </CardBadges>
                    )}
                    {org.description && <CardText>{org.description}</CardText>}
                    {org.website && (
                        <CardLink href={org.website} external rel="noopener noreferrer">
                            {t(lang, "org.website")}
                        </CardLink>
                    )}

                    <h3 class="org-panel__subtitle">
                        {t(lang, "panel.itvs", { n: itvs.length })}
                    </h3>
                    {itvs.length > 0 ? (
                        <div class="org-panel__itvs">
                            {itvs.map((itv) => (
                                <InterventionCard
                                    intervention={itv}
                                    orgNames={interventionOrgNames(itv, orgMap)}
                                    filterable={false}
                                    showOrg={false}
                                    lang={lang}
                                />
                            ))}
                        </div>
                    ) : (
                        <p class="empty-note">
                            {t(lang, "panel.none")}
                        </p>
                    )}
                </section>
            ))}
        </aside>
    </div>
</Layout>

<script>
    import { initGalleryFilters } from "../scripts/gallery-filter";
    initGalleryFilters();

    // Side panel
    const panel = document.getElementById("org-panel")!;
    const sheet = panel.querySelector<HTMLElement>(".org-panel__sheet")!;
    let lastTrigger: HTMLElement | null = null;

    const openPanel = (orgId: string, trigger: HTMLElement) => {
        panel
            .querySelectorAll<HTMLElement>("[data-panel-org]")
            .forEach((s) => (s.hidden = s.dataset.panelOrg !== orgId));
        lastTrigger = trigger;
        panel.hidden = false;
        document.body.style.overflow = "hidden";
        sheet.scrollTop = 0;
        requestAnimationFrame(() => panel.classList.add("is-open"));
        panel.querySelector<HTMLElement>(".org-panel__close")?.focus();
    };

    const closePanel = () => {
        if (panel.hidden) return;
        panel.classList.remove("is-open");
        document.body.style.overflow = "";
        setTimeout(() => (panel.hidden = true), 220);
        lastTrigger?.focus();
    };

    document
        .querySelectorAll<HTMLElement>("[data-open-org]")
        .forEach((btn) =>
            btn.addEventListener("click", () =>
                openPanel(btn.dataset.openOrg!, btn),
            ),
        );
    panel
        .querySelectorAll("[data-close-panel]")
        .forEach((el) => el.addEventListener("click", closePanel));
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closePanel();
    });
</script>

<style>
    /* ============ landing: intro (left) + map (right), half each ============ */
    .landing {
        display: grid;
        grid-template-columns: 1fr 1fr;
        height: calc(100vh - var(--nav-h, 4rem));
        min-height: 560px;
        border-bottom: 1px solid var(--border-subtle);
        background: var(--bg);
    }

    .landing__intro {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: var(--space-6);
        padding: var(--space-12) var(--space-12) var(--space-12)
            max(var(--gutter), calc((100vw - 1280px) / 2));
    }

    .landing__title {
        font-size: clamp(3rem, 6.5vw, 5.25rem);
        color: var(--text-primary);
    }

    .landing__map {
        min-height: 0;
        border-left: 1px solid var(--border-default);
    }

    @media (max-width: 900px) {
        .landing {
            grid-template-columns: 1fr;
            grid-template-rows: auto 70vh;
            height: auto;
        }
        .landing__intro {
            padding: var(--space-12) var(--gutter) var(--space-8);
        }
        .landing__map {
            border-left: 0;
            border-top: 1px solid var(--border-default);
        }
    }

    /* ============ side panel ============ */
    .org-panel {
        position: fixed;
        inset: 0;
        z-index: 100;
    }

    .org-panel[hidden] {
        display: none;
    }

    .org-panel__overlay {
        position: absolute;
        inset: 0;
        background: rgba(34, 26, 18, 0.4);
        opacity: 0;
        transition: opacity 200ms ease;
    }

    .org-panel__sheet {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        width: min(560px, 100vw);
        overflow-y: auto;
        background: var(--bg);
        border-left: 1px solid var(--border-default);
        padding: var(--space-16) var(--space-8) var(--space-12);
        transform: translateX(100%);
        transition: transform 220ms ease;
    }

    .org-panel.is-open .org-panel__overlay {
        opacity: 1;
    }

    .org-panel.is-open .org-panel__sheet {
        transform: none;
    }

    .org-panel__close {
        position: absolute;
        top: var(--space-4);
        right: var(--space-4);
        width: var(--control-h);
        height: var(--control-h);
        border-radius: var(--radius-card);
        border: 1px solid var(--border-default);
        background: var(--bg);
        color: var(--text-primary);
        font-size: 1rem;
        cursor: pointer;
    }

    .org-panel__close:hover {
        background: var(--text-primary);
        color: var(--bg);
    }

    .org-panel__body {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-4);
    }

    .org-panel__body[hidden] {
        display: none;
    }

    .org-panel__subtitle {
        align-self: stretch;
        margin-top: var(--space-6);
        padding-top: var(--space-5);
        border-top: 1px solid var(--border-default);
        font-family: var(--mono);
        font-weight: 400;
        font-size: var(--text-xs);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
    }

    .org-panel__itvs {
        align-self: stretch;
        display: grid;
        gap: var(--space-4);
    }

    /* ============ sections ============ */
    .section {
        padding: var(--space-20) 0;
        scroll-margin-top: 4.5rem;
    }

    /* ============ filter bars ============ */
    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2);
        margin-bottom: var(--space-6);
    }

    .filter-select {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        margin-left: var(--space-3);
    }

    .filter-select select {
        max-width: 18rem;
    }

    .filter-bar__label {
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
    }

    .filter-bar__count {
        margin-left: auto;
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
        white-space: nowrap;
    }

    .org-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: var(--space-5);
    }

    .empty-note {
        font-family: var(--mono);
        font-size: var(--text-sm);
        color: var(--text-muted);
        border: 1px dashed var(--border-subtle);
        padding: var(--space-6);
        text-align: center;
    }

    .data-banner {
        margin-top: var(--space-6);
        padding: var(--space-4) var(--space-5);
        border: 1px solid color-mix(in srgb, var(--status-danger-mid) 45%, transparent);
        background: color-mix(in srgb, var(--status-danger-mid) 7%, var(--bg));
        font-size: var(--text-sm);
        line-height: 1.55;
    }

    .data-banner code {
        font-family: var(--mono);
        background: var(--surface-1);
        padding: 0.05rem 0.3rem;
    }

    .data-banner--fixture {
        border-color: var(--border-default);
        background: color-mix(in srgb, var(--pillar-flow-2) 14%, var(--bg));
    }
</style>
