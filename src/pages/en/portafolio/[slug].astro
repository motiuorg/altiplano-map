---
import Page from "../../../views/AreaPage.astro";
import { loadSiteData } from "../../../lib/data";
import { buildAreaViews } from "../../../lib/portfolio";

export async function getStaticPaths() {
    const { interventions } = await loadSiteData();
    return buildAreaViews(interventions).map((v) => ({ params: { slug: v.slug } }));
}
const { slug } = Astro.params;
---
<Page lang="en" slug={slug!} />
