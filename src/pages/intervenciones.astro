---
// The old address of the interventions page, kept so existing links still land on the portfolio.
const to = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/portafolio/#intervenciones`;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Portafolio</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
  </head>
  <body><a href={to}>Portafolio</a></body>
</html>
