---
// Intervenciones — filterable portfolio with a cards/table switcher.
import Layout from "../components/Layout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import InterventionCard from "../components/InterventionCard.astro";
import { loadSiteData } from "../lib/data";
import { formatValor, formatEuro, interventionOrgNames } from "../lib/records";

const { orgMap, interventions, dataError, dataSource } = await loadSiteData();

const collator = new Intl.Collator("es");
const areas = [...new Set(interventions.flatMap((i) => i.areaTrabajo))].sort(
    collator.compare,
);
const orgOptions = [...new Set(interventions.flatMap((i) => i.orgIds))]
    .map((id) => ({ id, name: orgMap.get(id)?.name }))
    .filter((o): o is { id: string; name: string } => !!o.name)
    .sort((a, b) => collator.compare(a.name, b.name));

// Financing slider: min..max of the figures present, on a "nice" step.
const fins = interventions
    .map((i) => i.financiacion)
    .filter((n): n is number => n !== null);
const hasFin = fins.length > 0;
const finMin = hasFin ? Math.min(...fins) : 0;
const finMax = hasFin ? Math.max(...fins) : 0;
const span = Math.max(finMax - finMin, 1);
const step = Math.max(1, Math.pow(10, Math.floor(Math.log10(span)) - 2));
const sliderMin = Math.floor(finMin / step) * step;
const sliderMax = Math.ceil(finMax / step) * step;

const viableText = (v: boolean | null) =>
    v === null ? "—" : v ? "Sí" : "No";
---

<Layout
    title="Altiplano Estepario — Intervenciones"
    description="Portfolio de intervenciones del paisaje del Altiplano Estepario."
    current="intervenciones"
>
    <section class="section">
        <div class="container">
            <SectionHeading
                overline="El portfolio"
                title="Intervenciones"
                intro="Proyectos e intervenciones del paisaje, con su valor ajustado a 5 años, su financiación y su viabilidad comercial."
            />

            {dataError && (
                <div class="data-banner" role="alert">
                    <strong>⚠ Datos no disponibles.</strong> {dataError}
                </div>
            )}
            {!dataError && dataSource === "fixture" && (
                <div class="data-banner data-banner--fixture">
                    <strong>Modo fixture.</strong> Dataset de desarrollo, no los
                    datos reales.
                </div>
            )}

            <div class="filter-bar" data-filter-bar>
                <label class="filter-select">
                    <span class="filter-bar__label">Área de trabajo</span>
                    <select data-key="area" aria-label="Filtrar por área de trabajo">
                        <option value="">Todas</option>
                        {areas.map((a) => (
                            <option value={a.toLowerCase()}>{a}</option>
                        ))}
                    </select>
                </label>
                <label class="filter-select">
                    <span class="filter-bar__label">Viabilidad comercial</span>
                    <select data-key="viable" aria-label="Filtrar por viabilidad comercial">
                        <option value="">Todas</option>
                        <option value="si">Viable</option>
                        <option value="no">No viable</option>
                    </select>
                </label>
                <label class="filter-select">
                    <span class="filter-bar__label">Organización</span>
                    <select data-key="org" aria-label="Filtrar por organización">
                        <option value="">Todas</option>
                        {orgOptions.map((o) => (
                            <option value={o.id}>{o.name}</option>
                        ))}
                    </select>
                </label>

                {hasFin && sliderMax > sliderMin && (
                    <div class="range" data-range="fin">
                        <span class="filter-bar__label">Financiación total</span>
                        <div class="range__row">
                        <div class="range__control">
                            <div class="range__track"></div>
                            <div class="range__fill" data-range-fill></div>
                            <input
                                type="range"
                                data-range-lo
                                min={sliderMin}
                                max={sliderMax}
                                step={step}
                                value={sliderMin}
                                aria-label="Financiación mínima"
                            />
                            <input
                                type="range"
                                data-range-hi
                                min={sliderMin}
                                max={sliderMax}
                                step={step}
                                value={sliderMax}
                                aria-label="Financiación máxima"
                            />
                        </div>
                        <span class="range__out" data-range-out></span>
                        </div>
                    </div>
                )}
            </div>

            <div class="view-bar">
                <span class="filter-bar__count" data-visible-count>
                    {interventions.length} mostradas
                </span>
                <div class="view-switch" role="group" aria-label="Vista">
                    <button class="chip is-active" data-view="cards">
                        Tarjetas
                    </button>
                    <button class="chip" data-view="table">Tabla</button>
                </div>
            </div>

            {interventions.length > 0 ? (
                <>
                    <div class="itv-grid" data-view-panel="cards">
                        {interventions.map((itv) => (
                            <InterventionCard
                                intervention={itv}
                                orgNames={interventionOrgNames(itv, orgMap)}
                            />
                        ))}
                    </div>

                    <div class="itv-table-wrap" data-view-panel="table" hidden>
                        <table class="itv-table">
                            <thead>
                                <tr>
                                    <th>Intervención</th>
                                    <th>Organización(es)</th>
                                    <th>Área de trabajo</th>
                                    <th class="num">Valor 5 años</th>
                                    <th class="num">Financiación total</th>
                                    <th class="num">Años</th>
                                    <th>Recurrente</th>
                                    <th>Capital 1</th>
                                    <th>Capital 2</th>
                                    <th>Viable</th>
                                </tr>
                            </thead>
                            <tbody>
                                {interventions.map((itv) => (
                                    <tr
                                        data-filterable
                                        data-item-id={itv.id}
                                        data-area={itv.areaTrabajo
                                            .map((a) => a.toLowerCase())
                                            .join("|")}
                                        data-viable={
                                            itv.viable === null
                                                ? "unknown"
                                                : itv.viable
                                                  ? "si"
                                                  : "no"
                                        }
                                        data-org={itv.orgIds.join("|")}
                                        data-fin={itv.financiacion ?? ""}
                                    >
                                        <th scope="row">{itv.name}</th>
                                        <td>
                                            {interventionOrgNames(itv, orgMap).join(", ") || "—"}
                                        </td>
                                        <td>{itv.areaTrabajo.join(", ") || "—"}</td>
                                        <td class="num">
                                            {formatValor(itv.valor5Anos, itv.valor5AnosRaw)}
                                        </td>
                                        <td class="num">{formatEuro(itv.financiacion)}</td>
                                        <td class="num">{itv.anos ?? "—"}</td>
                                        <td>{viableText(itv.recurrente)}</td>
                                        <td>{itv.capital1 || "—"}</td>
                                        <td>{itv.capital2 || "—"}</td>
                                        <td>{viableText(itv.viable)}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </>
            ) : (
                <p class="empty-note">No hay intervenciones publicadas todavía.</p>
            )}
            <p class="empty-note" data-empty hidden>
                Ninguna intervención coincide con el filtro.
            </p>
        </div>
    </section>
</Layout>

<script>
    import { initGalleryFilters } from "../scripts/gallery-filter";
    initGalleryFilters();

    // Cards / table switcher
    const buttons = document.querySelectorAll<HTMLElement>("[data-view]");
    buttons.forEach((btn) =>
        btn.addEventListener("click", () => {
            const view = btn.dataset.view;
            buttons.forEach((b) => b.classList.toggle("is-active", b === btn));
            document
                .querySelectorAll<HTMLElement>("[data-view-panel]")
                .forEach((p) => (p.hidden = p.dataset.viewPanel !== view));
        }),
    );
</script>

<style>
    .section {
        padding: var(--space-16) 0 var(--space-20);
    }

    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: var(--space-4) var(--space-6);
        margin-bottom: var(--space-4);
    }

    .filter-select {
        display: inline-flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .filter-select select {
        font-family: var(--mono);
        font-size: var(--text-xs);
        padding: 0.45rem 0.6rem;
        background: var(--bg);
        color: var(--fg);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        min-width: 11rem;
        max-width: 18rem;
    }

    .filter-bar__label {
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
    }

    .filter-bar__count {
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--muted);
        white-space: nowrap;
    }

    /* dual-handle slider */
    .range {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        min-width: 16rem;
    }

    .range__row {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        height: 2rem; /* same height as the select boxes beside it */
    }

    .range__control {
        position: relative;
        height: 1.6rem;
        width: 11rem;
    }

    .range__track,
    .range__fill {
        position: absolute;
        top: 50%;
        height: 4px;
        transform: translateY(-50%);
    }

    .range__track {
        left: 0;
        right: 0;
        background: var(--border-subtle);
    }

    .range__fill {
        background: var(--pillar-flow-3);
    }

    .range__control input[type="range"] {
        position: absolute;
        inset: 0;
        width: 100%;
        margin: 0;
        background: none;
        pointer-events: none;
        -webkit-appearance: none;
        appearance: none;
    }

    .range__control input[type="range"]::-webkit-slider-runnable-track {
        background: none;
    }

    .range__control input[type="range"]::-moz-range-track {
        background: none;
    }

    .range__control input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        pointer-events: auto;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: var(--fg);
        border: 2px solid var(--paper);
        cursor: grab;
    }

    .range__control input[type="range"]::-moz-range-thumb {
        pointer-events: auto;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--fg);
        border: 2px solid var(--paper);
        cursor: grab;
    }

    .range__out {
        font-family: var(--mono);
        font-size: var(--text-xs);
        color: var(--fg);
    }

    .view-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        margin-bottom: var(--space-5);
        padding-top: var(--space-3);
        border-top: 1px solid var(--border-subtle);
    }

    .view-switch {
        display: inline-flex;
        gap: var(--space-2);
    }

    .itv-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: var(--space-5);
    }

    .itv-grid[hidden],
    .itv-table-wrap[hidden] {
        display: none;
    }

    .itv-table-wrap {
        overflow-x: auto;
        border: 1px solid var(--border-subtle);
    }

    .itv-table {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--text-sm);
    }

    .itv-table th,
    .itv-table td {
        padding: 0.65rem 0.8rem;
        text-align: left;
        vertical-align: top;
        border-bottom: 1px solid var(--border-subtle);
    }

    .itv-table thead th {
        position: sticky;
        top: 0;
        background: var(--surface-1);
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: var(--muted);
        white-space: nowrap;
    }

    .itv-table tbody th {
        font-family: var(--serif);
        font-weight: 400;
        min-width: 14rem;
    }

    .itv-table .num {
        text-align: right;
        font-family: var(--mono);
        white-space: nowrap;
    }

    .itv-table tbody tr:hover {
        background: var(--surface-1);
    }

    .empty-note {
        font-family: var(--mono);
        font-size: var(--text-sm);
        color: var(--muted);
        border: 1px dashed var(--border-subtle);
        padding: var(--space-6);
        text-align: center;
    }

    .data-banner {
        margin-bottom: var(--space-6);
        padding: var(--space-4) var(--space-5);
        border: 1px solid color-mix(in srgb, var(--danger-mid) 45%, transparent);
        background: color-mix(in srgb, var(--danger-mid) 7%, var(--bg));
        font-size: var(--text-sm);
    }

    .data-banner--fixture {
        border-color: var(--border);
        background: color-mix(in srgb, var(--pillar-flow-2) 14%, var(--bg));
    }
</style>
