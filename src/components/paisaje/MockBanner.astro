---
export interface Props {
    variant?: "bar" | "tag";
}
const { variant = "tag" } = Astro.props;
---

<span class={`pmock pmock--${variant}`}>Maqueta — datos y informes ficticios</span>

<style is:global>
    .pmock {
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #6b3a00;
        background: #fff1d6;
        border: 1px dashed #b86a00;
        padding: 0.2rem 0.5rem;
        display: inline-block;
    }
    .pmock--bar {
        display: block;
        text-align: center;
        font-size: var(--text-xs);
        padding: 0.45rem var(--space-4);
        border-width: 0 0 1px;
    }
</style>
