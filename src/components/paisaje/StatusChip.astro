---
// Status chip: text + icon (never colour alone). Shapes differ per status.
import { STATUS_META } from "../../lib/paisaje/data";
import type { Status } from "../../lib/paisaje/schema";

export interface Props {
    status: Status;
    size?: "sm" | "md";
}
const { status, size = "md" } = Astro.props;
const meta = STATUS_META[status];
---

<span class={`pstatus pstatus--${status} pstatus--${size}`}>
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
        {meta.icon === "triangle" && (
            <>
                <path d="M8 1.5 15 14H1z" fill="currentColor" />
                <path d="M8 6v4M8 11.6v.8" stroke="var(--pa-chip-bg)" stroke-width="1.6" stroke-linecap="round" />
            </>
        )}
        {meta.icon === "diamond" && <path d="M8 1.5 14.5 8 8 14.5 1.5 8z" fill="currentColor" />}
        {meta.icon === "half" && (
            <>
                <circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.6" />
                <path d="M8 2a6 6 0 0 1 0 12z" fill="currentColor" />
            </>
        )}
        {meta.icon === "arrow-up" && <path d="M8 1.5 14 8h-3.8v6.5H5.8V8H2z" fill="currentColor" />}
        {meta.icon === "dashed" && <circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-dasharray="2.6 2.2" />}
    </svg>
    {meta.label}
</span>

<style is:global>
    .pstatus {
        --pa-chip-bg: var(--paper);
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 0.25rem 0.6rem;
        border: 1.5px solid currentColor;
        background: var(--pa-chip-bg);
        white-space: nowrap;
        line-height: 1.2;
    }
    .pstatus--md { font-size: var(--text-xs); padding: 0.3rem 0.7rem; }
    .pstatus--critico { color: #a30000; }
    .pstatus--bajo_presion { color: #a8470a; }
    .pstatus--mixto { color: #4a4440; }
    .pstatus--mejorando { color: #00589a; }
    .pstatus--proximamente { color: var(--muted); border-style: dashed; }
</style>
