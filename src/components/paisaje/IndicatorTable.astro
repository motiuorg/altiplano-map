---
import type { Indicator } from "../../lib/paisaje/schema";
import { AVAIL_META, fmtVal, sourceNumber } from "../../lib/paisaje/data";
import StatusChip from "./StatusChip.astro";

export interface Props {
    indicators: Indicator[];
}
const { indicators } = Astro.props;
const yv = (v: any, unit: string) => (v ? `${fmtVal(v, unit)} (${v.year})` : "—");
---

<div class="ptable-wrap pind">
    <table>
        <caption class="sr-only">Indicadores que vamos a medir</caption>
        <thead>
            <tr>
                <th scope="col">Indicador</th>
                <th scope="col">Referencia</th>
                <th scope="col">Último dato</th>
                <th scope="col">Objetivo</th>
                <th scope="col">Fuente</th>
                <th scope="col">Disponibilidad</th>
                <th scope="col">Estado</th>
            </tr>
        </thead>
        <tbody>
            {indicators.map((i) => (
                <tr class={`pind__row pind__row--${i.availability}`}>
                    <th scope="row">
                        {i.label}
                        <small>{i.scope}</small>
                    </th>
                    <td>{yv(i.baseline, i.unit)}</td>
                    <td>{yv(i.latest, i.unit)}</td>
                    <td>{yv(i.target, i.unit)}</td>
                    <td><a href={`#ev-${i.sourceId}`}>[{sourceNumber(i.sourceId)}]</a></td>
                    <td>
                        <span class={`pavail pavail--${i.availability}`}>
                            <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false">
                                {i.availability === "disponible" && <path d="M2 6.5 5 9.5 10.5 3" fill="none" stroke="currentColor" stroke-width="1.8" />}
                                {i.availability === "pendiente" && <><circle cx="6" cy="6" r="4.6" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M6 3.2V6l2 1.2" fill="none" stroke="currentColor" stroke-width="1.5" /></>}
                                {i.availability === "no_disponible" && <path d="M2.5 2.5l7 7M9.5 2.5l-7 7" stroke="currentColor" stroke-width="1.8" />}
                            </svg>
                            {AVAIL_META[i.availability].label}
                        </span>
                    </td>
                    <td>
                        {i.availability === "disponible" ? <StatusChip status={i.status} size="sm" /> : <span class="pind__nostatus">Sin evaluar</span>}
                    </td>
                </tr>
            ))}
        </tbody>
    </table>
</div>

<style is:global>
    .pind table { border-collapse: collapse; width: 100%; font-size: var(--text-sm); min-width: 46rem; }
    .pind th, .pind td { padding: 0.65rem 0.75rem; text-align: left; vertical-align: top; border-bottom: 1px solid var(--border-subtle); }
    .pind thead th { font-family: var(--mono); font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.07em; color: var(--muted); font-weight: 400; background: var(--surface-1); white-space: nowrap; }
    .pind tbody th { font-weight: 400; }
    .pind th small { display: block; font-size: var(--text-xs); color: var(--muted); margin-top: 2px; }
    .pind__row--pendiente td, .pind__row--no_disponible td { background: repeating-linear-gradient(135deg, transparent 0 8px, color-mix(in srgb, var(--rule) 7%, transparent) 8px 9px); }
    .pavail { display: inline-flex; align-items: center; gap: 0.4rem; font-family: var(--mono); font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.04em; }
    .pavail--disponible { color: #00589a; }
    .pavail--pendiente { color: #8a5a00; }
    .pavail--no_disponible { color: #7a2300; }
    .pind__nostatus { font-family: var(--mono); font-size: var(--text-2xs); text-transform: uppercase; color: var(--muted); }
</style>
