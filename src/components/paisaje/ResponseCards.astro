---
// "Qué se está haciendo": real interventions (existing card) + organizations,
// plus clearly-labelled placeholders when the real name is not in the data.
import InterventionCard from "../InterventionCard.astro";
import type { ThemeResponse } from "../../lib/paisaje/data";

export interface Props {
    response: ThemeResponse;
    orgNames: Map<string, string[]>;
}
const { response, orgNames } = Astro.props;
const empty = response.interventions.length + response.orgs.length + response.placeholders.length === 0;
---

<div class="presp">
    {response.interventions.length > 0 && (
        <div>
            <h5 class="presp__sub">Intervenciones</h5>
            <div class="presp__grid">
                {response.interventions.slice(0, 4).map((itv) => (
                    <InterventionCard intervention={itv} orgNames={orgNames.get(itv.id) ?? []} filterable={false} lang="es" />
                ))}
            </div>
        </div>
    )}
    {response.orgs.length > 0 && (
        <div>
            <h5 class="presp__sub">Organizaciones que participan</h5>
            <ul class="presp__orgs">
                {response.orgs.slice(0, 8).map((o) => (
                    <li class="presp__org">
                        <strong>{o.name}</strong>
                        {o.placeName && <span>{o.placeName}</span>}
                        {o.grupoTrabajo && <span class="badge badge--flow">Grupo de trabajo</span>}
                    </li>
                ))}
            </ul>
        </div>
    )}
    {response.placeholders.length > 0 && (
        <div>
            <h5 class="presp__sub">Ejemplos de iniciativas (marcador de posición)</h5>
            <div class="presp__grid">
                {response.placeholders.map((p) => (
                    <article class="presp__ph">
                        <span class="presp__tag">Ejemplo · {p.kind}</span>
                        <h6>{p.name}</h6>
                        <p>Área: {p.area}. Nombre tomado del guion de la maqueta; no figura en los datos del sitio.</p>
                    </article>
                ))}
            </div>
        </div>
    )}
    {empty && <p class="presp__empty">Aún no hay intervenciones asignadas a este tema.</p>}
    <p class="presp__caveat">Estas iniciativas <em>buscan contribuir</em> a mejorar la situación descrita; no se afirma una relación causal con los datos de arriba.</p>
</div>

<style is:global>
    .presp { display: grid; gap: var(--space-5); }
    .presp__sub { font-family: var(--mono); font-weight: 400; font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: var(--space-3); }
    .presp__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); gap: var(--space-4); }
    .presp__orgs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr)); gap: var(--space-3); }
    .presp__org { border: 1px solid var(--border-subtle); padding: var(--space-3) var(--space-4); display: flex; flex-direction: column; gap: var(--space-1); align-items: flex-start; font-size: var(--text-sm); }
    .presp__org span:not(.badge) { color: var(--muted); font-size: var(--text-xs); font-family: var(--mono); }
    .presp__ph { border: 1.5px dashed var(--border); padding: var(--space-4); background: var(--surface-1); display: grid; gap: var(--space-2); }
    .presp__ph h6 { font-family: var(--serif); font-weight: 400; font-size: var(--text-md); }
    .presp__ph p { font-size: var(--text-xs); color: var(--muted); }
    .presp__tag { font-family: var(--mono); font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.06em; color: #6b3a00; }
    .presp__caveat, .presp__empty { font-size: var(--text-sm); color: var(--muted); border-left: 2px solid var(--border); padding-left: var(--space-4); }
</style>
