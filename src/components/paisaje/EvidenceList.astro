---
import type { Source } from "../../lib/paisaje/schema";
import { SOURCE_TYPE_LABEL, sourceNumber } from "../../lib/paisaje/data";
import ConfidenceBadge from "./ConfidenceBadge.astro";

export interface Props {
    sources: Source[];
    idPrefix?: string;
}
const { sources, idPrefix = "ev-" } = Astro.props;
---

<ol class="pev">
    {sources.map((s) => (
        <li class="pev__item" id={`${idPrefix}${s.id}`}>
            <div class="pev__top">
                <span class="pev__num">[{sourceNumber(s.id)}]</span>
                <span class="pev__type">{SOURCE_TYPE_LABEL[s.type]}</span>
                <ConfidenceBadge level={s.confidence} />
            </div>
            <p class="pev__title"><a href={s.url}>{s.title}</a></p>
            <p class="pev__meta">
                {s.publisher} · {s.year} · Licencia: {s.licence} · Consultado: {s.retrieved}
            </p>
            <p class="pev__meta">Verificación: {s.verifiedBy}</p>
        </li>
    ))}
</ol>

<style is:global>
    .pev { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
    .pev__item { border: 1px solid var(--border-subtle); padding: var(--space-4); background: var(--bg); scroll-margin-top: 8rem; }
    .pev__item:target { outline: 3px solid var(--pillar-flow-3); outline-offset: 2px; }
    .pev__top { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); align-items: center; margin-bottom: var(--space-2); }
    .pev__num { font-family: var(--mono); font-size: var(--text-xs); font-weight: 600; }
    .pev__type { font-family: var(--mono); font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
    .pev__title { font-family: var(--serif); font-size: var(--text-base); line-height: 1.25; }
    .pev__meta { font-size: var(--text-xs); color: var(--muted); margin-top: 2px; }
</style>
