---
// One figure component, four chart types, all inline SVG generated at build
// time. Every chart has: title, "maqueta" tag, scope/source/year caption and a
// data table (details) as text alternative.
import type { Chart } from "../../lib/paisaje/schema";
import { indicatorById, sourceById, sourceNumber, fmtNum } from "../../lib/paisaje/data";
import { niceTicks, linear, polyline } from "../../lib/paisaje/charts";
import MockBanner from "./MockBanner.astro";

export interface Props {
    chart: Chart;
}
const { chart } = Astro.props;
const src = sourceById(chart.sourceId);
const W = 760;
const H = chart.type === "line" ? 290 : 0; // others compute their own

// ---- line
let line: any = null;
if (chart.type === "line") {
    const ind = indicatorById(chart.indicatorId)!;
    const ml = 52, mr = 150, mt = 18, mb = 32;
    const years = ind.series.map((s) => s.year);
    const vals = ind.series.map((s) => s.value);
    const all = [...vals, ...(ind.target ? [ind.target.value] : [])];
    const ticks = niceTicks(Math.min(...all), Math.max(...all), 5);
    const x = linear(Math.min(...years), Math.max(...years), ml, W - mr);
    const y = linear(ticks[0], ticks[ticks.length - 1], H - mb, mt);
    line = {
        ind, ml, mr, mt, mb, ticks, x, y,
        pts: ind.series.map((s) => [x(s.year), y(s.value)] as [number, number]),
        xTicks: years.filter((_, k) => k % Math.ceil(years.length / 6) === 0 || k === years.length - 1),
    };
}

// ---- stacked
const RAMP = ["#fde9cc", "#f5b778", "#e8590c", "#7a2300"];
const RAMP_TEXT = ["#221a12", "#221a12", "#ffffff", "#ffffff"];

// ---- refbar
const REF_MAX = chart.type === "refbar" ? Math.max(...chart.bars.map((b) => b.value)) * 1.15 : 0;

// ---- before/after
const BA_MAX = chart.type === "beforeafter" ? Math.max(...chart.categories.flatMap((c) => [c.before, c.after])) * 1.12 : 0;
---

<figure class="pfig" id={chart.id}>
    <div class="pfig__head">
        <h4 class="pfig__title">{chart.title}</h4>
        <MockBanner />
    </div>

    {chart.type === "line" && (
        <div class="pfig__scroll"><svg class="pfig__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${chart.title}. Datos en la tabla siguiente.`}>
            {line.ticks.map((t: number) => (
                <>
                    <line class="pg-grid" x1={line.ml} x2={W - line.mr} y1={line.y(t)} y2={line.y(t)} />
                    <text class="pg-tick" x={line.ml - 8} y={line.y(t) + 4} text-anchor="end">{fmtNum(t)}</text>
                </>
            ))}
            {line.xTicks.map((yr: number) => (
                <text class="pg-tick" x={line.x(yr)} y={H - 10} text-anchor="middle">{yr}</text>
            ))}
            {line.ind.target && (
                <>
                    <line class="pg-target" x1={line.ml} x2={W - line.mr} y1={line.y(line.ind.target.value)} y2={line.y(line.ind.target.value)} />
                    <text class="pg-lbl" x={W - line.mr + 6} y={line.y(line.ind.target.value) + 4}>Objetivo {line.ind.target.year}: {fmtNum(line.ind.target.value)}</text>
                </>
            )}
            <polyline class="pg-line" points={polyline(line.pts)} />
            {line.ind.series.map((s: any, k: number) => (
                <g class="pg-pt" tabindex="0" aria-label={`${s.year}: ${fmtNum(s.value)} ${chart.unit}`}>
                    <circle cx={line.pts[k][0]} cy={line.pts[k][1]} r="9" fill="transparent" />
                    <circle class="pg-dot" cx={line.pts[k][0]} cy={line.pts[k][1]} r="3.4" />
                    <g class="pg-tip" transform={`translate(${Math.min(line.pts[k][0], W - 140)},${Math.max(line.pts[k][1] - 40, 4)})`}>
                        <rect width="120" height="28" />
                        <text x="8" y="18">{s.year}: {fmtNum(s.value)} {chart.unit}</text>
                    </g>
                </g>
            ))}
            <text class="pg-lbl" x={line.pts[line.pts.length - 1][0] + 6} y={line.pts[line.pts.length - 1][1] + 4}>{fmtNum(line.ind.series[line.ind.series.length - 1].value)} {chart.unit}</text>
        </svg></div>
    )}

    {chart.type === "stacked" && (
        <>
            <ul class="pfig__legend">
                {chart.categories.map((c, k) => (
                    <li><i style={`background:${RAMP[k]}`}></i>{c.label}</li>
                ))}
            </ul>
            <div class="pfig__scroll"><svg class="pfig__svg" viewBox={`0 0 ${W} ${chart.rows.length * 46 + 14}`} role="img" aria-label={`${chart.title}. Datos en la tabla siguiente.`}>
                {chart.rows.map((r, ri) => {
                    const total = chart.categories.reduce((a, c) => a + r.values[c.id], 0);
                    let acc = 0;
                    return (
                        <g>
                            <text class="pg-lbl" x="0" y={ri * 46 + 26}>{r.label}</text>
                            {chart.categories.map((c, k) => {
                                const w = ((W - 170) * r.values[c.id]) / total;
                                const x = 160 + ((W - 170) * acc) / total;
                                acc += r.values[c.id];
                                return (
                                    <g>
                                        <rect x={x} y={ri * 46 + 8} width={w} height="28" fill={RAMP[k]} stroke="#fffdfb" stroke-width="1.5" />
                                        <text x={x + w / 2} y={ri * 46 + 27} text-anchor="middle" class="pg-seg" style={`fill:${RAMP_TEXT[k]}`}>{r.values[c.id]}</text>
                                    </g>
                                );
                            })}
                        </g>
                    );
                })}
            </svg></div>
        </>
    )}

    {chart.type === "refbar" && (
        <div class="pfig__scroll"><svg class="pfig__svg" viewBox={`0 0 ${W} ${chart.bars.length * 52 + 20}`} role="img" aria-label={`${chart.title}. Datos en la tabla siguiente.`}>
            <defs>
                <pattern id={`hatch-${chart.id}`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                    <rect width="7" height="7" fill="#f2ede4" />
                    <line x1="0" y1="0" x2="0" y2="7" stroke="#6b5a3e" stroke-width="2.4" />
                </pattern>
            </defs>
            {chart.bars.map((b, k) => {
                const w = ((W - 250) * b.value) / REF_MAX;
                return (
                    <g>
                        <text class="pg-lbl" x="0" y={k * 52 + 30}>{b.label}</text>
                        <rect
                            x="190" y={k * 52 + 10} width={w} height="32"
                            fill={b.kind === "value" ? "#0077c8" : b.kind === "reference" ? `url(#hatch-${chart.id})` : "#fffdfb"}
                            stroke={b.kind === "value" ? "#0077c8" : b.kind === "reference" ? "#6b5a3e" : "#221a12"}
                            stroke-width="1.6" stroke-dasharray={b.kind === "target" ? "6 4" : "none"}
                        />
                        <text class="pg-lbl" x={190 + w + 8} y={k * 52 + 31}>{fmtNum(b.value)} {chart.unit}</text>
                    </g>
                );
            })}
        </svg></div>
    )}

    {chart.type === "beforeafter" && (
        <>
            <ul class="pfig__legend">
                <li><i style="background:#b9b1a4"></i>{chart.beforeYear}</li>
                <li><i style="background:#0077c8"></i>{chart.afterYear}</li>
            </ul>
            <div class="pfig__scroll"><svg class="pfig__svg" viewBox={`0 0 ${W} ${chart.categories.length * 58 + 14}`} role="img" aria-label={`${chart.title}. Datos en la tabla siguiente.`}>
                {chart.categories.map((c, k) => {
                    const wb = ((W - 300) * c.before) / BA_MAX;
                    const wa = ((W - 300) * c.after) / BA_MAX;
                    const d = c.after - c.before;
                    return (
                        <g>
                            <text class="pg-lbl" x="0" y={k * 58 + 32}>{c.label}</text>
                            <rect x="170" y={k * 58 + 8} width={wb} height="19" fill="#b9b1a4" />
                            <text class="pg-seg-out" x={170 + wb + 6} y={k * 58 + 22}>{c.before} %</text>
                            <rect x="170" y={k * 58 + 29} width={wa} height="19" fill="#0077c8" />
                            <text class="pg-seg-out" x={170 + wa + 6} y={k * 58 + 43}>{c.after} %</text>
                            <text class="pg-delta" x={W} y={k * 58 + 32} text-anchor="end">{d > 0 ? "▲ +" : d < 0 ? "▼ " : "■ "}{d} pp</text>
                        </g>
                    );
                })}
            </svg></div>
        </>
    )}

    {chart.note && <p class="pfig__note">{chart.note}</p>}

    <figcaption class="pfig__cap">
        <span>Ámbito: {chart.scope}</span>
        <span>Fuente: <a href={`#ev-${src.id}`}>[{sourceNumber(src.id)}] {src.title}</a> ({src.year}, {src.publisher})</span>
    </figcaption>

    <details class="pfig__table">
        <summary>Ver los datos del gráfico</summary>
        <div class="ptable-wrap">
            <table>
                <caption class="sr-only">{chart.title}</caption>
                {chart.type === "line" && (
                    <>
                        <thead><tr><th scope="col">Año</th><th scope="col" class="num">{line.ind.label} ({chart.unit})</th></tr></thead>
                        <tbody>{line.ind.series.map((s: any) => <tr><th scope="row">{s.year}</th><td class="num">{fmtNum(s.value)}</td></tr>)}</tbody>
                    </>
                )}
                {chart.type === "stacked" && (
                    <>
                        <thead><tr><th scope="col">Zona</th>{chart.categories.map((c) => <th scope="col" class="num">{c.label} (%)</th>)}</tr></thead>
                        <tbody>{chart.rows.map((r) => <tr><th scope="row">{r.label}</th>{chart.categories.map((c) => <td class="num">{r.values[c.id]}</td>)}</tr>)}</tbody>
                    </>
                )}
                {chart.type === "refbar" && (
                    <>
                        <thead><tr><th scope="col">Referencia</th><th scope="col" class="num">Valor ({chart.unit})</th></tr></thead>
                        <tbody>{chart.bars.map((b) => <tr><th scope="row">{b.label}</th><td class="num">{fmtNum(b.value)}</td></tr>)}</tbody>
                    </>
                )}
                {chart.type === "beforeafter" && (
                    <>
                        <thead><tr><th scope="col">Uso</th><th scope="col" class="num">{chart.beforeYear} (%)</th><th scope="col" class="num">{chart.afterYear} (%)</th><th scope="col" class="num">Cambio (pp)</th></tr></thead>
                        <tbody>{chart.categories.map((c) => <tr><th scope="row">{c.label}</th><td class="num">{c.before}</td><td class="num">{c.after}</td><td class="num">{c.after - c.before}</td></tr>)}</tbody>
                    </>
                )}
            </table>
        </div>
    </details>
</figure>

<style is:global>
    .pfig { margin: 0; border: 1px solid var(--border-subtle); background: var(--bg); padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }
    .pfig__head { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-3); flex-wrap: wrap; }
    .pfig__title { font-family: var(--serif); font-weight: 400; font-size: var(--text-md); line-height: 1.2; flex: 1 1 14rem; }
    .pfig__scroll { overflow-x: auto; }
    .pfig__svg { width: 100%; min-width: 560px; height: auto; display: block; overflow: visible; }
    .pfig__svg text { font-family: var(--mono); font-size: 12px; fill: var(--fg); }
    .pg-grid { stroke: color-mix(in srgb, var(--rule) 20%, transparent); stroke-width: 1; }
    .pg-tick { fill: var(--muted) !important; font-size: 11px !important; }
    .pg-line { fill: none; stroke: #0077c8; stroke-width: 2.4; stroke-linejoin: round; }
    .pg-dot { fill: #0077c8; stroke: var(--paper); stroke-width: 1.5; }
    .pg-target { stroke: #221a12; stroke-width: 1.6; stroke-dasharray: 6 4; }
    .pg-seg { font-weight: 600; }
    .pg-delta { font-weight: 600; }
    .pg-pt { outline: none; }
    .pg-pt:focus .pg-dot, .pg-pt:hover .pg-dot { r: 6; stroke: var(--fg); stroke-width: 2; }
    .pg-tip { display: none; pointer-events: none; }
    .pg-tip rect { fill: var(--paper); stroke: var(--border); }
    .pg-pt:hover .pg-tip, .pg-pt:focus .pg-tip { display: block; }
    .pfig__legend { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); list-style: none; margin: 0; padding: 0; font-family: var(--mono); font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
    .pfig__legend i { display: inline-block; width: 12px; height: 12px; margin-right: 6px; vertical-align: -2px; border: 1px solid var(--border); }
    .pfig__note { font-size: var(--text-xs); color: var(--muted); }
    .pfig__cap { display: grid; gap: 2px; font-size: var(--text-xs); color: var(--muted); border-top: 1px solid var(--border-subtle); padding-top: var(--space-3); }
    .pfig__table summary { cursor: pointer; font-family: var(--mono); font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.07em; }
    .ptable-wrap { overflow-x: auto; margin-top: var(--space-2); }
    .ptable-wrap table { border-collapse: collapse; width: 100%; font-size: var(--text-xs); }
    .ptable-wrap th, .ptable-wrap td { padding: 0.4rem 0.6rem; border-bottom: 1px solid var(--border-subtle); text-align: left; }
    .ptable-wrap .num { text-align: right; font-family: var(--mono); }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
