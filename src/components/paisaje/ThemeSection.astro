---
// The reusable theme template: verdict → what the data say → why it matters →
// what is being done → what we will measure → what we don't know → evidence.
import type { Theme } from "../../lib/paisaje/schema";
import { indicatorsOf, indicatorById, chartsOf, sourcesOfTheme, sourceNumber } from "../../lib/paisaje/data";
import type { ThemeResponse } from "../../lib/paisaje/data";
import StatusChip from "./StatusChip.astro";
import StatTile from "./StatTile.astro";
import ChartFigure from "./ChartFigure.astro";
import ResponseCards from "./ResponseCards.astro";
import IndicatorTable from "./IndicatorTable.astro";
import EvidenceList from "./EvidenceList.astro";

export interface Props {
    theme: Theme;
    response: ThemeResponse;
    orgNames: Map<string, string[]>;
    index: number;
}
const { theme, response, orgNames, index } = Astro.props;
const stub = theme.status === "proximamente";
const stats = theme.statIndicatorIds.map((id) => indicatorById(id)!).filter(Boolean);
const charts = chartsOf(theme.id);
---

<section class={`ptheme ${stub ? "ptheme--stub" : ""}`} id={`tema-${theme.id}`} data-theme-id={theme.id} aria-labelledby={`h-${theme.id}`}>
    {stub ? (
        <details class="ptheme__stub">
            <summary>
                <span class="ptheme__num">{String(index + 1).padStart(2, "0")}</span>
                <h3 id={`h-${theme.id}`}>{theme.label}</h3>
                <StatusChip status="proximamente" size="sm" />
            </summary>
            <p>{theme.summary}</p>
            <p class="ptheme__stubnote">Este tema se añadirá cuando haya fuentes verificadas. Sirve para comprobar cómo encajan más temas en la maqueta.</p>
        </details>
    ) : (
        <>
            <header class="ptheme__head">
                <p class="ptheme__num">{String(index + 1).padStart(2, "0")}</p>
                <div>
                    <h3 id={`h-${theme.id}`} class="ptheme__title">{theme.label}</h3>
                    <p class="ptheme__verdict">{theme.verdict}</p>
                </div>
                <StatusChip status={theme.status} />
            </header>

            <div class="ptheme__body">
                <div class="pblock pblock--data">
                    <h4 class="pblock__title">Qué dicen los datos</h4>
                    <div class="pblock__stats">{stats.map((s) => <StatTile indicator={s} />)}</div>
                    {charts.map((c) => <ChartFigure chart={c} />)}
                </div>

                <div class="pblock pblock--why">
                    <h4 class="pblock__title">Por qué importa y qué dicen los informes</h4>
                    <ul class="pfind">
                        {theme.findings.map((f) => (
                            <li class="pfind__item">
                                <p>{f.text}</p>
                                <a class="pcite" href={`#ev-${f.sourceId}`} aria-label={`Ir a la fuente ${sourceNumber(f.sourceId)}`}>Fuente [{sourceNumber(f.sourceId)}]</a>
                            </li>
                        ))}
                    </ul>
                    <aside class="plimit" aria-labelledby={`lim-${theme.id}`}>
                        <h4 id={`lim-${theme.id}`}>Lo que aún no sabemos</h4>
                        <p>{theme.limitations}</p>
                    </aside>
                </div>

                <div class="pblock pblock--resp">
                    <h4 class="pblock__title">Qué se está haciendo</h4>
                    {theme.interventionAreas.length > 0 && (
                        <p class="pblock__areas">Líneas de respuesta: {theme.interventionAreas.join(" · ")}</p>
                    )}
                    <ResponseCards response={response} orgNames={orgNames} />
                </div>

                <div class="pblock pblock--ind">
                    <h4 class="pblock__title">Qué vamos a medir</h4>
                    <IndicatorTable indicators={indicatorsOf(theme.id)} />
                </div>

                <div class="pblock pblock--ev">
                    <h4 class="pblock__title">Evidencia</h4>
                    <EvidenceList sources={sourcesOfTheme(theme)} />
                </div>
            </div>
        </>
    )}
</section>

<style is:global>
    .ptheme { padding: var(--space-12) 0; border-top: 1px solid var(--border); scroll-margin-top: 7rem; }
    .ptheme__head { display: grid; grid-template-columns: auto 1fr auto; gap: var(--space-4) var(--space-5); align-items: start; margin-bottom: var(--space-8); }
    .ptheme__num { font-family: var(--mono); font-size: var(--text-xs); color: var(--pillar-flow-3); padding-top: 0.6rem; }
    .ptheme__title { font-family: var(--serif); font-weight: 400; font-size: clamp(var(--text-xl), 4vw, var(--text-2xl)); line-height: 1.05; }
    .ptheme__verdict { font-size: var(--text-md); line-height: 1.35; margin-top: var(--space-3); max-width: 60ch; }
    .ptheme__body { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-10); }
    .ptheme__body > * { min-width: 0; }
    .pblock__title { font-family: var(--mono); font-weight: 400; font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); margin-bottom: var(--space-4); padding-bottom: var(--space-2); border-bottom: 1px solid var(--border-subtle); }
    .pblock__areas { font-size: var(--text-sm); margin-bottom: var(--space-4); }
    .pblock__stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: var(--space-4); margin-bottom: var(--space-4); }
    .pblock--data { display: grid; gap: var(--space-4); }
    .pblock--data .pblock__title { margin-bottom: 0; }
    .pfind { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-3); }
    .pfind__item { border-left: 3px solid var(--pillar-flow-3); padding: var(--space-2) var(--space-4); background: var(--surface-1); display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); align-items: baseline; justify-content: space-between; }
    .pfind__item p { max-width: 62ch; font-size: var(--text-base); }
    .pcite { font-family: var(--mono); font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.05em; border: 1px solid var(--border); padding: 0.15rem 0.5rem; background: var(--bg); white-space: nowrap; }
    .plimit { margin-top: var(--space-5); border: 1.5px dashed var(--border); padding: var(--space-4) var(--space-5); background: color-mix(in srgb, var(--pillar-flow-1) 14%, var(--bg)); }
    .plimit h4 { font-family: var(--mono); font-weight: 400; font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: var(--space-2); }
    .plimit p { font-size: var(--text-sm); max-width: 70ch; }
    .ptheme__stub summary { display: flex; align-items: center; gap: var(--space-4); cursor: pointer; list-style: none; flex-wrap: wrap; }
    .ptheme__stub summary h3 { font-family: var(--serif); font-weight: 400; font-size: var(--text-xl); }
    .ptheme__stub { border: 1.5px dashed var(--border); padding: var(--space-5); }
    .ptheme__stub p { margin-top: var(--space-3); font-size: var(--text-sm); max-width: 62ch; }
    .ptheme__stubnote { color: var(--muted); }
    .ptheme--stub { padding: var(--space-4) 0; border-top: 0; }
    @media (max-width: 640px) {
        .ptheme__head { grid-template-columns: 1fr; }
        .ptheme__num { padding-top: 0; }
    }
</style>
