---
// Context map: fake hand-made polygon layers + the site's real organizations.
// Only this component (and the layout toggle) ship client JS.
import fs from "node:fs";
import type { OrgRecord } from "../../lib/records";
import MockBanner from "./MockBanner.astro";

export interface Props {
    orgs: OrgRecord[];
}
const { orgs } = Astro.props;
const layers = JSON.parse(fs.readFileSync("./src/data/paisaje.layers.geojson", "utf8"));
const points = {
    type: "FeatureCollection",
    features: orgs
        .filter((o) => o.lat !== null && o.lng !== null)
        .map((o) => ({
            type: "Feature",
            properties: { name: o.name, place: o.placeName, grupo: o.grupoTrabajo },
            geometry: { type: "Point", coordinates: [o.lng, o.lat] },
        })),
};
const toggles = [
    { id: "orgs", label: "Organizaciones", on: true, swatch: "dot" },
    { id: "protegidas", label: "Zonas protegidas (ficticio)", on: false, swatch: "prot" },
    { id: "erosion", label: "Clases de erosión (ficticio)", on: false, swatch: "ero" },
    { id: "corredor", label: "Corredor propuesto (ficticio)", on: false, swatch: "cor" },
];
---

<section class="pmap" aria-labelledby="mapa-titulo">
    <div class="pmap__head">
        <h3 id="mapa-titulo" class="pmap__title">El paisaje y quienes actúan en él</h3>
        <MockBanner />
    </div>
    <p class="pmap__lede">Las capas del paisaje son <strong>ficticias</strong> y dibujadas a mano; los puntos son las organizaciones del sitio. Sirve para ver cómo conviven ambas cosas.</p>
    <div class="pmap__grid">
        <fieldset class="pmap__panel">
            <legend>Capas</legend>
            {toggles.map((t) => (
                <label class="pmap__toggle">
                    <input type="checkbox" data-layer={t.id} checked={t.on} />
                    <span class={`pmap__sw pmap__sw--${t.swatch}`} aria-hidden="true"></span>
                    {t.label}
                </label>
            ))}
            <p class="pmap__hint">Naranja: grupo de trabajo · Lima: resto de organizaciones</p>
        </fieldset>
        <div class="pmap__canvas" id="paisaje-map" data-layers={JSON.stringify(layers)} data-points={JSON.stringify(points)} role="region" aria-label="Mapa de contexto (maqueta)"></div>
    </div>
</section>

<script>
    import maplibregl from "maplibre-gl";
    import "maplibre-gl/dist/maplibre-gl.css";

    const el = document.getElementById("paisaje-map");
    if (el) {
        const layers = JSON.parse(el.dataset.layers || "{}");
        const points = JSON.parse(el.dataset.points || "{}");
        const map = new maplibregl.Map({
            container: el,
            style: {
                version: 8,
                sources: { osm: { type: "raster", tiles: ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"], tileSize: 256, attribution: "&copy; OpenStreetMap contributors" } },
                layers: [{ id: "osm", type: "raster", source: "osm" }],
            },
            center: [-2.55, 37.58],
            zoom: 8.6,
            maxZoom: 13,
        });
        map.addControl(new maplibregl.NavigationControl({ showCompass: false }), "top-right");
        const sub = (name: string) => ({ type: "FeatureCollection", features: layers.features.filter((f: any) => f.properties.layer === name) });
        const vis = (id: string) => (document.querySelector<HTMLInputElement>(`[data-layer="${id}"]`)?.checked ? "visible" : "none");

        map.on("load", () => {
            map.addSource("l-prot", { type: "geojson", data: sub("protegidas") as any });
            map.addSource("l-ero", { type: "geojson", data: sub("erosion") as any });
            map.addSource("l-cor", { type: "geojson", data: sub("corredor") as any });
            map.addSource("orgs", { type: "geojson", data: points });
            map.addLayer({ id: "protegidas-fill", type: "fill", source: "l-prot", paint: { "fill-color": "#0077c8", "fill-opacity": 0.22 }, layout: { visibility: vis("protegidas") } });
            map.addLayer({ id: "protegidas-line", type: "line", source: "l-prot", paint: { "line-color": "#00589a", "line-width": 2 }, layout: { visibility: vis("protegidas") } });
            map.addLayer({
                id: "erosion-fill", type: "fill", source: "l-ero",
                paint: { "fill-color": ["match", ["get", "class"], "moderada", "#f5b778", "alta", "#e8590c", "muy_alta", "#7a2300", "#f5b778"], "fill-opacity": 0.5 },
                layout: { visibility: vis("erosion") },
            });
            map.addLayer({ id: "corredor-fill", type: "fill", source: "l-cor", paint: { "fill-color": "#fffdfb", "fill-opacity": 0.35 }, layout: { visibility: vis("corredor") } });
            map.addLayer({ id: "corredor-line", type: "line", source: "l-cor", paint: { "line-color": "#221a12", "line-width": 2.4, "line-dasharray": [3, 2] }, layout: { visibility: vis("corredor") } });
            map.addLayer({
                id: "orgs-dots", type: "circle", source: "orgs",
                paint: { "circle-radius": 7, "circle-color": ["case", ["get", "grupo"], "#ff7a00", "#8fe84a"], "circle-stroke-color": "#fffdfb", "circle-stroke-width": 2 },
                layout: { visibility: vis("orgs") },
            });
            const pb = new maplibregl.LngLatBounds();
            for (const f of points.features ?? []) pb.extend(f.geometry.coordinates);
            if (!pb.isEmpty()) map.fitBounds(pb, { padding: 50, maxZoom: 9.5 });

            map.on("click", "orgs-dots", (e: any) => {
                const p = e.features?.[0]?.properties;
                if (!p) return;
                const box = document.createElement("div");
                box.style.cssText = "padding:0.6rem 0.8rem;font-family:var(--sans);font-size:0.85rem;";
                const b = document.createElement("strong");
                b.textContent = p.name;
                box.appendChild(b);
                if (p.place) { const s = document.createElement("div"); s.textContent = p.place; s.style.color = "var(--muted)"; box.appendChild(s); }
                new maplibregl.Popup({ closeButton: false }).setLngLat(e.lngLat).setDOMContent(box).addTo(map);
            });
            map.on("mouseenter", "orgs-dots", () => (map.getCanvas().style.cursor = "pointer"));
            map.on("mouseleave", "orgs-dots", () => (map.getCanvas().style.cursor = ""));
        });

        const groups: Record<string, string[]> = {
            orgs: ["orgs-dots"], protegidas: ["protegidas-fill", "protegidas-line"], erosion: ["erosion-fill"], corredor: ["corredor-fill", "corredor-line"],
        };
        document.querySelectorAll<HTMLInputElement>("[data-layer]").forEach((box) =>
            box.addEventListener("change", () => {
                for (const id of groups[box.dataset.layer!] ?? []) if (map.getLayer(id)) map.setLayoutProperty(id, "visibility", box.checked ? "visible" : "none");
            }),
        );
    }
</script>

<style is:global>
    .pmap { border: 1px solid var(--border); background: var(--bg); padding: var(--space-6); display: grid; gap: var(--space-4); }
    .pmap__head { display: flex; justify-content: space-between; gap: var(--space-3); flex-wrap: wrap; align-items: flex-start; }
    .pmap__title { font-family: var(--serif); font-weight: 400; font-size: var(--text-lg); }
    .pmap__lede { font-size: var(--text-sm); max-width: 70ch; color: var(--muted); }
    .pmap__grid { display: grid; grid-template-columns: 16rem 1fr; gap: var(--space-5); }
    .pmap__panel { border: 1px solid var(--border-subtle); padding: var(--space-4); display: grid; gap: var(--space-3); align-content: start; margin: 0; }
    .pmap__panel legend { font-family: var(--mono); font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); padding: 0 var(--space-2); }
    .pmap__toggle { display: flex; align-items: center; gap: var(--space-2); font-size: var(--text-sm); cursor: pointer; }
    .pmap__toggle input { accent-color: var(--pillar-flow-3); width: 1.05rem; height: 1.05rem; }
    .pmap__sw { width: 1.1rem; height: 0.8rem; flex: none; border: 1.5px solid #221a12; }
    .pmap__sw--dot { border-radius: 50%; width: 0.8rem; background: #ff7a00; }
    .pmap__sw--prot { background: rgba(0, 119, 200, 0.3); border-color: #00589a; }
    .pmap__sw--ero { background: linear-gradient(90deg, #f5b778 0 33%, #e8590c 33% 66%, #7a2300 66%); }
    .pmap__sw--cor { border-style: dashed; background: #fffdfb; }
    .pmap__hint { font-size: var(--text-xs); color: var(--muted); }
    .pmap__canvas { min-height: 26rem; height: 60vh; max-height: 36rem; border: 1px solid var(--border-subtle); background: var(--surface-2); }
    @media (max-width: 760px) { .pmap__grid { grid-template-columns: 1fr; } .pmap__canvas { height: 22rem; min-height: 22rem; } .pmap { padding: var(--space-4); } }
</style>
