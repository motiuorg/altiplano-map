---
// Organization card — used in the gallery grid. Built from the design system's card
// parts. Carries data-* attributes the gallery filter script reads (data-grupo,
// data-tipo, data-name); the map finds it by .org-card[data-org-id].
import Card from "@motiu/design/components/card/Card.astro";
import CardBody from "@motiu/design/components/card/CardBody.astro";
import CardEyebrow from "@motiu/design/components/card/CardEyebrow.astro";
import CardTitle from "@motiu/design/components/card/CardTitle.astro";
import CardText from "@motiu/design/components/card/CardText.astro";
import CardBadges from "@motiu/design/components/card/CardBadges.astro";
import CardFacts from "@motiu/design/components/card/CardFacts.astro";
import CardFact from "@motiu/design/components/card/CardFact.astro";
import CardFooter from "@motiu/design/components/card/CardFooter.astro";
import CardLink from "@motiu/design/components/card/CardLink.astro";
import Badge from "@motiu/design/components/Badge.astro";
import type { OrgRecord } from '../lib/records';
import { t, tv } from '../lib/i18n';
import type { Lang } from '../lib/i18n';

export interface Props {
  org: OrgRecord;
  lang?: Lang;
}

const { org, lang = 'es' } = Astro.props;
---

<Card
  class="org-card"
  data-org-id={org.id}
  data-filterable
  data-grupo={org.grupoTrabajo ? 'grupo' : 'resto'}
  data-tipo={org.tipos.map((x) => x.toLowerCase()).join('|')}
  data-name={org.name.toLowerCase()}
>
  <CardBody>
    <CardTitle size="sm">
      {org.grupoTrabajo ? (
        <button type="button" class="org-card__name-btn" data-open-org={org.id}>{org.name}</button>
      ) : (
        org.name
      )}
    </CardTitle>

    {org.placeName && <CardEyebrow>📍 {org.placeName}</CardEyebrow>}

    {org.tipos.length > 0 && (
      <CardBadges>
        {org.tipos.map((x) => <Badge shape="square" size="sm">{tv(lang, x)}</Badge>)}
      </CardBadges>
    )}

    {org.description && <CardText>{org.description}</CardText>}

    <CardFooter rule>
      {org.website ? (
        <CardLink href={org.website} external rel="noopener noreferrer">{t(lang, 'org.website')}</CardLink>
      ) : (
        <span></span>
      )}
      {org.grupoTrabajo && <Badge tone="flow" size="sm">{t(lang, 'org.group')}</Badge>}
    </CardFooter>
  </CardBody>
</Card>

<style>
  /* The one thing this card adds: a group name opens the org's side panel. */
  .org-card__name-btn {
    all: unset;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--pillar-flow-3);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .org-card__name-btn:hover,
  .org-card__name-btn:focus-visible {
    color: var(--pillar-flow-4);
  }
</style>
