---
// Organization card — used in the gallery grid. Carries data-* attributes the
// gallery filter script reads (data-grupo, data-zona).
import type { OrgRecord } from '../lib/records';

export interface Props {
  org: OrgRecord;
}

const { org } = Astro.props;
---

<article
  class="org-card reveal"
  data-org-id={org.id}
  data-filterable
  data-grupo={org.grupoTrabajo ? 'grupo' : 'resto'}
  data-tipo={org.tipos.map((t) => t.toLowerCase()).join('|')}
  data-name={org.name.toLowerCase()}
>
  <div class="org-card__head">
    <h3 class="org-card__name">
      {org.grupoTrabajo ? (
        <button type="button" class="org-card__name-btn" data-open-org={org.id}>{org.name}</button>
      ) : (
        org.name
      )}
    </h3>
  </div>

  {org.placeName && <p class="org-card__place">📍 {org.placeName}</p>}

  {org.tipos.length > 0 && (
    <p class="org-card__tipos">
      {org.tipos.map((t) => <span class="org-card__tipo">{t}</span>)}
    </p>
  )}

  {org.description && <p class="org-card__desc">{org.description}</p>}

  <div class="org-card__foot">
    {org.website && (
      <a class="org-card__link" href={org.website} target="_blank" rel="noopener noreferrer">
        ↗ Sitio web
      </a>
    )}
    {org.grupoTrabajo && <span class="badge badge--flow">Grupo de trabajo</span>}
  </div>
</article>

<style>
  .org-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px solid var(--border-subtle);
    background: var(--bg);
    border-radius: var(--radius);
    transition: border-color var(--t-med), box-shadow var(--t-med), transform var(--t-med);
    scroll-margin-top: 6rem;
  }

  .org-card:hover {
    border-color: var(--border);
    box-shadow: 0 2px 0 0 var(--border-subtle);
    transform: translateY(-2px);
  }

  .org-card.is-flash {
    border-color: var(--pillar-flow-3);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--pillar-flow-3) 25%, transparent);
  }

  .org-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .org-card__name {
    font-family: var(--serif);
    font-size: var(--text-md);
    font-weight: 400;
    line-height: 1.2;
  }

  .org-card__name-btn {
    all: unset;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--pillar-flow-3);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .org-card__name-btn:hover,
  .org-card__name-btn:focus-visible {
    color: var(--pillar-flow-4);
  }

  .org-card__place {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .org-card__desc {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: color-mix(in srgb, var(--fg) 88%, var(--muted));
    flex-grow: 1;
  }

  .org-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 2rem;
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-3);
  }

  .org-card__link {
    font-family: var(--mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .org-card__tipos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .org-card__tipo {
    font-family: var(--mono);
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    padding: 0.15rem 0.45rem;
  }

.org-card__foot .badge {
    margin-left: auto;
  }

  @media (max-width: 640px) {
    .org-card__head {
      flex-direction: column;
    }
  }
</style>
