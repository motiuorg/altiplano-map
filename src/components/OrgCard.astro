---
// Organization card — used in the gallery grid. Carries data-* attributes the
// gallery filter script reads (data-grupo, data-zona).
import type { OrgRecord } from '../lib/records';

export interface Props {
  org: OrgRecord;
}

const { org } = Astro.props;
---

<article
  class="org-card reveal"
  data-org-id={org.id}
  data-grupo={org.grupoTrabajo ? 'grupo' : 'resto'}
  data-name={org.name.toLowerCase()}
>
  <div class="org-card__head">
    <h3 class="org-card__name">{org.name}</h3>
    {org.grupoTrabajo ? (
      <span class="badge badge--flow">Grupo de trabajo</span>
    ) : (
      <span class="badge badge--paper">Organización</span>
    )}
  </div>

  {org.placeName && <p class="org-card__place">📍 {org.placeName}</p>}

  {org.description && <p class="org-card__desc">{org.description}</p>}

  <div class="org-card__foot">
    {org.website && (
      <a class="org-card__link" href={org.website} target="_blank" rel="noopener noreferrer">
        ↗ Sitio web
      </a>
    )}
    {org.zona.length > 0 && (
      <span class="org-card__zona">{org.zona.join(' · ')}</span>
    )}
  </div>
</article>

<style>
  .org-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px solid var(--border-subtle);
    background: var(--bg);
    border-radius: var(--radius);
    transition: border-color var(--t-med), box-shadow var(--t-med), transform var(--t-med);
    scroll-margin-top: 6rem;
  }

  .org-card:hover {
    border-color: var(--border);
    box-shadow: 0 2px 0 0 var(--border-subtle);
    transform: translateY(-2px);
  }

  .org-card.is-flash {
    border-color: var(--pillar-flow-3);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--pillar-flow-3) 25%, transparent);
  }

  .org-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .org-card__name {
    font-family: var(--serif);
    font-size: var(--text-md);
    font-weight: 400;
    line-height: 1.2;
  }

  .org-card__place {
    font-family: var(--mono);
    font-size: var(--text-xs);
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .org-card__desc {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: color-mix(in srgb, var(--fg) 88%, var(--muted));
    flex-grow: 1;
  }

  .org-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-3);
  }

  .org-card__link {
    font-family: var(--mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .org-card__zona {
    font-size: var(--text-2xs);
    font-family: var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-align: right;
  }

  @media (max-width: 640px) {
    .org-card__head {
      flex-direction: column;
    }
  }
</style>
