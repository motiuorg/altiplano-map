---
// One work area on the portfolio page: a tinted card that links to the area's own page.
import type { AreaView } from "../lib/portfolio";
import { pick, toneVars, compactEuro, portfolioHref } from "../lib/portfolio";
import { t } from "../lib/i18n";
import type { Lang } from "../lib/i18n";

export interface Props {
    view: AreaView;
    lang?: Lang;
}
const { view, lang = "es" } = Astro.props;
const count = (n: number) => (n === 1 ? t(lang, "pf.itvCount1") : t(lang, "pf.itvCount", { n }));
---

<a class="area-card" style={toneVars(view.tone)} href={portfolioHref(lang, view.slug)}>
    <span class="area-card__top">
        <span class="area-card__eyebrow">{t(lang, "pf.areaN", { n: view.num })}</span>
        <span class="area-card__count">{count(view.count)}</span>
    </span>
    <span class="area-card__name">{view.name}</span>
    {view.def.kicker.es && <span class="area-card__kicker">{pick(view.def.kicker, lang)}</span>}
    <ul class="area-card__subs">
        {view.subareas.map((s) => (
            <li class:list={{ "is-empty": s.items.length === 0 }}>
                <span class="area-card__id">{s.id}</span>
                <span class="area-card__sub">{s.name}</span>
                <span class="area-card__dots" aria-label={count(s.items.length)}>
                    {s.items.slice(0, 12).map(() => <i />)}
                </span>
            </li>
        ))}
    </ul>
    <span class="area-card__foot">
        <span class="area-card__fin">
            {view.total > 0 ? compactEuro(view.total, lang) : "—"}
            <small>{t(lang, "pf.financingOf")}</small>
        </span>
        <span class="area-card__go">{t(lang, "pf.open")} →</span>
    </span>
</a>

<style>
    .area-card {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        padding: var(--space-6);
        color: var(--text-primary);
        text-decoration: none;
        border: 1px solid color-mix(in srgb, var(--tone-m) 45%, transparent);
        border-radius: var(--radius-card, 0.75rem);
        background: color-mix(in srgb, var(--tone-l) 38%, var(--paper));
        transition: transform var(--t-med), box-shadow var(--t-med), border-color var(--t-med);
    }
    .area-card:hover,
    .area-card:focus-visible {
        transform: translateY(-3px);
        border-color: var(--tone-m);
        box-shadow: 0 14px 34px color-mix(in srgb, var(--tone-d) 16%, transparent);
    }
    .area-card:focus-visible {
        outline: 2px solid var(--tone-d);
        outline-offset: 3px;
    }

    .area-card__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
    }
    .area-card__eyebrow,
    .area-card__count {
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--tone-d);
    }
    .area-card__count {
        padding: 0.2em 0.7em;
        border: 1px solid color-mix(in srgb, var(--tone-m) 55%, transparent);
        border-radius: var(--radius-pill);
        background: color-mix(in srgb, var(--paper) 70%, transparent);
    }

    .area-card__name {
        font-family: var(--sans);
        font-size: var(--text-2xl, 2rem);
        line-height: 1.08;
        max-width: 18ch;
    }
    .area-card__kicker {
        font-size: var(--text-md);
        color: var(--text-secondary, var(--text-muted));
        max-width: 34ch;
    }

    .area-card__subs {
        list-style: none;
        margin: var(--space-3) 0 0;
        padding: var(--space-3) 0 0;
        border-top: 1px solid color-mix(in srgb, var(--tone-m) 30%, transparent);
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }
    .area-card__subs li {
        display: grid;
        grid-template-columns: 2.2rem 1fr auto;
        align-items: baseline;
        gap: var(--space-2);
        font-size: var(--text-sm);
    }
    .area-card__subs li.is-empty {
        color: var(--text-muted);
    }
    .area-card__id {
        font-family: var(--mono);
        font-size: var(--text-2xs);
        color: var(--tone-d);
    }
    /* One dot per intervention: a quick read of where the portfolio is thick and where it is thin. */
    .area-card__dots {
        display: inline-flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 3px;
        max-width: 5.5rem;
    }
    .area-card__dots i {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--tone-m);
    }

    .area-card__foot {
        margin-top: auto;
        padding-top: var(--space-5);
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--space-3);
    }
    .area-card__fin {
        font-family: var(--mono);
        font-size: var(--text-xl);
        line-height: 1;
    }
    .area-card__fin small {
        margin-left: var(--space-2);
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: var(--text-muted);
    }
    .area-card__go {
        font-family: var(--mono);
        font-size: var(--text-xs);
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: var(--tone-d);
    }
    .area-card:hover .area-card__go {
        text-decoration: underline;
    }

    @media (max-width: 560px) {
        .area-card {
            padding: var(--space-5);
        }
    }
</style>
