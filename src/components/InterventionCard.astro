---
// Intervention card — the 5 requested fields plus org chips. Carries data-*
// attributes for the gallery filters (data-area, data-viable).
import type { InterventionRecord } from "../lib/records";
import { formatValor, formatEuro } from "../lib/records";

export interface Props {
    intervention: InterventionRecord;
    orgNames: string[];
}

const { intervention: itv, orgNames } = Astro.props;
const viableLabel =
    itv.viable === null ? "" : itv.viable ? "Sí, viable" : "No viable";
const viableClass =
    itv.viable === null
        ? "badge--paper"
        : itv.viable
          ? "badge--success"
          : "badge--danger";
const recLabel =
    itv.recurrente === null ? "—" : itv.recurrente ? "Recurrente" : "No recurrente";
const capitales = [itv.capital1, itv.capital2].filter(Boolean);
---

<article
    class="itv-card"
    data-filterable
    data-item-id={itv.id}
    data-area={itv.areaTrabajo.map((a) => a.toLowerCase()).join("|")}
    data-viable={itv.viable === null ? "unknown" : itv.viable ? "si" : "no"}
    data-org={itv.orgIds.join("|")}
    data-fin={itv.financiacion ?? ""}
>
    <div class="itv-card__head">
        <h3 class="itv-card__name">{itv.name}</h3>
    </div>

    {itv.description && <p class="itv-card__desc">{itv.description}</p>}

    <dl class="itv-card__facts">
        <div class="itv-card__fact">
            <dt>Organización(es)</dt>
            <dd>
                {orgNames.length > 0 ? (
                    orgNames.map((n) => <span class="itv-card__org">{n}</span>)
                ) : (
                    <span class="itv-card__org itv-card__org--empty">—</span>
                )}
            </dd>
        </div>
        <div class="itv-card__fact">
            <dt>Valor ajustado a 5 años</dt>
            <dd class="itv-card__valor">
                {formatValor(itv.valor5Anos, itv.valor5AnosRaw)}
            </dd>
        </div>
        <div class="itv-card__fact">
            <dt>Financiación total</dt>
            <dd class="itv-card__valor">{formatEuro(itv.financiacion)}</dd>
        </div>
        <div class="itv-card__fact">
            <dt>Número de años</dt>
            <dd>{itv.anos ?? "—"}</dd>
        </div>
        <div class="itv-card__fact">
            <dt>Recurrencia</dt>
            <dd>{recLabel}</dd>
        </div>
        <div class="itv-card__fact">
            <dt>Tipo de capital</dt>
            <dd>
                {capitales.length > 0 ? (
                    capitales.map((c) => <span class="itv-card__org">{c}</span>)
                ) : (
                    <span class="itv-card__org itv-card__org--empty">—</span>
                )}
            </dd>
        </div>
        <div class="itv-card__fact">
            <dt>Viabilidad comercial</dt>
            <dd>
                {viableLabel ? (
                    <span class={`badge ${viableClass}`}>{viableLabel}</span>
                ) : (
                    <span class="itv-card__org itv-card__org--empty">—</span>
                )}
            </dd>
        </div>
    </dl>
</article>

<style>
    .itv-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        padding: var(--space-6);
        border: 1px solid var(--border-subtle);
        background: var(--bg);
        border-radius: var(--radius);
        transition:
            border-color var(--t-med),
            box-shadow var(--t-med),
            transform var(--t-med);
    }

    .itv-card:hover {
        border-color: var(--border);
        box-shadow: 0 2px 0 0 var(--border-subtle);
        transform: translateY(-2px);
    }

    .itv-card__head {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .itv-card__name {
        font-family: var(--serif);
        font-size: var(--text-md);
        font-weight: 400;
        line-height: 1.22;
    }

    .itv-card__desc {
        font-size: var(--text-sm);
        line-height: 1.6;
        color: color-mix(in srgb, var(--fg) 88%, var(--muted));
    }

    .itv-card__facts {
        margin: 0;
        border-top: 1px solid var(--border-subtle);
        padding-top: var(--space-4);
        display: grid;
        gap: var(--space-3);
    }

    .itv-card__fact {
        display: grid;
        grid-template-columns: 11rem 1fr;
        gap: var(--space-3);
        align-items: baseline;
    }

    .itv-card__fact dt {
        font-family: var(--mono);
        font-size: 0.62rem;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: var(--muted);
    }

    .itv-card__fact dd {
        margin: 0;
        font-size: var(--text-sm);
    }

    .itv-card__org {
        display: inline-block;
        font-size: var(--text-sm);
        background: var(--surface-1);
        border: 1px solid var(--border-subtle);
        padding: 0.15rem 0.5rem;
        margin: 0 0.15rem 0.15rem 0;
    }

    .itv-card__org--empty {
        color: var(--muted);
    }

    .itv-card__valor {
        font-family: var(--mono);
        font-size: var(--text-base);
        color: var(--fg);
    }

    @media (max-width: 560px) {
        .itv-card__fact {
            grid-template-columns: 1fr;
            gap: var(--space-1);
        }
    }
</style>
