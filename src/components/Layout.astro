---
// Editorial-organic shell — the motiu.org design language (paper/umber neutrals,
// pillar accents, straight edges, Averia Serif Libre display + Geist/Geist Mono).

import { t, pagePath } from "../lib/i18n";
import type { Lang, Page } from "../lib/i18n";
import { showPaisajeNav } from "../lib/site";

export interface Props {
    title: string;
    description?: string;
    current?: Page;
    lang?: Lang;
}

const {
    title,
    description = "",
    current = "organizaciones",
    lang = "es",
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const links = [
    { key: "organizaciones", label: t(lang, "nav.orgs") },
    { key: "intervenciones", label: t(lang, "nav.itvs") },
    { key: "simulador", label: t(lang, "nav.sim") },
    // Prototype entry, controlled by prototype_nav.paisaje in src/data/site.yaml
    ...(showPaisajeNav()
        ? [{ key: "paisaje", label: t(lang, "nav.paisaje"), tag: t(lang, "nav.proto") }]
        : []),
].map((l) => ({ tag: "", ...l, href: pagePath(base, lang, l.key as Page) }));
// The prototype page exists in Spanish only
const switchable = current !== "paisaje";
const otherLang: Lang = lang === "es" ? "en" : "es";
const switchHref = pagePath(base, otherLang, current);
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link
            rel="icon"
            type="image/svg+xml"
            href={import.meta.env.BASE_URL.replace(/\/?$/, "/") + "favicon.svg"}
        />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Averia+Serif+Libre:ital,wght@0,400;0,700;1,400&family=Geist:wght@100..900&family=Geist+Mono:wght@100..900&display=swap"
            rel="stylesheet"
        />

        <style is:global>
            /* ============ tokens — motiu.org editorial-organic lock ============ */
            :root {
                --paper: #fffdfb;
                --bone: #fcf8f2;
                --ivory: #fbf5ea;
                --eggshell: color-mix(
                    in srgb,
                    var(--paper) 50%,
                    var(--bone) 50%
                );
                --umber: #221a12;
                --rule: color-mix(in srgb, var(--umber) 65%, var(--paper) 35%);

                --pillar-neural-1: #96f3ff;
                --pillar-neural-2: #4defff;
                --pillar-neural-3: #00aeff;
                --pillar-neural-4: #000fa0;
                --pillar-tissue-1: #dfff80;
                --pillar-tissue-2: #d9ff4a;
                --pillar-tissue-3: #8fe84a;
                --pillar-tissue-4: #2c5a0d;
                --pillar-flow-1: #ffd27b;
                --pillar-flow-2: #ffbb26;
                --pillar-flow-3: #ff7a00;
                --pillar-flow-4: #8a2200;

                --bg: var(--paper);
                --surface-1: var(--bone);
                --surface-2: var(--ivory);
                --fg: var(--umber);
                --muted: var(--rule);
                --border: color-mix(in srgb, var(--umber) 45%, transparent);
                --border-subtle: color-mix(
                    in srgb,
                    var(--rule) 22%,
                    transparent
                );
                --primary: var(--pillar-flow-4);
                --primary-hover: color-mix(
                    in srgb,
                    var(--pillar-flow-4) 82%,
                    black 18%
                );

                --groupo-marker: var(--pillar-flow-3);
                --resto-marker: var(--pillar-tissue-3);

                /* Status (own family, distinct from pillars) */
                --success-mid: #00804a;
                --danger-mid: #a30000;
                --info-mid: #3a3ac0;

                --serif: "Averia Serif Libre", Georgia, serif;
                --sans:
                    "Geist", system-ui, -apple-system, "Segoe UI", sans-serif;
                --mono:
                    "Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace;

                --radius: 0;
                --radius-sm: 0;

                --text-2xs: 0.625rem;
                --text-xs: 0.75rem;
                --text-sm: 0.875rem;
                --text-base: 1.0625rem;
                --text-md: 1.375rem;
                --text-lg: 1.75rem;
                --text-xl: 2.125rem;
                --text-2xl: 2.625rem;
                --text-3xl: 3.25rem;

                --leading-display: 1.05;
                --leading-body: 1.55;
                --leading-ui: 1.4;
                --leading-mono: 1.45;

                --space-1: 0.25rem;
                --space-2: 0.5rem;
                --space-3: 0.75rem;
                --space-4: 1rem;
                --space-5: 1.25rem;
                --space-6: 1.5rem;
                --space-8: 2rem;
                --space-10: 2.5rem;
                --space-12: 3rem;
                --space-16: 4rem;
                --space-20: 5rem;
                --space-24: 6rem;

                --gutter: 2rem;
                --container: min(1280px, 100% - 2 * var(--gutter));
                --container-wide: min(1440px, 100% - 2 * var(--gutter));

                --t-fast: 120ms ease;
                --t-med: 280ms ease;
                --t-slow: 600ms cubic-bezier(0.4, 0, 0.2, 1);
            }

            @media (prefers-reduced-motion: reduce) {
                :root {
                    --t-fast: 0ms;
                    --t-med: 0ms;
                    --t-slow: 0ms;
                }
            }

            * {
                box-sizing: border-box;
            }

            html {
                scroll-behavior: smooth;
            }

            body {
                margin: 0;
                background: var(--bg);
                color: var(--fg);
                font-family: var(--sans);
                font-size: var(--text-base);
                line-height: var(--leading-body);
                overflow-x: hidden;
                text-rendering: optimizeLegibility;
            }

            a {
                color: var(--primary);
                text-decoration: none;
            }

            a:hover {
                text-decoration: underline;
            }

            ::selection {
                background: var(--pillar-flow-1);
                color: var(--umber);
            }

            h1,
            h2,
            h3,
            h4 {
                font-family: var(--sans);
                font-weight: 500;
                line-height: var(--leading-heading, 1.2);
                margin: 0;
                text-wrap: balance;
            }

            p {
                margin: 0;
            }

            .on-dark {
                --bg: var(--umber);
                --surface-1: color-mix(in srgb, var(--umber) 85%, white 15%);
                --surface-2: color-mix(in srgb, var(--umber) 70%, white 30%);
                --fg: var(--paper);
                --muted: color-mix(in srgb, var(--paper) 65%, var(--umber) 35%);
                --border: color-mix(in srgb, var(--paper) 35%, transparent);
                --border-subtle: color-mix(
                    in srgb,
                    var(--paper) 18%,
                    transparent
                );
                --primary: var(--pillar-flow-2);
                background: var(--bg);
                color: var(--fg);
            }

            .container {
                width: var(--container);
                margin-inline: auto;
            }

            /* ============ shared components ============ */

            .overline {
                font-family: var(--mono);
                font-size: var(--text-xs);
                text-transform: uppercase;
                letter-spacing: 0.08em;
                color: var(--muted);
            }

            .display {
                font-family: var(--serif);
                font-weight: 400;
                line-height: var(--leading-display);
                letter-spacing: -0.01em;
            }

            .lede {
                font-size: var(--text-md);
                line-height: 1.6;
                color: color-mix(in srgb, var(--fg) 85%, var(--muted));
                max-width: 62ch;
            }

            .copy-sm {
                font-size: var(--text-sm);
                line-height: 1.55;
                color: var(--muted);
            }

            /* Badge — pill, hairline, tinted via color-mix (Badge.astro pattern) */
            .badge {
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
                font-family: var(--mono);
                font-size: 0.64rem;
                text-transform: uppercase;
                letter-spacing: 0.06em;
                padding: 0.28rem 0.6rem;
                border: 1px solid var(--border-subtle);
                border-radius: var(--radius-pill, 9999px);
                color: var(--fg);
                background: color-mix(in srgb, var(--fg) 4%, var(--bg));
                white-space: nowrap;
            }

            .badge--flow {
                background: color-mix(
                    in srgb,
                    var(--pillar-flow-2) 22%,
                    var(--bg)
                );
                border-color: color-mix(
                    in srgb,
                    var(--pillar-flow-4) 40%,
                    transparent
                );
                color: var(--pillar-flow-4);
            }

            .badge--tissue {
                background: color-mix(
                    in srgb,
                    var(--pillar-tissue-3) 20%,
                    var(--bg)
                );
                border-color: color-mix(
                    in srgb,
                    var(--pillar-tissue-4) 40%,
                    transparent
                );
                color: var(--pillar-tissue-4);
            }

            .badge--neural {
                background: color-mix(
                    in srgb,
                    var(--pillar-neural-3) 18%,
                    var(--bg)
                );
                border-color: color-mix(
                    in srgb,
                    var(--pillar-neural-4) 40%,
                    transparent
                );
                color: var(--pillar-neural-4);
            }

            .badge--success {
                background: color-mix(
                    in srgb,
                    var(--success-mid) 14%,
                    var(--bg)
                );
                border-color: color-mix(
                    in srgb,
                    var(--success-mid) 45%,
                    transparent
                );
                color: var(--success-mid);
            }

            .badge--danger {
                background: color-mix(
                    in srgb,
                    var(--danger-mid) 12%,
                    var(--bg)
                );
                border-color: color-mix(
                    in srgb,
                    var(--danger-mid) 45%,
                    transparent
                );
                color: var(--danger-mid);
            }

            .badge--info {
                background: color-mix(in srgb, var(--info-mid) 12%, var(--bg));
                border-color: color-mix(
                    in srgb,
                    var(--info-mid) 45%,
                    transparent
                );
                color: var(--info-mid);
            }

            .badge--paper {
                background: var(--bg);
                color: var(--fg);
                border-color: var(--border-subtle);
            }

            /* Filter chips */
            .chip {
                font-family: var(--mono);
                font-size: var(--text-xs);
                text-transform: uppercase;
                letter-spacing: 0.05em;
                padding: 0.5rem 0.9rem;
                border: 1px solid var(--border-subtle);
                background: var(--bg);
                color: var(--muted);
                cursor: pointer;
                transition:
                    border-color var(--t-fast),
                    color var(--t-fast),
                    background var(--t-fast);
                font: inherit;
                font-family: var(--mono);
                font-size: var(--text-xs);
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }

            .chip:hover {
                border-color: var(--border);
                color: var(--fg);
            }

            .chip.is-active {
                background: var(--fg);
                border-color: var(--fg);
                color: var(--bg);
            }

            /* Buttons */
            .btn {
                display: inline-block;
                font-family: var(--mono);
                font-size: var(--text-xs);
                text-transform: uppercase;
                letter-spacing: 0.08em;
                padding: 0.8rem 1.4rem;
                background: var(--fg);
                color: var(--bg);
                border: 1px solid var(--fg);
                cursor: pointer;
                transition:
                    background var(--t-fast),
                    color var(--t-fast),
                    border-color var(--t-fast);
                text-decoration: none;
            }

            .btn:hover {
                background: var(--primary-hover, var(--fg));
                border-color: var(--primary-hover, var(--fg));
                text-decoration: none;
            }

            .btn--outline {
                background: transparent;
                color: var(--fg);
                border-color: var(--border);
            }

            .btn--outline:hover {
                background: var(--fg);
                color: var(--bg);
            }

            [data-filterable][hidden] {
                display: none !important;
            }

            /* Scroll reveal */
            .reveal {
                opacity: 0;
                transform: translateY(14px);
                transition:
                    opacity 0.7s ease,
                    transform 0.7s ease;
            }

            .reveal.is-visible {
                opacity: 1;
                transform: none;
            }

            @media (prefers-reduced-motion: reduce) {
                .reveal {
                    opacity: 1;
                    transform: none;
                    transition: none;
                }
            }

            /* ============ nav ============ */
            .site-nav {
                position: sticky;
                top: 0;
                z-index: 50;
                background: color-mix(in srgb, var(--bg) 92%, transparent);
                backdrop-filter: blur(10px);
                border-bottom: 1px solid var(--border-subtle);
            }

            .site-nav__inner {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: var(--space-4);
                height: 4rem;
            }

            .site-nav__brand {
                font-family: var(--serif);
                font-size: 1.15rem;
                color: var(--fg);
                text-decoration: none;
                white-space: nowrap;
            }

            .site-nav__brand:hover {
                text-decoration: none;
            }

            .site-nav__links {
                display: flex;
                align-items: center;
                gap: var(--space-5);
                list-style: none;
                margin: 0;
                padding: 0;
            }

            .site-nav__link {
                font-family: var(--mono);
                font-size: var(--text-xs);
                text-transform: uppercase;
                letter-spacing: 0.08em;
                color: var(--muted);
                text-decoration: none;
            }

            .site-nav__link:hover {
                color: var(--fg);
                text-decoration: none;
            }

            .site-nav__inner nav {
                margin-left: auto;
            }

            .lang-toggle {
                display: inline-flex;
                border: 1px solid var(--border);
                margin-left: var(--space-5);
            }

            .lang-toggle__opt {
                font-family: var(--mono);
                font-size: var(--text-2xs);
                letter-spacing: 0.08em;
                padding: 0.3rem 0.55rem;
                color: var(--muted);
                text-decoration: none;
            }

            a.lang-toggle__opt:hover {
                color: var(--fg);
                text-decoration: none;
            }

            .lang-toggle__opt.is-active {
                background: var(--fg);
                color: var(--bg);
            }

            @media (max-width: 760px) {
                .site-nav__inner {
                    flex-wrap: wrap;
                    height: auto;
                    padding: var(--space-3) 0;
                    row-gap: var(--space-2);
                }
                .site-nav__inner nav {
                    order: 3;
                    width: 100%;
                    margin-left: 0;
                }
                .lang-toggle {
                    margin-left: auto;
                }
                .site-nav__links {
                    flex-wrap: wrap;
                }
            }

            .site-nav__tag {
                margin-left: 0.4em;
                font-size: 0.55rem;
                letter-spacing: 0.06em;
                border: 1px dashed currentColor;
                padding: 0.05rem 0.3rem;
                vertical-align: 0.1em;
            }

            .site-nav__link.is-current {
                color: var(--fg);
                border-bottom: 2px solid var(--pillar-flow-3);
                padding-bottom: 0.2rem;
            }

            @media (max-width: 640px) {
                .site-nav__links {
                    gap: var(--space-3);
                }
            }

            /* ============ footer ============ */
            .site-footer {
                margin-top: var(--space-24);
                padding: var(--space-16) 0 var(--space-10);
            }

            .site-footer__inner {
                display: grid;
                grid-template-columns: 1.4fr 1fr 1fr;
                gap: var(--space-12);
            }

            .site-footer a {
                color: var(--pillar-flow-1);
            }

            .site-footer ul {
                list-style: none;
                margin: 0;
                padding: 0;
                display: grid;
                gap: var(--space-2);
            }

            .site-footer li a {
                font-size: var(--text-sm);
            }

            .site-footer__bottom {
                margin-top: var(--space-12);
                padding-top: var(--space-6);
                border-top: 1px solid var(--border-subtle);
                display: flex;
                justify-content: space-between;
                gap: var(--space-4);
                flex-wrap: wrap;
                font-family: var(--mono);
                font-size: var(--text-2xs);
                text-transform: uppercase;
                letter-spacing: 0.06em;
                color: var(--muted);
            }

            @media (max-width: 900px) {
                .site-footer__inner {
                    grid-template-columns: 1fr;
                    gap: var(--space-8);
                }
            }

            /* MapLibre look — flat paper shell */
            .maplibregl-map {
                font-family: var(--sans) !important;
            }

            .maplibregl-popup-content {
                border-radius: var(--radius) !important;
                box-shadow: 0 8px 28px rgba(34, 26, 18, 0.14) !important;
            }

            .maplibregl-popup-tip {
                display: none;
            }

            .map-pin-popup .maplibregl-popup-content {
                padding: 0;
            }
        </style>
    </head>
    <body>
        <header class="site-nav">
            <div class="container site-nav__inner">
                <a class="site-nav__brand" href={pagePath(base, lang, "organizaciones")}>
                    Altiplano&nbsp;Estepario
                </a>
                <nav aria-label={t(lang, "nav.label")}>
                    <ul class="site-nav__links">
                        {links.map((l) => (
                            <li>
                                <a
                                    class:list={[
                                        "site-nav__link",
                                        { "is-current": l.key === current },
                                    ]}
                                    href={l.href}
                                    aria-current={
                                        l.key === current ? "page" : undefined
                                    }
                                >
                                    {l.label}
                                    {l.tag && <span class="site-nav__tag">{l.tag}</span>}
                                </a>
                            </li>
                        ))}
                    </ul>
                </nav>
                <div
                    class="lang-toggle"
                    role="group"
                    aria-label={t(lang, "lang.label")}
                >
                    <a
                        class:list={["lang-toggle__opt", { "is-active": lang === "es" }]}
                        href={lang === "es" ? undefined : switchHref}
                        hreflang="es"
                        lang="es"
                        aria-current={lang === "es" ? "true" : undefined}
                    >
                        ES
                    </a>
                    <a
                        class:list={["lang-toggle__opt", { "is-active": lang === "en" }]}
                        href={lang === "en" || !switchable ? undefined : switchHref}
                        title={!switchable ? "Maqueta solo en español" : undefined}
                        hreflang="en"
                        lang="en"
                        aria-current={lang === "en" ? "true" : undefined}
                    >
                        EN
                    </a>
                </div>
            </div>
        </header>

        <main id="top">
            <slot />
        </main>

        <footer class="site-footer on-dark">
            <div class="container">
                <div class="site-footer__inner">
                    <div>
                        <p
                            class="display"
                            style="font-size: var(--text-xl); margin-bottom: var(--space-4);"
                        >
                            Altiplano Estepario
                        </p>
                        <p class="copy-sm" style="max-width: 44ch;">
                            {t(lang, "footer.blurb")}
                        </p>
                    </div>
                    <div>
                        <p
                            class="overline"
                            style="margin-bottom: var(--space-3);"
                        >
                            {t(lang, "footer.sections")}
                        </p>
                        <ul>
                            {links.map((l) => (
                                <li>
                                    <a href={l.href}>{l.label}</a>
                                </li>
                            ))}
                        </ul>
                    </div>
                    <div>
                        <p
                            class="overline"
                            style="margin-bottom: var(--space-3);"
                        >
                            {t(lang, "footer.project")}
                        </p>
                        <ul>
                            <li>
                                <a
                                    href="https://motiu.org"
                                    target="_blank"
                                    rel="noopener"
                                >
                                    motiu.org
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="site-footer__bottom">
                    <span>{t(lang, "footer.osm")}</span>
                    <span>CC BY-SA 4.0</span>
                </div>
            </div>
        </footer>

        <script is:inline>
            // Scroll reveal + section heading anchors: nothing fancy, just fade-up.
            const io = new IntersectionObserver(
                (entries) => {
                    for (const e of entries) {
                        if (e.isIntersecting) {
                            e.target.classList.add("is-visible");
                            io.unobserve(e.target);
                        }
                    }
                },
                { threshold: 0.08, rootMargin: "0px 0px -40px 0px" },
            );
            document
                .querySelectorAll(".reveal")
                .forEach((el) => io.observe(el));
        </script>
    </body>
</html>
