---
// OrgMap — MapLibre GL map of Altiplano organizations.
// Two pin colors: grupo de trabajo (flow orange) vs resto (the design system's supporting blue).
// Overlaid on the altiplano comarcas (core "Altiplano de Granada" vs surrounding
// steppe comarcas) with DOM comarca labels and a Spain-inset locator.
// Clicking a pin scrolls to + flashes the matching card in the gallery.
import fs from "fs";
import type { OrgRecord } from "../lib/records";
import { t, tv } from "../lib/i18n";
import type { Lang } from "../lib/i18n";

export interface Props {
    orgs: OrgRecord[];
    lang?: Lang;
}

const { orgs, lang = "es" } = Astro.props;

const REGION_JSON = JSON.parse(
    fs.readFileSync("./src/data/altiplano-region.geojson", "utf8"),
);
// Natural, national and regional parks in and around the Altiplano (MITECO ENP,
// built by scripts/build-espacios-protegidos.sh).
const PARKS_JSON = JSON.parse(
    fs.readFileSync("./src/data/espacios-protegidos.geojson", "utf8"),
);
// Base map: MapTiler Basic's open style without its label layers, on OpenFreeMap's
// OpenMapTiles vector tiles (no API key). See "metadata" in the file.
const BASEMAP_JSON = JSON.parse(
    fs.readFileSync("./src/data/basemap-style.json", "utf8"),
);
// Towns, villages and hamlets around the Altiplano, for labelling pinned towns.
const PLACES_JSON = JSON.parse(
    fs.readFileSync("./src/data/places.json", "utf8"),
);
const INSET_JSON = JSON.parse(
    fs.readFileSync("./src/data/spain-inset.json", "utf8"),
);

const withCoords = orgs.filter((o) => o.lat !== null && o.lng !== null);
const missing = orgs.filter((o) => o.lat === null || o.lng === null);
const grupoCount = withCoords.filter((o) => o.grupoTrabajo).length;
const restoCount = withCoords.length - grupoCount;

// Pins = flat list; overlapping-coordinate spidering (deterministic pixel-ring
// offsets) is computed client-side where pixel math lives.
const pins = withCoords.map((o) => ({
    id: o.id,
    name: tv(lang, o.name),
    place: o.placeName,
    desc: tv(lang, o.description),
    website: o.website,
    grupo: o.grupoTrabajo,
    tipos: o.tipos.map((x) => tv(lang, x)),
    lat: o.lat,
    lng: o.lng,
}));

// --- Comarca label centroids + region bounds -------------------------------
// Region of interest: name → area-weighted centroid of the largest ring(s).
// "Altiplano de Granada" spans two OSM comarcas (Baza + Huéscar) → one label,
// computed as the area-weighted centroid across both features.

function ringArea(ring: number[][]): number {
    let sum = 0;
    for (let i = 0; i < ring.length - 1; i++) {
        const [x1, y1] = ring[i];
        const [x2, y2] = ring[i + 1];
        sum += x1 * y2 - x2 * y1;
    }
    return Math.abs(sum) / 2;
}

function ringCentroid(ring: number[][]): { lng: number; lat: number } {
    let a = 0;
    let cx = 0;
    let cy = 0;
    for (let i = 0; i < ring.length - 1; i++) {
        const [x1, y1] = ring[i];
        const [x2, y2] = ring[i + 1];
        const cross = x1 * y2 - x2 * y1;
        a += cross;
        cx += (x1 + x2) * cross;
        cy += (y1 + y2) * cross;
    }
    if (a === 0) return { lng: ring[0][0], lat: ring[0][1] };
    return { lng: cx / (3 * a), lat: cy / (3 * a) };
}

type RegionBounds = {
    minLng: number;
    minLat: number;
    maxLng: number;
    maxLat: number;
};

function featureLargestRing(f: any): number[][] | null {
    const rings: number[][][] =
        f.geometry?.type === "Polygon"
            ? f.geometry.coordinates
            : f.geometry?.type === "MultiPolygon"
              ? f.geometry.coordinates.flat()
              : [];
    let best = null;
    let bestArea = -1;
    for (const r of rings) {
        const a = ringArea(r);
        if (a > bestArea) {
            bestArea = a;
            best = r;
        }
    }
    return best;
}

const labelGroups = new Map<
    string,
    { core: boolean; items: { lng: number; lat: number; area: number }[] }
>();
let bounds: RegionBounds = {
    minLng: Infinity,
    minLat: Infinity,
    maxLng: -Infinity,
    maxLat: -Infinity,
};

for (const f of REGION_JSON.features ?? []) {
    const ring = featureLargestRing(f);
    if (!ring) continue;
    for (const [lng, lat] of ring) {
        if (lng < bounds.minLng) bounds.minLng = lng;
        if (lng > bounds.maxLng) bounds.maxLng = lng;
        if (lat < bounds.minLat) bounds.minLat = lat;
        if (lat > bounds.maxLat) bounds.maxLat = lat;
    }
    const name: string = f.properties?.name ?? "Comarca";
    const core = !!f.properties?.core;
    const g = labelGroups.get(name) ?? { core, items: [] };
    const c = ringCentroid(ring);
    g.items.push({ lng: c.lng, lat: c.lat, area: ringArea(ring) });
    labelGroups.set(name, g);
}

const labels = [...labelGroups.entries()].map(([name, g]) => {
    const totalArea = g.items.reduce((s, i) => s + i.area, 0);
    if (totalArea === 0) {
        const first = g.items[0];
        return {
            name,
            core: g.core,
            lat: first?.lat ?? 0,
            lng: first?.lng ?? 0,
        };
    }
    const lat = g.items.reduce((s, i) => s + i.lat * i.area, 0) / totalArea;
    const lng = g.items.reduce((s, i) => s + i.lng * i.area, 0) / totalArea;
    return { name, core: g.core, lat, lng };
});

// Park labels sit on the centroid of each park's largest ring.
const parkLabels = (PARKS_JSON.features ?? []).flatMap((f: any) => {
    const ring = featureLargestRing(f);
    if (!ring) return [];
    return [{ name: f.properties.nombre, ...ringCentroid(ring) }];
});

// Town labels: the town nearest each pin, if there is one close enough (3 km for
// a city, town or village; 1.5 km for a hamlet, which only wins when nothing
// bigger is near). Places come from OpenStreetMap (src/data/places.json).
const kmBetween = (lat1: number, lng1: number, lat2: number, lng2: number) =>
    Math.hypot(
        (lng1 - lng2) * 111.32 * Math.cos((lat1 * Math.PI) / 180),
        (lat1 - lat2) * 110.57,
    );
const townLabels = new Map<string, { name: string; lat: number; lng: number; hamlet: boolean }>();
for (const o of withCoords) {
    let best: { score: number; p: any } | null = null;
    for (const p of PLACES_JSON.places) {
        const hamlet = p.place === "hamlet";
        const d = kmBetween(o.lat!, o.lng!, p.lat, p.lng);
        if (d > (hamlet ? 1.5 : 3)) continue;
        const score = d + (hamlet ? 5 : 0);
        if (!best || score < best.score) best = { score, p };
    }
    if (best)
        townLabels.set(best.p.name, {
            name: best.p.name,
            lat: best.p.lat,
            lng: best.p.lng,
            hamlet: best.p.place === "hamlet",
        });
}

const strings = {
    group: t(lang, "org.group"),
    website: t(lang, "org.website"),
    cluster: t(lang, "map.cluster", { n: "{n}" }),
};
const mapData = {
    pins,
    region: REGION_JSON,
    labels,
    parks: PARKS_JSON,
    parkLabels,
    towns: [...townLabels.values()],
    basemap: BASEMAP_JSON,
    bounds,
    strings,
};
---

<section class="org-map-block" id="mapa">
    <div class="org-map-block__frame">
        <div id="org-map" data-map-data={JSON.stringify(mapData)}></div>
        <div class="org-map-inset" aria-hidden="true">
            <svg
                class="org-map-inset__svg"
                viewBox={INSET_JSON.viewBox}
                role="img"
            >
                <path class="org-map-inset__outline" d={INSET_JSON.path}></path>
                <circle
                    class="org-map-inset__pulse"
                    cx={INSET_JSON.dot.x}
                    cy={INSET_JSON.dot.y}
                    r="0.9"
                ></circle>
                <circle
                    class="org-map-inset__dot"
                    cx={INSET_JSON.dot.x}
                    cy={INSET_JSON.dot.y}
                    r="0.32"
                ></circle>
            </svg>
            <span class="org-map-inset__caption">
                {t(lang, "map.country")}
            </span>
        </div>
    </div>

    <div class="org-map-legend">
        <span class="org-map-legend__item">
            <span
                class="org-map-legend__dot org-map-legend__dot--grupo"
                aria-hidden="true"
            ></span>
            {t(lang, "map.groupLegend", { n: grupoCount })}
        </span>
        {restoCount > 0 && (
            <span class="org-map-legend__item">
                <span
                    class="org-map-legend__dot org-map-legend__dot--resto"
                    aria-hidden="true"
                ></span>
                {t(lang, "map.allyLegend", { n: restoCount })}
            </span>
        )}
        <span class="org-map-legend__item">
            <span
                class="org-map-legend__swatch org-map-legend__swatch--region"
                aria-hidden="true"
            ></span>
            {t(lang, "map.region")}
        </span>
        <span class="org-map-legend__item">
            <span
                class="org-map-legend__swatch org-map-legend__swatch--parks"
                aria-hidden="true"
            ></span>
            {t(lang, "map.parks")}
        </span>
        {missing.length > 0 && (
            <span class="org-map-legend__missing">
                {t(lang, "map.missing", { n: missing.length })}
            </span>
        )}
    </div>
</section>

<style is:global>
    .org-map-block {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .org-map-block__frame {
        position: relative;
        width: 100%;
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
        background: var(--surface-2);
    }

    #org-map {
        width: 100%;
        height: 100%;
    }

    .org-map-inset {
        position: absolute;
        top: var(--space-4);
        left: var(--space-4);
        z-index: 2;
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        padding: var(--space-3) var(--space-3) var(--space-2);
        background: var(--paper);
        border: 1px solid var(--border-default);
        box-shadow: 0 2px 0 0 var(--border-subtle);
        pointer-events: none;
    }

    .org-map-inset__svg {
        width: 84px;
        height: auto;
        display: block;
    }

    .org-map-inset__outline {
        fill: var(--surface-1);
        stroke: var(--rule);
        stroke-width: 0.14;
        stroke-linejoin: round;
    }

    .org-map-inset__dot {
        fill: var(--pillar-flow-3);
        stroke: var(--paper);
        stroke-width: 0.16;
        transform-box: fill-box;
        transform-origin: center;
    }

    .org-map-inset__pulse {
        fill: var(--pillar-flow-3);
        opacity: 0.55;
        transform-box: fill-box;
        transform-origin: center;
        animation: org-map-inset-pulse 2.6s ease-out infinite;
    }

    @keyframes org-map-inset-pulse {
        0% {
            transform: scale(0.35);
            opacity: 0.55;
        }
        70% {
            transform: scale(1.5);
            opacity: 0;
        }
        100% {
            transform: scale(1.5);
            opacity: 0;
        }
    }

    .org-map-inset__caption {
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        text-align: center;
    }

    .org-map-legend {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-4) var(--space-6);
        padding: var(--space-3) var(--space-5);
        border-top: 1px solid var(--border-subtle);
        font-family: var(--mono);
        font-size: var(--text-xs);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
    }

    .org-map-legend__item {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .org-map-legend__dot {
        width: 0.7rem;
        height: 0.7rem;
        border-radius: 50%;
        border: 2px solid var(--bg);
        box-shadow: 0 0 0 1px var(--border-subtle);
    }

    .org-map-legend__dot--grupo {
        background: var(--pillar-flow-3);
    }

    .org-map-legend__dot--resto {
        background: var(--data-support);
    }

    .org-map-legend__swatch {
        width: 0.9rem;
        height: 0.65rem;
        border-radius: var(--radius-sm);
    }

    .org-map-legend__swatch--region {
        background: rgba(122, 104, 76, 0.16);
        border: 1.5px solid #6b5a3e;
    }

    .org-map-legend__swatch--parks {
        background: color-mix(in srgb, var(--pillar-tissue-3) 30%, transparent);
        border: 1.5px dashed var(--pillar-tissue-4);
    }

    .org-map-legend__missing {
        color: var(--status-danger-mid);
        text-transform: none;
    }

    /* Comarca labels — DOM markers (MapLibre symbol layers need a glyphs
       endpoint; DOM keeps the site fonts), mono uppercase, paper halo. */
    .comarca-label {
        font-family: var(--mono);
        font-size: var(--text-2xs);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        white-space: nowrap;
        color: var(--text-muted);
        text-shadow:
            0 0 3px var(--paper),
            0 0 8px var(--paper),
            0 0 14px var(--paper);
        pointer-events: none;
        user-select: none;
        padding: 0.1rem 0.35rem;
    }

    /* Park labels: like the comarca labels, in the park green, italic and
       sentence case; shown from zoom 9 (see .org-map--parks-labels). */
    .park-label {
        font-family: var(--mono);
        font-size: var(--text-2xs);
        font-style: italic;
        letter-spacing: 0.04em;
        white-space: nowrap;
        color: var(--pillar-tissue-4);
        text-shadow:
            0 0 3px var(--paper),
            0 0 8px var(--paper);
        pointer-events: none;
        user-select: none;
        opacity: 0;
        transition: opacity var(--t-fast);
    }

    .org-map--parks-labels .park-label {
        opacity: 1;
    }

    /* Town labels: the places that have pins, in plain dark text under the town
       point. Hamlets appear from zoom 9, with the park labels. */
    .town-label {
        font-family: var(--mono);
        font-size: var(--text-2xs);
        letter-spacing: 0.02em;
        white-space: nowrap;
        color: var(--text-primary);
        text-shadow:
            0 0 3px var(--paper),
            0 0 6px var(--paper),
            0 0 10px var(--paper);
        pointer-events: none;
        user-select: none;
    }

    .town-label--hamlet {
        opacity: 0;
        transition: opacity var(--t-fast);
    }

    .org-map--parks-labels .town-label--hamlet {
        opacity: 1;
    }

    /* Map pins — round paper-ring dots with glow; hover scale goes on the INNER
       span (MapLibre owns the marker element's transform/translation). */
    .org-pin {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--pin-color);
        border: 2.5px solid var(--paper);
        box-shadow:
            0 0 0 1px color-mix(in srgb, var(--pin-color) 55%, transparent),
            0 3px 10px color-mix(in srgb, var(--pin-color) 55%, transparent);
        cursor: pointer;
        display: grid;
        place-items: center;
    }

    .org-pin__inner {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--paper);
        transition: transform var(--t-fast);
    }

    .org-pin:hover .org-pin__inner {
        transform: scale(1.9);
    }

.org-cluster {
        min-width: 34px;
        height: 34px;
        padding: 0 6px;
        border-radius: 17px;
        background: var(--umber);
        color: var(--paper);
        border: 2.5px solid var(--paper);
        box-shadow: 0 3px 10px rgba(34, 26, 18, 0.35);
        font-family: var(--mono);
        font-size: 0.8rem;
        font-weight: 600;
        display: grid;
        place-items: center;
        cursor: pointer;
        transition: background var(--t-fast);
    }

    .org-cluster:hover {
        background: var(--pillar-flow-4);
    }

    .org-cluster.is-open {
        background: var(--pillar-flow-4);
        box-shadow: 0 0 0 5px color-mix(in srgb, var(--pillar-flow-3) 30%, transparent);
    }

    .org-cluster--grupo {
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--pillar-flow-3) 70%, transparent), 0 3px 10px rgba(34, 26, 18, 0.35);
    }

    /* Grupo de trabajo pins and numbered dots sit above the other pins. */
    .org-pin--grupo {
        z-index: 2;
    }

    .org-cluster {
        z-index: 3;
    }

    /* An org's hover card sits above every pin and numbered dot. */
    .org-pin-popup {
        z-index: 4;
    }

    .org-pin--spread {
        animation: org-pin-pop 220ms ease-out both;
    }

    @keyframes org-pin-pop {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    .maplibregl-ctrl-bottom-left {
        margin: 1.25rem !important;
    }

    @media (max-width: 767px) {
        .maplibregl-ctrl-bottom-left {
            margin: 0.75rem !important;
        }
    }

    /* Hover card: the same surface, spacing and parts as the organisation cards. */
    .org-pin-popup .maplibregl-popup-content {
        padding: 0;
        background: var(--paper);
        border: 1px solid var(--border-default);
        border-radius: var(--radius-card, 0.75rem) !important;
        box-shadow: var(--shadow-md) !important;
    }
    .org-pop {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        padding: var(--space-5);
        width: 300px;
        max-width: 100%;
        font-family: var(--sans);
    }
    .org-pop__title {
        margin: 0;
        font-size: var(--text-md);
    }
    .org-pop__eyebrow {
        margin: 0;
        font-family: var(--mono);
        font-size: var(--text-xs);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-muted);
    }
    .org-pop__text {
        margin: 0;
        color: var(--text-muted);
        font-size: var(--copy-md);
        line-height: var(--leading-body);
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .org-pop__foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        margin-top: var(--space-2);
        padding-top: var(--space-3);
        border-top: 1px solid var(--border-subtle);
    }
    .org-pop__link {
        font-family: var(--mono);
        font-size: var(--text-xs);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--primary);
        text-decoration: none;
    }
    .org-pop__link:hover {
        text-decoration: underline;
    }
</style>

<script>
    import maplibregl from "maplibre-gl";
    import "maplibre-gl/dist/maplibre-gl.css";

    function escapeHtml(str) {
        return String(str ?? "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
    }

    function initMap() {
        const container = document.getElementById("org-map");
        if (!container) return;

        const data = JSON.parse(container.dataset.mapData || "{}");
        const { pins = [], region = null, labels = [], parks = null, parkLabels = [], towns = [], basemap = null, bounds = null, strings = {} } = data;

        const hasRegion =
            region && region.features && region.features.length > 0;
        const regionCenter = bounds
            ? {
                  lat: (bounds.minLat + bounds.maxLat) / 2,
                  lng: (bounds.minLng + bounds.maxLng) / 2,
              }
            : null;

        const map = new maplibregl.Map({
            container,
            // No base-map labels: the only text on the map is ours (comarcas,
            // parks, pins).
            style: basemap,
            center: [regionCenter?.lng ?? -2.6, regionCenter?.lat ?? 37.6],
            zoom: 8.3,
            maxZoom: 14,
        });

        map.addControl(new maplibregl.NavigationControl(), "bottom-left");

        // Exposed for debugging/automation (layer inspection, programmatic pan).
        container.__map = map;

        // Region overlay + comarca labels go in once the style is ready.
        map.on("load", () => {
            if (hasRegion) {
                map.addSource("altiplano-region", {
                    type: "geojson",
                    data: region,
                });
                map.addLayer({
                    id: "altiplano-region-fill",
                    type: "fill",
                    source: "altiplano-region",
                    paint: {
                        "fill-color": "rgba(122,104,76,0.16)",
                        "fill-outline-color": "rgba(0,0,0,0)",
                    },
                });
                map.addLayer({
                    id: "altiplano-region-line",
                    type: "line",
                    source: "altiplano-region",
                    paint: {
                        "line-color": "#6b5a3e",
                        "line-width": 1.5,
                    },
                });

                for (const label of labels) {
                    const el = document.createElement("div");
                    el.className = "comarca-label";
                    el.textContent = label.name;
                    new maplibregl.Marker({
                        element: el,
                        anchor: "center",
                    })
                        .setLngLat([label.lng, label.lat])
                        .addTo(map);
                }
            }

            // Parks: the design system's tissue greens, read from the page's CSS
            // (MapLibre paint can't use CSS variables). Fill under the comarca line,
            // dashed outline on top.
            if (parks && parks.features && parks.features.length > 0) {
                const css = getComputedStyle(document.documentElement);
                const token = (name, fallback) =>
                    css.getPropertyValue(name).trim() || fallback;
                const parkFill = token("--pillar-tissue-3", "#8FE84A");
                const parkLine = token("--pillar-tissue-4", "#2C5A0D");
                map.addSource("parks", { type: "geojson", data: parks });
                const beforeRegionLine = map.getLayer("altiplano-region-line")
                    ? "altiplano-region-line"
                    : undefined;
                map.addLayer(
                    {
                        id: "parks-fill",
                        type: "fill",
                        source: "parks",
                        paint: { "fill-color": parkFill, "fill-opacity": 0.22 },
                    },
                    beforeRegionLine,
                );
                map.addLayer({
                    id: "parks-line",
                    type: "line",
                    source: "parks",
                    paint: {
                        "line-color": parkLine,
                        "line-width": 1.2,
                        "line-opacity": 0.8,
                        "line-dasharray": [3, 2],
                    },
                });

                for (const label of parkLabels) {
                    const el = document.createElement("div");
                    el.className = "park-label";
                    el.textContent = label.name;
                    new maplibregl.Marker({ element: el, anchor: "center" })
                        .setLngLat([label.lng, label.lat])
                        .addTo(map);
                }
                const toggleParkLabels = () =>
                    container.classList.toggle(
                        "org-map--parks-labels",
                        map.getZoom() >= 9,
                    );
                map.on("zoom", toggleParkLabels);
                toggleParkLabels();
            }

            // Town labels for the places that have pins; hamlets from zoom 9.
            for (const town of towns) {
                const el = document.createElement("div");
                el.className = "town-label" + (town.hamlet ? " town-label--hamlet" : "");
                el.textContent = town.name;
                new maplibregl.Marker({ element: el, anchor: "top", offset: [0, 19] })
                    .setLngLat([town.lng, town.lat])
                    .addTo(map);
            }

            // Framing: pins when there are any, the comarca region otherwise.
            if (pins.length > 0) {
                const pb = new maplibregl.LngLatBounds();
                for (const p of pins) pb.extend([p.lng, p.lat]);
                map.fitBounds(pb, { padding: 48, maxZoom: 10 });
            } else if (bounds) {
                map.fitBounds(
                    [
                        [bounds.minLng, bounds.minLat],
                        [bounds.maxLng, bounds.maxLat],
                    ],
                    { padding: 32, maxZoom: 9.5 },
                );
            }
        });

        // ---- Pins & clusters ------------------------------------------------
        // Orgs that share a location collapse into ONE numbered dot. Clicking it
        // zooms in and fans the members out around it on concentric rings, joined
        // to the centre by thin spokes. The offsets are geographic (not pixels), so
        // the fan scales with the map when you zoom. Click the dot again, click the
        // map or press Esc to collapse it.
        const FAN_ZOOM = 14;

        const slugCard = (id) =>
            document.querySelector('.org-card[data-org-id="' + id + '"]');
        const flashCard = (id) => {
            const card = slugCard(id);
            if (!card) return;
            card.scrollIntoView({ behavior: "smooth", block: "center" });
            card.classList.add("is-flash");
            setTimeout(() => card.classList.remove("is-flash"), 1600);
        };

        const popupHtml = (p) => `
        <div class="org-pop">
          <h3 class="org-pop__title">${escapeHtml(p.name)}</h3>
          ${p.tipos && p.tipos.length ? `<p class="org-pop__eyebrow">${escapeHtml(p.tipos.join(" · "))}</p>` : ""}
          ${p.desc ? `<p class="org-pop__text">${escapeHtml(p.desc)}</p>` : ""}
          ${p.website || p.grupo ? `<div class="org-pop__foot">${p.website ? `<a class="org-pop__link" href="${escapeHtml(p.website)}" target="_blank" rel="noopener noreferrer">${escapeHtml(strings.website)}</a>` : "<span></span>"}${p.grupo ? `<span class="badge badge--sm badge--pill badge--flow">${escapeHtml(strings.group)}</span>` : ""}</div>` : ""}
        </div>`;

        // One hover card at a time. It stays open while the pointer is on the dot or
        // on the card itself, and closes shortly after it leaves both, so the link
        // can be reached.
        let hoverPopup = null;
        let hoverTimer = null;
        const cancelClose = () => clearTimeout(hoverTimer);
        const scheduleClose = (popup) => {
            clearTimeout(hoverTimer);
            hoverTimer = setTimeout(() => {
                popup.remove();
                if (hoverPopup === popup) hoverPopup = null;
            }, 250);
        };

        function makePin(p, lngLat, extraClass) {
            const el = document.createElement("div");
            el.className =
                "org-pin" +
                (p.grupo ? " org-pin--grupo" : "") +
                (extraClass ? " " + extraClass : "");
            el.style.setProperty(
                "--pin-color",
                p.grupo ? "var(--pillar-flow-3)" : "var(--data-support)",
            );
            el.innerHTML = '<span class="org-pin__inner"></span>';
            const marker = new maplibregl.Marker({
                element: el,
                anchor: "center",
            })
                .setLngLat(lngLat)
                .addTo(map);
            const popup = new maplibregl.Popup({
                offset: 14,
                closeButton: false,
                closeOnClick: false,
                focusAfterOpen: false,
                className: "org-pin-popup",
                maxWidth: "340px",
            }).setHTML(popupHtml(p));
            el.addEventListener("mouseenter", () => {
                cancelClose();
                if (hoverPopup && hoverPopup !== popup) hoverPopup.remove();
                hoverPopup = popup;
                if (!popup.isOpen()) {
                    popup.setLngLat(marker.getLngLat()).addTo(map);
                    const pe = popup.getElement();
                    pe.addEventListener("mouseenter", cancelClose);
                    pe.addEventListener("mouseleave", () => scheduleClose(popup));
                }
            });
            el.addEventListener("mouseleave", () => scheduleClose(popup));
            el.addEventListener("click", (e) => {
                e.stopPropagation();
                flashCard(p.id);
            });
            return marker;
        }

        // Group pins that would overlap on screen at the current zoom (not only
        // identical coordinates), so nearby orgs in the same village don't hide each
        // other. Regrouped after every zoom. The grupo de trabajo seeds groups first.
        const OVERLAP_PX = 26;
        const samePlace = (group) =>
            group.every(
                (p) =>
                    p.lat.toFixed(4) === group[0].lat.toFixed(4) &&
                    p.lng.toFixed(4) === group[0].lng.toFixed(4),
            );
        function groupPins() {
            const seeds = [];
            const ordered = [...pins].sort(
                (a, b) => Number(b.grupo) - Number(a.grupo),
            );
            for (const p of ordered) {
                const pt = map.project([p.lng, p.lat]);
                const near = seeds.find(
                    (s) => Math.hypot(s.pt.x - pt.x, s.pt.y - pt.y) < OVERLAP_PX,
                );
                if (near) near.group.push(p);
                else seeds.push({ pt, group: [p] });
            }
            return seeds.map((s) => s.group);
        }

        // Fan layout: concentric rings, ~40px between neighbours, in metres at
        // FAN_ZOOM so it keeps its proportions as the map zooms.
        function fanOffsets(n, lat) {
            const mPerPx =
                (156543.03 * Math.cos((lat * Math.PI) / 180)) /
                Math.pow(2, FAN_ZOOM);
            const pts = [];
            let ring = 0;
            while (pts.length < n) {
                const r = 58 + ring * 46; // px
                const cap = Math.max(5, Math.floor((2 * Math.PI * r) / 42));
                const count = Math.min(cap, n - pts.length);
                const phase = ring % 2 ? Math.PI / count : 0;
                for (let i = 0; i < count; i++) {
                    const ang =
                        phase + (2 * Math.PI * i) / count - Math.PI / 2;
                    pts.push([
                        Math.cos(ang) * r * mPerPx,
                        Math.sin(ang) * r * mPerPx,
                    ]);
                }
                ring++;
            }
            return pts;
        }

        let openCluster = null; // { el, markers, group }
        const SPOKES_SRC = "cluster-spokes";

        function setSpokes(features) {
            const src = map.getSource(SPOKES_SRC);
            if (src)
                src.setData({ type: "FeatureCollection", features });
        }

        function collapse() {
            if (!openCluster) return;
            openCluster.markers.forEach((m) => m.remove());
            openCluster.el.classList.remove("is-open");
            openCluster = null;
            setSpokes([]);
        }

        function expand(cluster) {
            collapse();
            const { group, lng, lat, el } = cluster;
            const offs = fanOffsets(group.length, lat);
            const mPerDegLat = 111320;
            const mPerDegLng = 111320 * Math.cos((lat * Math.PI) / 180);
            const markers = [];
            const features = [];
            group.forEach((p, i) => {
                const [dx, dy] = offs[i];
                // screen y grows downwards, latitude upwards
                const pos = [lng + dx / mPerDegLng, lat - dy / mPerDegLat];
                markers.push(makePin(p, pos, "org-pin--spread"));
                features.push({
                    type: "Feature",
                    properties: {},
                    geometry: { type: "LineString", coordinates: [[lng, lat], pos] },
                });
            });
            el.classList.add("is-open");
            openCluster = { el, markers, group };
            setSpokes(features);
            map.easeTo({
                center: [lng, lat],
                zoom: Math.max(map.getZoom(), FAN_ZOOM - 0.5),
                duration: 600,
            });
        }

        const addSpokesLayer = () => {
            if (map.getSource(SPOKES_SRC)) return;
            map.addSource(SPOKES_SRC, {
                type: "geojson",
                data: { type: "FeatureCollection", features: [] },
            });
            map.addLayer({
                id: "cluster-spokes-line",
                type: "line",
                source: SPOKES_SRC,
                paint: {
                    "line-color": "#221a12",
                    "line-width": 1.2,
                    "line-opacity": 0.55,
                },
            });
        };
        if (map.loaded()) addSpokesLayer();
        else map.on("load", addSpokesLayer);

        // Markers currently on the map (pins and numbered dots), replaced on regroup.
        let liveMarkers = [];

        function render() {
            collapse();
            liveMarkers.forEach((m) => m.remove());
            liveMarkers = [];
            for (const group of groupPins()) {
                if (group.length === 1) {
                    liveMarkers.push(
                        makePin(group[0], [group[0].lng, group[0].lat]),
                    );
                    continue;
                }
                const lng = group.reduce((s, p) => s + p.lng, 0) / group.length;
                const lat = group.reduce((s, p) => s + p.lat, 0) / group.length;
                const el = document.createElement("div");
                el.className =
                    "org-cluster" +
                    (group.some((g) => g.grupo) ? " org-cluster--grupo" : "");
                el.textContent = String(group.length);
                el.title = (strings.cluster || "{n}").replace("{n}", group.length);
                el.setAttribute("role", "button");
                const cluster = { group, lng, lat, el };
                el.addEventListener("click", (e) => {
                    e.stopPropagation();
                    if (openCluster && openCluster.el === el) {
                        collapse();
                        return;
                    }
                    // Different places: zoom in until they separate. Same place, or
                    // already fully zoomed in: fan them out.
                    if (!samePlace(group) && map.getZoom() < map.getMaxZoom() - 0.5) {
                        const b = new maplibregl.LngLatBounds();
                        group.forEach((p) => b.extend([p.lng, p.lat]));
                        map.fitBounds(b, { padding: 120, maxZoom: map.getMaxZoom() });
                    } else expand(cluster);
                });
                liveMarkers.push(
                    new maplibregl.Marker({ element: el, anchor: "center" })
                        .setLngLat([lng, lat])
                        .addTo(map),
                );
            }
        }

        render();
        map.on("click", () => {
            if (openCluster) render();
        });
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && openCluster) render();
        });
        // Regroup after every zoom; an open fan survives zooming until far out.
        map.on("zoomend", () => {
            if (openCluster && map.getZoom() >= 11) return;
            render();
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initMap);
    } else {
        initMap();
    }
</script>
