---
// OrgMap — MapLibre GL map of Altiplano organizations.
// Two pin colors: grupo de trabajo (flow orange) vs resto (tissue lime).
// Overlaid on the altiplano comarcas (core "Altiplano de Granada" vs surrounding
// steppe comarcas) with DOM comarca labels and a Spain-inset locator.
// Clicking a pin scrolls to + flashes the matching card in the gallery.
import fs from "fs";
import type { OrgRecord } from "../lib/records";

export interface Props {
    orgs: OrgRecord[];
}

const { orgs } = Astro.props;

const REGION_JSON = JSON.parse(
    fs.readFileSync("./src/data/altiplano-region.geojson", "utf8"),
);
const INSET_JSON = JSON.parse(
    fs.readFileSync("./src/data/spain-inset.json", "utf8"),
);

const withCoords = orgs.filter((o) => o.lat !== null && o.lng !== null);
const missing = orgs.filter((o) => o.lat === null || o.lng === null);
const grupoCount = withCoords.filter((o) => o.grupoTrabajo).length;
const restoCount = withCoords.length - grupoCount;

// Pins = flat list; overlapping-coordinate spidering (deterministic pixel-ring
// offsets) is computed client-side where pixel math lives.
const pins = withCoords.map((o) => ({
    id: o.id,
    name: o.name,
    place: o.placeName,
    desc: o.description,
    website: o.website,
    grupo: o.grupoTrabajo,
    lat: o.lat,
    lng: o.lng,
}));

// --- Comarca label centroids + region bounds -------------------------------
// Region of interest: name → area-weighted centroid of the largest ring(s).
// "Altiplano de Granada" spans two OSM comarcas (Baza + Huéscar) → one label,
// computed as the area-weighted centroid across both features.

function ringArea(ring: number[][]): number {
    let sum = 0;
    for (let i = 0; i < ring.length - 1; i++) {
        const [x1, y1] = ring[i];
        const [x2, y2] = ring[i + 1];
        sum += x1 * y2 - x2 * y1;
    }
    return Math.abs(sum) / 2;
}

function ringCentroid(ring: number[][]): { lng: number; lat: number } {
    let a = 0;
    let cx = 0;
    let cy = 0;
    for (let i = 0; i < ring.length - 1; i++) {
        const [x1, y1] = ring[i];
        const [x2, y2] = ring[i + 1];
        const cross = x1 * y2 - x2 * y1;
        a += cross;
        cx += (x1 + x2) * cross;
        cy += (y1 + y2) * cross;
    }
    if (a === 0) return { lng: ring[0][0], lat: ring[0][1] };
    return { lng: cx / (3 * a), lat: cy / (3 * a) };
}

type RegionBounds = {
    minLng: number;
    minLat: number;
    maxLng: number;
    maxLat: number;
};

function featureLargestRing(f: any): number[][] | null {
    const rings: number[][][] =
        f.geometry?.type === "Polygon"
            ? f.geometry.coordinates
            : f.geometry?.type === "MultiPolygon"
              ? f.geometry.coordinates.flat()
              : [];
    let best = null;
    let bestArea = -1;
    for (const r of rings) {
        const a = ringArea(r);
        if (a > bestArea) {
            bestArea = a;
            best = r;
        }
    }
    return best;
}

const labelGroups = new Map<
    string,
    { core: boolean; items: { lng: number; lat: number; area: number }[] }
>();
let bounds: RegionBounds = {
    minLng: Infinity,
    minLat: Infinity,
    maxLng: -Infinity,
    maxLat: -Infinity,
};

for (const f of REGION_JSON.features ?? []) {
    const ring = featureLargestRing(f);
    if (!ring) continue;
    for (const [lng, lat] of ring) {
        if (lng < bounds.minLng) bounds.minLng = lng;
        if (lng > bounds.maxLng) bounds.maxLng = lng;
        if (lat < bounds.minLat) bounds.minLat = lat;
        if (lat > bounds.maxLat) bounds.maxLat = lat;
    }
    const name: string = f.properties?.name ?? "Comarca";
    const core = !!f.properties?.core;
    const g = labelGroups.get(name) ?? { core, items: [] };
    const c = ringCentroid(ring);
    g.items.push({ lng: c.lng, lat: c.lat, area: ringArea(ring) });
    labelGroups.set(name, g);
}

const labels = [...labelGroups.entries()].map(([name, g]) => {
    const totalArea = g.items.reduce((s, i) => s + i.area, 0);
    if (totalArea === 0) {
        const first = g.items[0];
        return {
            name,
            core: g.core,
            lat: first?.lat ?? 0,
            lng: first?.lng ?? 0,
        };
    }
    const lat = g.items.reduce((s, i) => s + i.lat * i.area, 0) / totalArea;
    const lng = g.items.reduce((s, i) => s + i.lng * i.area, 0) / totalArea;
    return { name, core: g.core, lat, lng };
});

const mapData = { pins, region: REGION_JSON, labels, bounds };
---

<section class="org-map-block reveal" id="mapa">
    <div class="org-map-block__frame">
        <div id="org-map" data-map-data={JSON.stringify(mapData)}></div>
        <div class="org-map-inset" aria-hidden="true">
            <svg
                class="org-map-inset__svg"
                viewBox={INSET_JSON.viewBox}
                role="img"
            >
                <path class="org-map-inset__outline" d={INSET_JSON.path}></path>
                <circle
                    class="org-map-inset__pulse"
                    cx={INSET_JSON.dot.x}
                    cy={INSET_JSON.dot.y}
                    r="0.9"
                ></circle>
                <circle
                    class="org-map-inset__dot"
                    cx={INSET_JSON.dot.x}
                    cy={INSET_JSON.dot.y}
                    r="0.32"
                ></circle>
            </svg>
            <span class="org-map-inset__caption">
                {INSET_JSON.regionName ?? "Altiplano Estepario"}
            </span>
        </div>
    </div>

    <div class="org-map-legend">
        <span class="org-map-legend__item">
            <span
                class="org-map-legend__dot org-map-legend__dot--grupo"
                aria-hidden="true"
            ></span>
            Grupo de trabajo · {grupoCount}
        </span>
        <span class="org-map-legend__item">
            <span
                class="org-map-legend__swatch org-map-legend__swatch--region"
                aria-hidden="true"
            ></span>
            Altiplano Estepario
        </span>
        {missing.length > 0 && (
            <span class="org-map-legend__missing">
                ⚠ {missing.length} organizaciones sin coordenadas (no se
                muestran en el mapa)
            </span>
        )}
        <span class="org-map-legend__osm">
            © OpenStreetMap contributors · límites OSM (ODbL)
        </span>
    </div>
</section>

<style is:global>
    .org-map-block {
        width: 100%;
    }

    .org-map-block__frame {
        position: relative;
        width: 100%;
        height: min(560px, 68vh);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        background: var(--surface-2);
    }

    #org-map {
        width: 100%;
        height: 100%;
    }

    .org-map-inset {
        position: absolute;
        top: var(--space-4);
        left: var(--space-4);
        z-index: 2;
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        padding: var(--space-3) var(--space-3) var(--space-2);
        background: var(--paper);
        border: 1px solid var(--border);
        box-shadow: 0 2px 0 0 var(--border-subtle);
        pointer-events: none;
    }

    .org-map-inset__svg {
        width: 84px;
        height: auto;
        display: block;
    }

    .org-map-inset__outline {
        fill: var(--surface-1);
        stroke: var(--rule);
        stroke-width: 0.14;
        stroke-linejoin: round;
    }

    .org-map-inset__dot {
        fill: var(--pillar-flow-3);
        stroke: var(--paper);
        stroke-width: 0.16;
        transform-box: fill-box;
        transform-origin: center;
    }

    .org-map-inset__pulse {
        fill: var(--pillar-flow-3);
        opacity: 0.55;
        transform-box: fill-box;
        transform-origin: center;
        animation: org-map-inset-pulse 2.6s ease-out infinite;
    }

    @keyframes org-map-inset-pulse {
        0% {
            transform: scale(0.35);
            opacity: 0.55;
        }
        70% {
            transform: scale(1.5);
            opacity: 0;
        }
        100% {
            transform: scale(1.5);
            opacity: 0;
        }
    }

    .org-map-inset__caption {
        font-family: var(--mono);
        font-size: var(--text-2xs);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
        text-align: center;
    }

    .org-map-legend {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--space-4) var(--space-6);
        padding: var(--space-4) 0 0;
        font-family: var(--mono);
        font-size: var(--text-xs);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted);
    }

    .org-map-legend__item {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .org-map-legend__dot {
        width: 0.7rem;
        height: 0.7rem;
        border-radius: 50%;
        border: 2px solid var(--bg);
        box-shadow: 0 0 0 1px var(--border-subtle);
    }

    .org-map-legend__dot--grupo {
        background: var(--pillar-flow-3);
    }

    .org-map-legend__dot--resto {
        background: var(--pillar-tissue-3);
    }

    .org-map-legend__swatch {
        width: 0.9rem;
        height: 0.65rem;
        border-radius: var(--radius-sm);
    }

    .org-map-legend__swatch--region {
        background: rgba(122, 104, 76, 0.16);
        border: 1.5px solid #6b5a3e;
    }

    .org-map-legend__missing {
        color: var(--danger-mid);
        text-transform: none;
    }

    .org-map-legend__osm {
        margin-left: auto;
        text-transform: none;
        letter-spacing: 0;
        color: var(--border);
    }

    @media (max-width: 767px) {
        .org-map-legend__osm {
            margin-left: 0;
            width: 100%;
        }
    }

    /* Comarca labels — DOM markers (MapLibre symbol layers need a glyphs
       endpoint; DOM keeps the site fonts), mono uppercase, paper halo. */
    .comarca-label {
        font-family: var(--mono);
        font-size: var(--text-2xs);
        letter-spacing: 0.14em;
        text-transform: uppercase;
        white-space: nowrap;
        color: var(--muted);
        text-shadow:
            0 0 3px var(--paper),
            0 0 8px var(--paper),
            0 0 14px var(--paper);
        pointer-events: none;
        user-select: none;
        padding: 0.1rem 0.35rem;
    }

    /* Map pins — round paper-ring dots with glow; hover scale goes on the INNER
       span (MapLibre owns the marker element's transform/translation). */
    .org-pin {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--pin-color);
        border: 2.5px solid var(--paper);
        box-shadow:
            0 0 0 1px color-mix(in srgb, var(--pin-color) 55%, transparent),
            0 3px 10px color-mix(in srgb, var(--pin-color) 55%, transparent);
        cursor: pointer;
        display: grid;
        place-items: center;
    }

    .org-pin__inner {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--paper);
        transition: transform var(--t-fast);
    }

    .org-pin:hover .org-pin__inner {
        transform: scale(1.9);
    }

    .maplibregl-ctrl-bottom-left {
        margin: 1.25rem !important;
    }

    @media (max-width: 767px) {
        .maplibregl-ctrl-bottom-left {
            margin: 0.75rem !important;
        }
    }

    .org-pin-popup .maplibregl-popup-content {
        border-radius: var(--radius) !important;
        border: 1px solid var(--border-subtle);
    }
</style>

<script>
    import maplibregl from "maplibre-gl";
    import "maplibre-gl/dist/maplibre-gl.css";

    function escapeHtml(str) {
        return String(str ?? "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;");
    }

    function initMap() {
        const container = document.getElementById("org-map");
        if (!container) return;

        const data = JSON.parse(container.dataset.mapData || "{}");
        const { pins = [], region = null, labels = [], bounds = null } = data;

        const hasRegion =
            region && region.features && region.features.length > 0;
        const regionCenter = bounds
            ? {
                  lat: (bounds.minLat + bounds.maxLat) / 2,
                  lng: (bounds.minLng + bounds.maxLng) / 2,
              }
            : null;

        const map = new maplibregl.Map({
            container,
            style: {
                version: 8,
                sources: {
                    osm: {
                        type: "raster",
                        tiles: [
                            "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                        ],
                        tileSize: 256,
                        attribution: "&copy; OpenStreetMap contributors",
                    },
                },
                layers: [{ id: "osm", type: "raster", source: "osm" }],
            },
            center: [regionCenter?.lng ?? -2.6, regionCenter?.lat ?? 37.6],
            zoom: 8.3,
            maxZoom: 14,
        });

        map.addControl(new maplibregl.NavigationControl(), "bottom-left");

        // Exposed for debugging/automation (layer inspection, programmatic pan).
        container.__map = map;

        // Region overlay + comarca labels go in once the style is ready.
        map.on("load", () => {
            if (hasRegion) {
                map.addSource("altiplano-region", {
                    type: "geojson",
                    data: region,
                });
                map.addLayer({
                    id: "altiplano-region-fill",
                    type: "fill",
                    source: "altiplano-region",
                    paint: {
                        "fill-color": "rgba(122,104,76,0.16)",
                        "fill-outline-color": "rgba(0,0,0,0)",
                    },
                });
                map.addLayer({
                    id: "altiplano-region-line",
                    type: "line",
                    source: "altiplano-region",
                    paint: {
                        "line-color": "#6b5a3e",
                        "line-width": 1.5,
                    },
                });

                for (const label of labels) {
                    const el = document.createElement("div");
                    el.className = "comarca-label";
                    el.textContent = label.name;
                    new maplibregl.Marker({
                        element: el,
                        anchor: "center",
                    })
                        .setLngLat([label.lng, label.lat])
                        .addTo(map);
                }
            }

            // Framing: pins when there are any, the comarca region otherwise.
            if (pins.length > 0) {
                const pb = new maplibregl.LngLatBounds();
                for (const p of pins) pb.extend([p.lng, p.lat]);
                map.fitBounds(pb, { padding: 48, maxZoom: 10 });
            } else if (bounds) {
                map.fitBounds(
                    [
                        [bounds.minLng, bounds.minLat],
                        [bounds.maxLng, bounds.maxLat],
                    ],
                    { padding: 32, maxZoom: 9.5 },
                );
            }
        });

        // Spider overlapping pins: several orgs share a town centroid, so identical
        // rounded coordinates get a deterministic ring of 16px pixel offsets.
        const offsets = new Map();
        {
            const groups = new Map();
            for (const p of pins) {
                const key = `${p.lat.toFixed(4)},${p.lng.toFixed(4)}`;
                const g = groups.get(key);
                if (g) g.push(p);
                else groups.set(key, [p]);
            }
            for (const group of groups.values()) {
                if (group.length < 2) continue;
                group.sort((a, b) => a.name.localeCompare(b.name));
                group.forEach((m, i) => {
                    const ang = (2 * Math.PI * i) / group.length - Math.PI / 2;
                    offsets.set(m.id, [
                        Math.round(Math.cos(ang) * 16),
                        Math.round(Math.sin(ang) * 16),
                    ]);
                });
            }
        }

        for (const p of pins) {
            const colorVar = p.grupo ? "--pillar-flow-3" : "--pillar-tissue-3";

            const el = document.createElement("div");
            el.className = "org-pin";
            el.style.setProperty("--pin-color", `var(${colorVar})`);
            el.innerHTML = '<span class="org-pin__inner"></span>';

            const marker = new maplibregl.Marker({
                element: el,
                anchor: "center",
                offset: offsets.get(p.id) ?? [0, 0],
            })
                .setLngLat([p.lng, p.lat])
                .addTo(map);

            const popup = new maplibregl.Popup({
                offset: 18,
                closeButton: false,
                closeOnClick: false,
                className: "org-pin-popup",
                maxWidth: "340px",
            }).setHTML(`
        <div style="padding:1rem 1.1rem;font-family:var(--sans);max-width:340px;">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:0.6rem;margin-bottom:0.7rem;">
            <span style="font-family:var(--mono);font-size:0.6rem;text-transform:uppercase;letter-spacing:0.06em;">${
                p.grupo
                    ? '<span style="color:var(--pillar-flow-4);">● Grupo de trabajo</span>'
                    : '<span style="color:var(--pillar-tissue-4);">● Organización</span>'
            }</span>
          </div>
          <div style="font-family:var(--serif);font-size:1.15rem;color:var(--fg);margin-bottom:0.4rem;line-height:1.25;">${escapeHtml(p.name)}</div>
          ${p.place ? `<div style="font-size:0.78rem;color:var(--muted);margin-bottom:0.6rem;font-family:var(--mono);">📍 ${escapeHtml(p.place)}</div>` : ""}
          ${p.desc ? `<div style="font-size:0.85rem;color:var(--fg);line-height:1.55;margin-bottom:0.6rem;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;">${escapeHtml(p.desc)}</div>` : ""}
          ${p.website ? `<a href="${escapeHtml(p.website)}" target="_blank" rel="noopener noreferrer" style="font-family:var(--mono);font-size:0.68rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--primary);">↗ Sitio web</a>` : ""}
        </div>
      `);

            marker.setPopup(popup);
            marker
                .getElement()
                .addEventListener("mouseenter", () => marker.togglePopup());
            marker
                .getElement()
                .addEventListener("mouseleave", () => marker.togglePopup());
            marker.getElement().addEventListener("click", (e) => {
                e.stopPropagation();
                // Scroll to + flash the corresponding card in the gallery
                const card = document.querySelector(
                    '.org-card[data-org-id="' + p.id + '"]',
                );
                if (card) {
                    card.scrollIntoView({
                        behavior: "smooth",
                        block: "center",
                    });
                    card.classList.add("is-flash");
                    setTimeout(() => card.classList.remove("is-flash"), 1600);
                }
            });
        }
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initMap);
    } else {
        initMap();
    }
</script>
