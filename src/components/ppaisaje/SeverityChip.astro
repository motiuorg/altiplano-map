---
// Severity chip: text + icon, never colour alone. Colours come from the section's --pp-* variables.
import { SEVERITY } from "../../lib/ppaisaje/data";
import type { Status } from "../../lib/ppaisaje/schema";

export interface Props {
    status: Status;
    size?: "sm" | "md" | "lg";
}
const { status, size = "md" } = Astro.props;
const meta = SEVERITY[status];
---

<span class={`ppchip ppchip--${status} ppchip--${size}`}>
    <svg viewBox="0 0 16 16" width="1.1em" height="1.1em" aria-hidden="true" focusable="false">
        {meta.icon === "triangle" && <path fill-rule="evenodd" fill="currentColor" d="M8 1.5 15 14H1z M7.2 6h1.6v4H7.2z M7.2 11h1.6v1.4H7.2z" />}
        {meta.icon === "diamond" && <path fill="currentColor" d="M8 1.5 14.5 8 8 14.5 1.5 8z" />}
        {meta.icon === "circle-alert" && <path fill-rule="evenodd" fill="currentColor" d="M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13z M7.2 4.4h1.6v4.4H7.2z M7.2 10h1.6v1.6H7.2z" />}
        {meta.icon === "arrow-up" && <path fill="currentColor" d="M8 1.5 14 8h-3.8v6.5H5.8V8H2z" />}
    </svg>
    {meta.label}
</span>
