---
// Hero visual of Part 2: illustrative potential impact (range, 1–5) by time horizon.
// Numbers match the cards below. Confidence is drawn as line style (dashed = low).
import { data, HORIZON_LABEL, HORIZON_YEARS } from "../../lib/ppaisaje/data";
import type { Horizon } from "../../lib/ppaisaje/schema";

const W = 760, H = 330, ml = 64, mr = 12, mt = 16, mb = 64;
const cols: Horizon[] = ["corto", "medio", "largo"];
const colW = (W - ml - mr) / 3;
const y = (v: number) => mt + (H - mt - mb) * (1 - (v - 1) / 4);
const ticks = [1, 2, 3, 4, 5];
const items = data.opportunities.map((o, i) => ({ o, n: i + 1 }));
---

<figure class="ppomap">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Mapa de oportunidades: rango de impacto potencial ilustrativo por plazo. Los mismos datos están en las tarjetas siguientes.">
        {ticks.map((t) => (
            <>
                <line class="ppo-grid" x1={ml} x2={W - mr} y1={y(t)} y2={y(t)} />
                <text class="ppo-tick" x={ml - 8} y={y(t) + 4} text-anchor="end">{t}</text>
            </>
        ))}
        <text class="ppo-axis" x="14" y={mt + (H - mt - mb) / 2} transform={`rotate(-90 14 ${mt + (H - mt - mb) / 2})`} text-anchor="middle">impacto potencial (índice ilustrativo 1–5)</text>
        {cols.map((c, ci) => {
            const x0 = ml + ci * colW;
            const inCol = items.filter((it) => it.o.horizon === c);
            return (
                <g>
                    <rect class={`ppo-band ppo-band--${ci}`} x={x0} y={mt} width={colW} height={H - mt - mb} />
                    <text class="ppo-col" x={x0 + colW / 2} y={H - 38} text-anchor="middle">{HORIZON_LABEL[c]}</text>
                    <text class="ppo-colsub" x={x0 + colW / 2} y={H - 22} text-anchor="middle">{HORIZON_YEARS[c]}</text>
                    {inCol.map((it, k) => {
                        const x = x0 + (colW * (k + 1)) / (inCol.length + 1);
                        const mid = (it.o.impact.low + it.o.impact.high) / 2;
                        return (
                            <g>
                                <title>{it.n}. {it.o.label} — impacto {it.o.impact.low}–{it.o.impact.high} (ilustrativo), confianza {it.o.confidence}</title>
                                <line class={`ppo-range ppo-range--${it.o.confidence}`} x1={x} x2={x} y1={y(it.o.impact.low)} y2={y(it.o.impact.high)} />
                                <line class="ppo-cap" x1={x - 6} x2={x + 6} y1={y(it.o.impact.low)} y2={y(it.o.impact.low)} />
                                <line class="ppo-cap" x1={x - 6} x2={x + 6} y1={y(it.o.impact.high)} y2={y(it.o.impact.high)} />
                                <circle class="ppo-dot" cx={x} cy={y(mid)} r="12" />
                                <text class="ppo-n" x={x} y={y(mid) + 4.5} text-anchor="middle">{it.n}</text>
                            </g>
                        );
                    })}
                </g>
            );
        })}
    </svg>
    <figcaption class="ppomap__cap">
        <span><svg width="26" height="8" aria-hidden="true"><line x1="0" y1="4" x2="26" y2="4" class="ppo-range ppo-range--alta" /></svg> confianza alta</span>
        <span><svg width="26" height="8" aria-hidden="true"><line x1="0" y1="4" x2="26" y2="4" class="ppo-range ppo-range--media" /></svg> media</span>
        <span><svg width="26" height="8" aria-hidden="true"><line x1="0" y1="4" x2="26" y2="4" class="ppo-range ppo-range--baja" /></svg> baja</span>
        <span class="ppviz__fake">Maqueta — cifras ilustrativas, no previsiones</span>
    </figcaption>
</figure>
