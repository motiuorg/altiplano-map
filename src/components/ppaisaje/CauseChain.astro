---
// Causal chain for one issue: underlying drivers → direct pressures → the issue.
// "Factores que contribuyen": wording is deliberately non-deterministic.
import { driversOf, pressuresOf, sourceNumber } from "../../lib/ppaisaje/data";
import type { Theme } from "../../lib/ppaisaje/schema";
import EvidenceTag from "./EvidenceTag.astro";
import SeverityChip from "./SeverityChip.astro";

export interface Props {
    issue: Theme;
}
const { issue } = Astro.props;
const ds = driversOf(issue.id);
const ps = pressuresOf(issue.id);
---

<div class="ppchain" role="group" aria-label={`Factores que contribuyen a: ${issue.label}`}>
    <div class="ppchain__col">
        <h4 class="ppchain__h">Causas de fondo</h4>
        <ul>
            {ds.map((c) => (
                <li class="ppchain__node">
                    <span class="ppchain__label">{c.label}</span>
                    <EvidenceTag evidence={c.evidence} confidence={c.confidence} compact />
                    {c.sourceId && <a class="ppchain__src" href={`#ev-${c.sourceId}`}>[{sourceNumber(c.sourceId)}]</a>}
                </li>
            ))}
        </ul>
    </div>
    <div class="ppchain__arrow" aria-hidden="true">→</div>
    <div class="ppchain__col">
        <h4 class="ppchain__h">Presiones directas</h4>
        <ul>
            {ps.map((c) => (
                <li class="ppchain__node">
                    <span class="ppchain__label">{c.label}</span>
                    <EvidenceTag evidence={c.evidence} confidence={c.confidence} compact />
                    {c.sourceId && <a class="ppchain__src" href={`#ev-${c.sourceId}`}>[{sourceNumber(c.sourceId)}]</a>}
                </li>
            ))}
        </ul>
    </div>
    <div class="ppchain__arrow" aria-hidden="true">→</div>
    <div class="ppchain__col ppchain__col--state">
        <h4 class="ppchain__h">Resultado observado</h4>
        <div class="ppchain__state">
            <strong>{issue.label}</strong>
            <SeverityChip status={issue.status} size="sm" />
        </div>
    </div>
</div>
