---
export interface Props { id: string; size?: number }
const { id, size = 40 } = Astro.props;
---
<svg class="ppicon" viewBox="0 0 32 32" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {id === "agua" && <path d="M16 3.5C16 3.5 7 13.5 7 20a9 9 0 0 0 18 0C25 13.5 16 3.5 16 3.5z M12 21a4.5 4.5 0 0 0 4 4" />}
    {id === "suelo" && <path d="M3 10q6.5-4 13 0t13 0 M3 17q6.5-4 13 0t13 0 M3 24q6.5-4 13 0t13 0" />}
    {id === "biodiversidad" && <path d="M5 27C5 13 14 6 27 5 27 18 20 27 5 27z M5 27 17 14" />}
    {id === "uso_suelo" && <path d="M4 5h13v11H4z M20 5h8v7h-8z M20 15h8v12h-8z M4 19h13v8H4z" />}
    {id === "relevo" && (<><circle cx="11" cy="9" r="3.6" /><path d="M4 27v-5a7 7 0 0 1 14 0v5" /><circle cx="24" cy="15" r="2.8" /><path d="M20 27v-2.5a4.5 4.5 0 0 1 8 -2.6" /></>)}
</svg>
